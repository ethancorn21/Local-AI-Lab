#!/usr/bin/env python3
"""labdash-ship: ships the agents' live work to the lab console on the AI box and brings the operator's messages back.

Runs on the harness VM as the agent user (systemd unit labdash-ship). Holds one SSH connection to the AI box, where a
forced command (labdash-ingest) hands the lines to the console's server. Upstream: one JSON object per line, the
agents' sessions already turned into the console's events (thinking, answers, tool calls with their diffs and output,
driver lines from loop.log), plus snapshots of each agent's task (task file, PROGRESS.md, open requests, history) and
each project's sprint. Downstream, on the same connection: the operator's messages (written to the agent's
.agent/inbox/, exactly as agent-watch does) and answers to requests (appended to .agent/asks/<n>.md, as agent-talk
does), each acknowledged.

Which projects: `--only frontpage,hollowdeep` ships those (and their team worktrees, frontpage.a ...). Without it,
every project in ~/projects except the ones named in ~/.agent-kit/dashboard-hidden, one per line; that file must exist
(empty is fine), or nothing is shipped. A hidden project is dropped by name before anything inside it is opened.

  labdash-ship [--only a,b] [--target labdash-feed]   ship over SSH (Host alias in ~/.ssh/config)
  labdash-ship --stdio [--only a,b]                    protocol on stdout, commands on stdin (tests)
"""
import json
import os
import zlib
import re
import select
import subprocess
import sys
import threading
import time
import traceback
import queue
from datetime import datetime

HOME = os.path.expanduser("~")
PROJECTS = os.environ.get("LABDASH_PROJECTS", os.path.join(HOME, "projects"))
HIDDEN = os.environ.get("LABDASH_HIDDEN", os.path.join(HOME, ".agent-kit", "dashboard-hidden"))
SPRINT_TOOL = os.environ.get("LABDASH_SPRINT", os.path.join(HOME, "bin", "sprint-progress"))
CACHE = os.environ.get("LABDASH_CACHE", os.path.join(HOME, ".cache", "labdash"))   # finished sessions' timeline entries
RECENT = 6 * 3600          # a project whose loop stopped stays on the console this long after its last session
FLUSH = 0.3                # streamed text goes up at most this often per event
SNAP_EVERY = 10            # seconds between task / sprint snapshots (sent only when they changed)
SCAN_EVERY = 20            # seconds between looks for new or stopped loops
CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069]")
NAME = re.compile(r"^[A-Za-z0-9._-]{1,64}$")


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, file=sys.stderr, flush=True)


def clean(s, cap):
    s = CTRL.sub("", str(s or "").replace("\t", "    "))
    return s if len(s) <= cap else s[:cap] + " …"


def as_int(v, default):
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


FAULTS = {}


def fault(where, exc):
    """A bug here or a line it cannot read costs that line, never the other agents' streams: logged once per kind
    (where, exception, line of this file), counted after that. True the first time a kind is seen."""
    tb = traceback.extract_tb(exc.__traceback__)
    frame = tb[-1] if tb else None
    key = (where, type(exc).__name__, frame.lineno if frame else 0)
    FAULTS[key] = FAULTS.get(key, 0) + 1
    if FAULTS[key] > 1:
        return False
    at = f" (line {frame.lineno}, {frame.name})" if frame else ""
    log(f"fault in {where}: {type(exc).__name__}: {exc}{at}; skipped, later ones of this kind not logged")
    return True


def read(path, cap=None):
    try:
        with open(path, errors="replace") as fh:
            return fh.read(cap) if cap else fh.read()
    except OSError:
        return None


def pid_alive(path):
    try:
        os.kill(int(open(path).read().split()[0]), 0)
        return True
    except (OSError, ValueError, IndexError):
        return False


def task_parts(rel):
    """'tasks/255-feed-batch-continuation.md' -> ('255', 'feed batch continuation')"""
    m = re.match(r"(?:.*/)?(\d+[a-z]*)-(.+)\.md$", rel or "")
    return (m.group(1), m.group(2).replace("-", " ")) if m else ("", rel or "")


# ------------------------------------------------------------------------------------------------ which projects

def visible(only):
    """Project directory names to ship. Hidden ones are dropped by name, before anything inside them is opened."""
    try:
        names = sorted(n for n in os.listdir(PROJECTS) if NAME.match(n))
    except OSError:
        return []
    if only:
        return [n for n in names if any(n == o or n.startswith(o + ".") for o in only)]
    if not os.path.exists(HIDDEN):
        log(f"no {HIDDEN}: shipping nothing until it exists (one hidden project name per line; empty is fine)")
        return []
    hidden = {l.strip() for l in open(HIDDEN) if l.strip() and not l.startswith("#")}
    return [n for n in names if not any(n == h or n.startswith(h + ".") for h in hidden)]


def team_env(path):
    env = {}
    for l in (read(os.path.join(path, ".agent", "team.env")) or "").splitlines():
        m = re.match(r"\s*(?:export\s+)?([A-Z_]+)=['\"]?([^'\"]*)['\"]?\s*$", l)
        if m:
            env[m.group(1)] = m.group(2)
    return env


# ------------------------------------------------------------------------------------------------ Pi events -> console events

def result_text(e, key="result"):
    content = (e.get(key) or {}).get("content") or []
    return "".join(c.get("text", "") for c in content if isinstance(c, dict))


def first_line(s):
    s = str(s or "").strip()
    return s.splitlines()[0] if s else ""


def tool_head(name, a):
    a = a or {}
    if name == "bash":
        cmd = str(a.get("command", ""))
        return "Bash", first_line(cmd) + (" …" if "\n" in cmd.strip() else ""), ""
    if name in ("edit", "write"):
        return name.capitalize(), str(a.get("path", "")), ""
    if name == "read":
        rng = ""
        if a.get("offset") or a.get("limit"):
            start, limit = as_int(a.get("offset") or 1, 1), as_int(a.get("limit"), 0)
            rng = f"lines {start}–{start + limit - 1}" if limit else f"from line {start}"
        return "Read", str(a.get("path", "")), rng
    if name == "web_search":
        return "Search", str(a.get("query", "")), ""
    if name == "web_fetch":
        return "Fetch", str(a.get("url", "")), ""
    if name == "ask_human":
        return "Ask", "a request to you" + (" (blocking)" if a.get("blocking") is not False else ""), ""
    return str(name), json.dumps(a)[:160], ""


def out_lines(text, head=20, tail=40):
    lines = text.rstrip("\n").split("\n") if text.strip() else ["(no output)"]
    if len(lines) > head + tail:
        lines = lines[:head] + [f"… {len(lines) - head - tail} lines …"] + lines[-tail:]
    return [clean(l, 400) for l in lines]


def tool_result(name, a, e):
    """(meta, body, error) for a finished tool call."""
    a, text = a or {}, result_text(e)
    if e.get("isError"):
        return "error", {"out": [["f", l] for l in out_lines(text, 8, 8)]}, True
    if name == "edit":
        diff = ((e.get("result") or {}).get("details") or {}).get("diff") or ""
        lines, adds, dels = [], 0, 0
        for l in diff.split("\n")[:160]:
            m = re.match(r"^([ +-])(\s*\d*)\s(.*)$", l)
            if m:
                lines.append([m.group(1), m.group(2).strip(), clean(m.group(3), 400)])
                adds += m.group(1) == "+"
                dels += m.group(1) == "-"
            elif l.strip():
                lines.append([" ", "", clean(l, 400)])
        return {"add": adds, "del": dels}, {"diff": lines, "path": str(a.get("path", ""))}, False
    if name == "write":
        lines = str(a.get("content", "")).rstrip("\n").split("\n")
        body = [clean(l, 400) for l in lines[:80]] + ([f"… {len(lines) - 80} more lines"] if len(lines) > 80 else [])
        return {"add": len(lines), "del": 0}, {"code": body, "start": 1, "path": str(a.get("path", ""))}, False
    if name == "read":
        lines = text.rstrip("\n").split("\n") if text.strip() else []
        start = as_int(a.get("offset") or 1, 1)
        body = [clean(l, 400) for l in lines[:60]] + ([f"… {len(lines) - 60} more lines"] if len(lines) > 60 else [])
        return f"{len(lines)} lines", {"code": body, "start": start, "path": str(a.get("path", ""))}, False
    if name == "web_search":
        n = len(re.findall(r"^\d+\. ", text, re.M))
        return f"{n} results", {"out": [["", l] for l in out_lines(text, 12, 0)]}, False
    if name == "bash":
        tailtext = "\n".join(text.rstrip().split("\n")[-6:])
        p = re.findall(r"(\d+) passed", tailtext)
        f = re.findall(r"(\d+) failed", tailtext)   # pytest's "2 failed, 4 warnings" has no "passed" at all
        meta = {"pass": int(p[-1]) if p else 0, "fail": int(f[-1]) if f else 0} if p or f else ""
        cls = lambda l: "f" if re.search(r"\b(FAILED|Error|error:|Traceback)\b", l) else ("p" if re.search(r"\b\d+ passed\b", l) and not re.search(r"failed", l) else "")
        return meta, {"out": [[cls(l), l] for l in out_lines(text)]}, False
    return "", {"out": [["", l] for l in out_lines(text, 12, 12)]}, False


def change(name, args, meta, body):
    """A tool call the timeline shows: a file change (edit, write) with its diff, or a test run (bash output with a
    passed/failed count). (series, node, body) or None."""
    if name in ("edit", "write") and isinstance(meta, dict):
        return "e", {"kind": name.capitalize(), "path": clean((args or {}).get("path", ""), 300), "add": meta.get("add", 0), "del": meta.get("del", 0)}, body
    if name == "bash" and isinstance(meta, dict):
        return "t", {"kind": "Test", "pass": meta.get("pass", 0), "fail": meta.get("fail", 0), "cmd": clean(first_line((args or {}).get("command", "")), 160)}, None
    return None


class Session:
    """Turns one Pi session file's events into console events. emit(kind, payload) sends them."""

    def __init__(self, n, emit, activity):
        self.n, self.emit, self.activity = n, emit, activity
        self.count, self.cur, self.buf, self.last_flush = 0, None, "", 0.0
        self.tools, self.user_msgs, self.composing = {}, 0, None
        self.live, self.counts = False, {}

    def new_id(self):
        self.count += 1
        return f"{self.n}-{self.count}"

    def flush(self, force=False):
        """Streamed text goes up in pieces. A block is announced only once it has words: Pi opens empty text blocks
        between tool calls."""
        if not self.cur or not self.buf or not (force or time.time() - self.last_flush >= FLUSH):
            return
        if not self.cur[2]:
            if not self.buf.strip():
                return
            self.emit("ev", {"id": self.cur[0], "t": self.cur[1], "text": self.buf.lstrip("\n"), "done": False})
            self.cur[2] = True
        else:
            self.emit("upd", {"id": self.cur[0], "append": {"text": self.buf}})
        self.buf, self.last_flush = "", time.time()

    def close_stream(self):
        if self.cur:
            self.flush(force=True)
            if self.cur[2]:
                self.emit("upd", {"id": self.cur[0], "set": {"done": True}})
            self.cur = None

    def open_stream(self, kind):
        self.close_stream()
        self.cur, self.buf = [self.new_id(), kind, False], ""

    def event(self, e):
        t = e.get("type")
        if t == "message_update":
            d = e.get("assistantMessageEvent") or {}
            dt = d.get("type")
            if dt == "thinking_start":
                self.open_stream("think")
                self.activity("thinking")
            elif dt in ("thinking_delta", "text_delta"):
                kind = "think" if dt == "thinking_delta" else "say"
                if not self.cur or self.cur[1] != kind:
                    self.open_stream(kind)
                self.buf += CTRL.sub("", d.get("delta", ""))
                self.flush()
            elif dt == "text_start":
                self.open_stream("say")
                self.activity("answering")
            elif dt in ("thinking_end", "text_end"):
                self.close_stream()
            elif dt == "toolcall_start":
                self.close_stream()
                self.composing = [d.get("toolName") or "tool", 0, 0.0]
                self.activity(f"writing a {self.composing[0]} call")
            elif dt == "toolcall_delta" and self.composing:
                self.composing[1] += len(d.get("delta", ""))
                if time.time() - self.composing[2] > 2:
                    self.composing[2] = time.time()
                    self.activity(f"writing a {self.composing[0]} call · {self.composing[1] // 1000}k chars")
        elif t == "message_end":
            msg = e.get("message") or {}
            if msg.get("role") == "user":
                self.close_stream()
                text = "".join(c.get("text", "") for c in (msg.get("content") or []) if isinstance(c, dict)).strip()
                self.user_msgs += 1
                if self.user_msgs == 1:   # the loop's prompt for this session
                    _, sep, extra = text.partition("The human sent you")
                    if sep:
                        self.emit("ev", {"id": self.new_id(), "t": "you", "text": clean(sep + extra, 4000), "note": "in this session's prompt"})
                elif text.startswith("[Message from the human"):   # human-messages.ts, from the inbox mid-session
                    self.emit("ev", {"id": self.new_id(), "t": "you", "text": clean(text.partition("\n")[2].strip(), 4000), "note": "delivered"})
                else:   # the harness's own nudges: [harness] lines, wrap-up and prep notices
                    self.emit("ev", {"id": self.new_id(), "t": "sys", "text": clean(first_line(text), 400)})
            elif msg.get("role") == "assistant" and isinstance(msg.get("usage"), dict):
                total = msg["usage"].get("totalTokens")
                if isinstance(total, int) and total > 0:   # an aborted request reports 0
                    self.emit("meta", {"ctx": total})
        elif t == "tool_execution_start":
            self.close_stream()
            self.composing = None
            kind, target, meta = tool_head(e.get("toolName"), e.get("args"))
            eid = self.new_id()
            self.tools[e.get("toolCallId")] = (eid, e.get("toolName"), e.get("args") or {})
            ev = {"id": eid, "t": "tool", "kind": kind, "target": clean(target, 300), "meta": meta, "running": True}
            if e.get("toolName") == "ask_human":
                ev["body"] = {"out": [["", clean(l, 400)] for l in str((e.get("args") or {}).get("request", "")).splitlines()[:40]]}
            self.emit("ev", ev)
            self.activity(f"running {kind}")
        elif t == "tool_execution_update":
            tool = self.tools.get(e.get("toolCallId"))
            lines = [l.strip() for l in result_text(e, "partialResult").splitlines() if l.strip()]
            if tool and lines:
                self.activity(f"running {tool_head(tool[1], tool[2])[0]} · {clean(lines[-1], 120)}")
        elif t == "tool_execution_end":
            eid, name, args = self.tools.pop(e.get("toolCallId"), (None, e.get("toolName"), {}))
            meta, body, err = tool_result(name, args, e)
            if eid is None:   # its start was before this file's replay window
                kind, target, _ = tool_head(name, args)
                eid = self.new_id()
                self.emit("ev", {"id": eid, "t": "tool", "kind": kind, "target": clean(target, 300), "meta": "", "running": True})
            upd = {"running": False, "meta": meta, "body": body}
            if err:
                upd["error"] = True
            self.emit("upd", {"id": eid, "set": upd})
            c = None if err else change(name, args, meta, body)
            if c:   # numbered as session_changes numbers them, so the history and the live stream name the same entries
                self.counts[c[0]] = self.counts.get(c[0], 0) + 1
                if self.live:
                    self.emit("flow_node", {"node": {**c[1], "id": f"{self.n}:{c[0]}{self.counts[c[0]]}", "iter": self.n,
                                                     "t": round(time.time(), 1), "approx": False}, "body": c[2]})
            if not self.tools:
                self.activity("thinking")
        elif t in ("compaction_start", "auto_retry_start"):
            self.close_stream()
            self.emit("ev", {"id": self.new_id(), "t": "sys", "text": clean(f"{t.replace('_', ' ')}: {e.get('reason') or e.get('errorMessage') or ''}", 400)})
        elif t == "agent_end":
            self.close_stream()
            self.activity("session finished")


# ------------------------------------------------------------------------------------------------ one loop = one channel

def parse_task(text):
    """A task file -> its parts for the console's task panel."""
    if text is None:
        return None
    lines = text.splitlines()
    t = {"status": "", "title": "", "depends": [], "touches": [], "goal": "", "checks": []}
    m = re.match(r"\s*Status:\s*(\S+)", lines[0] if lines else "", re.I)
    t["status"] = m.group(1).lower() if m else ""
    section, item = None, None
    goal = []
    for l in lines:
        if l.startswith("# ") and not t["title"]:
            t["title"] = re.sub(r"^\d+[a-z]*[:.)]?\s*", "", l[2:].strip())
            continue
        dm = re.match(r"Depends on:\s*(.*)", l, re.I)
        if dm and section is None:
            t["depends"] = re.findall(r"\b\d+[a-z]*\b", dm.group(1))
            continue
        tm = re.match(r"Touches:\s*(.*)", l, re.I)
        if tm and section is None:
            t["touches"] = [x.strip() for x in tm.group(1).split(",") if x.strip()][:20]
            continue
        if l.startswith("## "):
            section = l[3:].strip().lower()
            item = None
            continue
        if section == "goal":
            goal.append(l)
        elif section and section.startswith("acceptance"):
            cm = re.match(r"\s*[-*]\s*\[([ xX])\]\s*(.*)", l)
            if cm and len(t["checks"]) < 30:
                item = [cm.group(1).lower() == "x", cm.group(2).strip()]
                t["checks"].append(item)
            elif item and l.strip() and l.startswith((" ", "\t")) and len(item[1]) < 400:
                item[1] += " " + l.strip()
            else:
                item = None
    paras, cur = [], []
    for l in goal:
        if l.strip():
            cur.append(l.strip())
        elif cur:
            paras.append(" ".join(cur))
            cur = []
    if cur:
        paras.append(" ".join(cur))
    t["goal"] = clean("\n\n".join(paras), 2400)
    t["checks"] = [[d, clean(x, 400)] for d, x in t["checks"]]
    return t


def task_status(path):
    m = re.match(r"\s*Status:\s*(\S+)", read(path, 200) or "", re.I)
    return m.group(1).lower() if m else ""


def task_file(tasks_dir, tid):
    try:
        for f in os.listdir(tasks_dir):
            if f.startswith(tid + "-") and f.endswith(".md"):
                return os.path.join(tasks_dir, f)
    except OSError:
        pass
    return None


class Channel:
    def __init__(self, name, path, send):
        self.name, self.path, self.send = name, path, send
        env = team_env(path)
        self.team_dir = env.get("TEAM_DIR") or None
        self.agent = env.get("AGENT_ID") or ""
        url = env.get("LLM_URL") or ""
        m = re.search(r":(\d+)", url)
        self.port = m.group(1) if m else ""
        self.project = os.path.basename(self.team_dir) if self.team_dir else name
        self.sess_path, self.sess_off, self.sess_part, self.sess = None, 0, b"", None
        self.log_off, self.log_part = 0, b""
        self.meta = {}
        self.snap_hash = None
        self.hist_cache = (None, [])
        self.rows_mtime = None

    def agent_dir(self, *p):
        return os.path.join(self.path, ".agent", *p)

    def set_meta(self, **kw):
        changed = {k: v for k, v in kw.items() if self.meta.get(k) != v}
        if changed:
            self.meta.update(changed)
            self.send({"op": "meta", "ch": self.name, "meta": changed})

    def emit(self, kind, payload):
        if kind == "meta":
            self.set_meta(**payload)
        else:
            self.send({"op": kind, "ch": self.name, **({"ev": payload} if kind == "ev" else payload)})

    def guarded(self, what, fn, *a):
        """fn(*a); a failure is logged, noted once in this agent's feed, and skipped (see fault)."""
        try:
            fn(*a)
        except Exception as exc:
            if fault(f"{self.name} ({what})", exc) and self.sess:
                self.emit("ev", {"id": self.sess.new_id(), "t": "sys", "text": clean(
                    f"console: skipped {what} it could not read ({type(exc).__name__}: {exc}). "
                    "Details: journalctl -u labdash-ship on the VM.", 400)})

    def newest_session(self):
        try:
            files = sorted(f for f in os.listdir(self.agent_dir("sessions")) if re.match(r"iter-\d+\.jsonl$", f))
        except OSError:
            return None
        return self.agent_dir("sessions", files[-1]) if files else None

    def iteration_line(self, n):
        """(start epoch, task file) for session n, from loop.log, and the byte offset just after that line."""
        start, task, off = None, "", 0
        try:
            with open(self.agent_dir("loop.log"), "rb") as fh:
                pos = 0
                for raw in fh:
                    pos += len(raw)
                    l = raw.decode(errors="replace")
                    if f" iteration {n}: " in l:
                        task = l.split(f"iteration {n}: ", 1)[-1].split(" (harness")[0].strip()
                        try:
                            start = time.mktime(time.strptime(l[:19], "%Y-%m-%d %H:%M:%S"))
                        except ValueError:
                            pass
                        off = pos
        except OSError:
            pass
        return start, task, off

    def reset(self):
        """Send this channel from scratch: meta, then the current session replayed and the driver lines since it began."""
        self.sess_path, self.sess = None, None
        self.meta = {}
        self.snap_hash = None
        self.send({"op": "reset", "ch": self.name, "meta": {"agent": self.agent, "project": self.project, "port": self.port, "team": bool(self.team_dir)}})
        self.poll(replay=True)

    def start_session(self, path):
        n = int(re.search(r"iter-(\d+)", path).group(1))
        start, task, off = self.iteration_line(n)
        start = start or os.path.getmtime(path)
        prep = task.startswith("prep for ")
        task = task[len("prep for "):] if prep else task
        tid, tname = task_parts(task)
        self.sess_path, self.sess_off, self.sess_part = path, 0, b""
        self.log_off, self.log_part = off, b""
        self.sess = Session(n, self.emit, lambda a: self.set_meta(activity=a))
        self.emit("ev", {"id": f"{n}-0", "t": "divider", "time": time.strftime("%H:%M", time.localtime(start)), "task": tname, "prep": prep})
        self.set_meta(session=n, task_file=task, task_id=tid, task=tname, start=int(start), activity="reading prompt", ctx=None, prep=prep)
        self.send({"op": "flow_sess", "ch": self.name, "sess": {"iter": n, "task_id": tid, "task": tname, "start": int(start), "end": None, "prep": prep}})

    def read_new(self, path, off, part):
        try:
            with open(path, "rb") as fh:
                fh.seek(off)
                data = fh.read(4 << 20)
        except OSError:
            return off, part, []
        off += len(data)
        data = part + data
        lines = data.split(b"\n")
        return off, lines[-1], lines[:-1]

    def poll(self, replay=False):
        newest = self.newest_session()
        if newest and newest != self.sess_path:
            if self.sess:
                self.sess.close_stream()
            self.start_session(newest)
        if self.sess:
            self.sess_off, self.sess_part, lines = self.read_new(self.sess_path, self.sess_off, self.sess_part)
            self.sess.live = not replay   # replayed changes reach the timeline from the history, placed by file position
            for raw in lines:
                try:
                    e = json.loads(raw)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    continue
                if isinstance(e, dict):
                    self.guarded("a session event", self.sess.event, e)
            self.sess.flush(force=replay)
            self.log_off, self.log_part, lines = self.read_new(self.agent_dir("loop.log"), self.log_off, self.log_part)
            for raw in lines:
                l = raw.decode(errors="replace").rstrip()
                if not l or re.search(r" iteration \d+: ", l):
                    continue
                text = re.sub(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\s+", "", l)
                good = bool(re.search(r"\b(verified|merged)\b", text, re.I)) and not re.search(r"\b(not|rejected|conflict)\b", text, re.I)
                self.emit("ev", {"id": f"{self.sess.n}-L{self.log_off}-{len(text)}", "t": "sys", "text": clean(text, 400), "good": good})
                self.set_meta(driver=clean(text, 200))
                m = log_mark(l)
                if m:
                    self.send({"op": "flow_mark", "ch": self.name, "mark": m})
        alive_loop, alive_pi = pid_alive(self.agent_dir("loop.pid")), pid_alive(self.agent_dir("pi.pid"))
        self.set_meta(loop=alive_loop, running=alive_pi)
        if self.sess and not alive_pi and self.meta.get("activity") not in ("session finished", "between sessions"):
            self.set_meta(activity="between sessions")

    # ---- the task panel
    def history(self, task_file):
        path = self.agent_dir("iterations.jsonl")
        try:
            mt = os.path.getmtime(path)
        except OSError:
            return []
        if self.hist_cache[0] != (mt, task_file):
            rows = []
            for l in (read(path) or "").splitlines():
                if f'"{task_file}"' not in l:
                    continue
                try:
                    r = json.loads(l)
                except json.JSONDecodeError:
                    continue
                if r.get("task") == task_file:
                    rows.append({k: r.get(k) for k in ("iter", "start", "end", "status_after", "verify", "agent_commits", "wrapup", "timed_out")})
            self.hist_cache = ((mt, task_file), rows[-12:])
        return self.hist_cache[1]

    def asks(self):
        out = []
        d = self.agent_dir("asks")
        try:
            files = sorted(f for f in os.listdir(d) if re.match(r"\d+\.md$", f))
        except OSError:
            return out
        for f in files[-20:]:
            text = read(os.path.join(d, f), 20000) or ""
            field = lambda k: (re.search(rf"^{k}:\s*(.*)$", text, re.M) or [None, ""])[1].strip()
            if field("status") != "open":
                continue
            body = text.split("## Request", 1)[-1].split("\n## ", 1)[0].strip() if "## Request" in text else text
            out.append({"id": f[:-3], "task": field("task"), "asked": field("asked"), "blocking": field("blocking"), "text": clean(body, 6000)})
        return out

    def snapshot(self):
        tf = self.meta.get("task_file") or ""
        tid = self.meta.get("task_id") or ""
        main = self.team_dir or self.path
        task = parse_task(read(os.path.join(self.path, tf), 60000)) if tf else None
        if task:
            for key in ("depends",):
                task[key] = [[d, (lambda p: task_status(p) if p else "missing")(task_file(os.path.join(main, "tasks"), d.zfill(3) if d.isdigit() else d))] for d in task[key]]
            unlocks = []
            try:
                for f in sorted(os.listdir(os.path.join(main, "tasks"))):
                    if not f.endswith(".md") or f.startswith(tid + "-"):
                        continue
                    head = read(os.path.join(main, "tasks", f), 1500) or ""
                    dm = re.search(r"^Depends on:\s*(.*)$", head, re.M | re.I)
                    if dm and any(d.lstrip("0") == tid.lstrip("0") for d in re.findall(r"\b\d+[a-z]*\b", dm.group(1))):
                        if task_status(os.path.join(main, "tasks", f)) not in ("done", "dropped"):
                            unlocks.append(list(task_parts(f)))
            except OSError:
                pass
            task["unlocks"] = unlocks[:12]
        snap = {"task": task, "progress": clean(read(os.path.join(self.path, "PROGRESS.md"), 12000) or "", 8000),
                "history": self.history(tf) if tf else [], "asks": self.asks(),
                "prep": clean(read(os.path.join(main, "tasks", "prep", f"{tid}.md"), 6000) or "", 4000) if tid else ""}
        h = hash(json.dumps(snap, sort_keys=True))
        if h != self.snap_hash:
            self.snap_hash = h
            self.send({"op": "task", "ch": self.name, "snap": snap})

    def flow_rows(self):
        """Sessions that ended since the last look: their end and outcome, for the timeline."""
        p = self.agent_dir("iterations.jsonl")
        try:
            mt = os.path.getmtime(p)
        except OSError:
            return
        if mt == self.rows_mtime:
            return
        self.rows_mtime = mt
        for l in (read(p) or "").splitlines()[-5:]:
            try:
                r = json.loads(l)
            except ValueError:
                continue
            if isinstance(r, dict) and isinstance(r.get("iter"), int) and r.get("end"):
                self.send({"op": "flow_sess", "ch": self.name, "sess": session_row(r)})

    # ---- commands from the console
    def message(self, text, stop):
        inbox = self.agent_dir("inbox")
        os.makedirs(inbox, exist_ok=True)
        ms = int(time.time() * 1000)
        final = os.path.join(inbox, f"{ms}{'.now' if stop else ''}.md")
        tmp = os.path.join(inbox, f".labdash-{ms}.tmp")
        with open(tmp, "w") as fh:
            fh.write(text.rstrip() + "\n")
        os.replace(tmp, final)

    def answer(self, ask, text):
        path = self.agent_dir("asks", f"{ask}.md")
        body = read(path)
        if body is None:
            raise ValueError(f"request {ask} not found")
        if not re.search(r"^status: open$", body, re.M):
            raise ValueError(f"request {ask} is not open any more")
        body = re.sub(r"^status: open$", "status: answered", body, count=1, flags=re.M)
        body = body.rstrip("\n") + f"\n\n## Answer ({time.strftime('%Y-%m-%d %H:%M')}, console)\n{text.rstrip()}\n"
        tmp = path + ".labdash.tmp"
        with open(tmp, "w") as fh:
            fh.write(body)
        os.replace(tmp, path)


# ------------------------------------------------------------------------------------------------ sprint boards

def board(main):
    try:
        p = json.loads(subprocess.run([SPRINT_TOOL, main, "--json"], capture_output=True, text=True, timeout=30).stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return None
    tasks_dir = os.path.join(main, "tasks")
    files = {}
    try:
        for f in os.listdir(tasks_dir):
            if f.endswith(".md"):
                files[f.split("-")[0]] = f
    except OSError:
        pass

    def info(tid):
        f = files.get(tid)
        text = read(os.path.join(tasks_dir, f), 4000) if f else ""
        title = next((re.sub(r"^\d+[a-z]*[:.)]?\s*", "", l[2:].strip()) for l in (text or "").splitlines() if l.startswith("# ")), task_parts(f or "")[1])
        dm = re.search(r"^Depends on:\s*(.*)$", text or "", re.M | re.I)
        deps = re.findall(r"\b\d+[a-z]*\b", dm.group(1)) if dm else []
        return f, clean(title, 200), deps

    done, building, opened = [], [], []
    for tid in p.get("tasks", []):
        f, title, deps = info(tid)
        status = task_status(os.path.join(tasks_dir, f)) if f else ""
        if status == "done":
            done.append({"id": tid, "title": title})
        elif tid in p.get("in_progress", []):
            agent = (p.get("by_agent") or {}).get(tid)
            boxes = None
            if agent:   # its live copy, in the agent's worktree
                wt = f"{main}.{agent}"
                t = parse_task(read(os.path.join(wt, "tasks", f), 60000)) if f and os.path.isdir(wt) else None
                if t and t["checks"]:
                    boxes = [sum(1 for c in t["checks"] if c[0]), len(t["checks"])]
            building.append({"id": tid, "title": title, "agent": agent, "status": status, "boxes": boxes})
        else:
            waits = []
            for d in deps:
                df = files.get(d.zfill(3) if d.isdigit() else d)
                if not df or task_status(os.path.join(tasks_dir, df)) not in ("done", "dropped"):
                    waits.append(d)
            opened.append({"id": tid, "title": title, "waits": waits})
    done.reverse()
    return {"total": p.get("total"), "done": done, "building": building, "open": opened}


# ------------------------------------------------------------------------------------------------ the timeline

MARKS = [(re.compile(r"team: (tasks/\S+) merged into main"), "merged"), (re.compile(r"team: (tasks/\S+) handed over to agent"), "handed"),
         (re.compile(r"team: (tasks/\S+) split\b"), "split"), (re.compile(r"NEW TASK by agent: (tasks/\S+)"), "new task"),
         (re.compile(r"team: nothing to take now"), "wait"), (re.compile(r"STALLED: (tasks/\S+)"), "stalled"),
         (re.compile(r"iteration \d+ hit the \d+s timeout"), "timeout"), (re.compile(r"PAUSE file found"), "paused")]


def stamp_epoch(s):
    try:
        return time.mktime(time.strptime(s[:19], "%Y-%m-%d %H:%M:%S"))
    except ValueError:
        return None


def iso_epoch(s):
    try:
        return datetime.fromisoformat(str(s)).timestamp()
    except ValueError:
        return None


def log_mark(line):
    """A loop.log line the timeline marks (merged, handed over, split, new task, waiting, stalled, timeout, paused)."""
    t = stamp_epoch(line)
    if t is None:
        return None
    text = line[20:]
    for rx, kind in MARKS:
        m = rx.search(text)
        if m:
            return {"id": f"{int(t)}:{zlib.crc32(line.encode()) & 0xffffffff:x}", "t": int(t), "kind": kind,
                    "task_id": task_parts(m.group(1))[0] if m.groups() else "", "text": clean(text, 300)}
    return None


def session_changes(path, start, end, cache_dir):
    """[[node, body]] for one session file: its file changes and test runs, numbered as Session numbers them, each placed
    in time by where it sits in the file (Pi's events carry no clock). A finished session's list is cached."""
    try:
        st = os.stat(path)
    except OSError:
        return []
    key = os.path.join(cache_dir, os.path.basename(path) + ".json")
    if end is not None:
        try:
            c = json.load(open(key))
            if [c["size"], c["mtime"], c["start"], c["end"]] == [st.st_size, st.st_mtime, start, end]:
                return c["changes"]
        except (OSError, ValueError, KeyError, TypeError):
            pass
    n = int(re.search(r"iter-(\d+)", path).group(1))
    out, args, counts, pos, stop = [], {}, {}, 0, end if end is not None else time.time()
    with open(path, "rb") as fh:
        for raw in fh:
            pos += len(raw)
            if b'"tool_execution_' not in raw:   # most lines are streamed text: skip them unparsed
                continue
            try:
                e = json.loads(raw)
                t = e.get("type") if isinstance(e, dict) else None
                if t == "tool_execution_start":
                    args[e.get("toolCallId")] = e.get("args") or {}
                elif t == "tool_execution_end":
                    name, a = e.get("toolName"), args.pop(e.get("toolCallId"), {})
                    if name not in ("edit", "write", "bash"):
                        continue
                    meta, body, err = tool_result(name, a, e)
                    c = None if err else change(name, a, meta, body)
                    if c:
                        counts[c[0]] = counts.get(c[0], 0) + 1
                        at = start + (stop - start) * pos / max(st.st_size, 1)
                        out.append([{**c[1], "id": f"{n}:{c[0]}{counts[c[0]]}", "iter": n, "t": round(at, 1), "approx": True}, c[2]])
            except Exception as exc:
                fault(f"{os.path.basename(path)} (timeline)", exc)
    if end is not None:
        try:
            os.makedirs(cache_dir, exist_ok=True)
            with open(key + ".tmp", "w") as fh:
                json.dump({"size": st.st_size, "mtime": st.st_mtime, "start": start, "end": end, "changes": out}, fh)
            os.replace(key + ".tmp", key)
        except OSError:
            pass
    return out


def sprint_start(main):
    """When the project's current sprint began: the commit sprint-progress counts it from."""
    try:
        since = json.loads(subprocess.run([SPRINT_TOOL, main, "--json"], capture_output=True, text=True, timeout=30).stdout)["since"]
        return int(subprocess.run(["git", "-C", main, "log", "-1", "--format=%ct", str(since)], capture_output=True, text=True, timeout=10).stdout.strip())
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return None


def session_row(r):
    """iterations.jsonl row -> what the timeline keeps of a finished session"""
    return {"iter": r["iter"], "end": int(iso_epoch(r["end"]) or 0) or None, "status": r.get("status_after"), "verify": r.get("verify"), "wrapup": r.get("wrapup")}


def history(name, path, main, out):
    """The sprint so far for one agent: its sessions, their file changes and test runs, the driver's markers. Runs in a
    thread (a sprint is hundreds of MB of session files); the lines go to `out` for the main loop to send."""
    try:
        since = sprint_start(main) or time.time() - 86400
        agent = os.path.join(path, ".agent")
        rows = {}
        for l in (read(os.path.join(agent, "iterations.jsonl")) or "").splitlines():
            try:
                r = json.loads(l)
            except ValueError:
                continue
            if isinstance(r, dict) and isinstance(r.get("iter"), int):
                rows[r["iter"]] = r
        sessions = []
        out.put({"op": "flow_span", "ch": name, "since": int(since)})
        for l in (read(os.path.join(agent, "loop.log")) or "").splitlines():
            m = re.match(r"(\S+ \S+) iteration (\d+): (.*?)(?: \(harness \S+\))?$", l)
            t = stamp_epoch(l)
            if t is None or t < since:
                continue
            if m:
                sessions.append((int(m.group(2)), t, m.group(3)))
            else:
                mk = log_mark(l)
                if mk:
                    out.put({"op": "flow_mark", "ch": name, "mark": mk})
        newest = max((n for n, _, _ in sessions), default=0)
        for n, t, task in sessions:
            prep = task.startswith("prep for ")
            task = task[len("prep for "):] if prep else task
            r = rows.get(n)
            f = os.path.join(agent, "sessions", f"iter-{n:04d}.jsonl")
            end = iso_epoch(r["end"]) if r and r.get("end") else None
            if end is None and n != newest:   # a prep session (no row) or one cut short: it ended when its file stopped growing
                try:
                    end = os.path.getmtime(f)
                except OSError:
                    end = t
            tid, tname = task_parts(task)
            sess = {"iter": n, "task_id": tid, "task": tname, "start": int(t), "end": int(end) if end else None, "prep": prep}
            if r:
                sess.update({k: v for k, v in session_row(r).items() if v is not None})
            out.put({"op": "flow_sess", "ch": name, "sess": sess})
            for node, body in session_changes(f, t, int(end) if end else None, os.path.join(CACHE, name)):
                out.put({"op": "flow_node", "ch": name, "node": node, "body": body})
            time.sleep(0.05)   # the first read of a sprint is ~1 GB: leave the disk to the agents' test runs in between
        out.put({"op": "flow_done", "ch": name})
    except Exception as exc:
        fault(f"{name} (timeline history)", exc)


# ------------------------------------------------------------------------------------------------ the link

class Link:
    """The connection to the AI box: lines up, commands down. Reconnects with backoff; every new connection gets a full
    resync."""

    def __init__(self, target, stdio):
        self.target, self.stdio, self.proc, self.out = target, stdio, None, None
        self.cmds = queue.Queue()
        self.generation = 0

    def connect(self):
        if self.stdio:
            self.out = sys.stdout
            threading.Thread(target=self.reader, args=(sys.stdin, self.generation), daemon=True).start()
            return True
        self.proc = subprocess.Popen(["ssh", "-T", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3", self.target],
                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        self.out = self.proc.stdin
        self.generation += 1
        threading.Thread(target=self.reader, args=(self.proc.stdout, self.generation), daemon=True).start()
        return True

    def reader(self, fh, gen):
        for line in fh:
            try:
                c = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(c, dict):
                self.cmds.put(c)
        if self.stdio:
            self.cmds.put({"op": "_eof"})

    def alive(self):
        return self.stdio or (self.proc is not None and self.proc.poll() is None)

    def send(self, obj):
        try:
            self.out.write(json.dumps(obj, separators=(",", ":")) + "\n")
            self.out.flush()
            return True
        except (OSError, ValueError, AttributeError):
            return False


def main():
    args = sys.argv[1:]
    only = args[args.index("--only") + 1].split(",") if "--only" in args else []
    target = args[args.index("--target") + 1] if "--target" in args else "labdash-feed"
    stdio = "--stdio" in args
    link = Link(target, stdio)
    channels, boards = {}, {}
    broken = [False]
    flow_q, hist_threads = queue.Queue(), {}

    def send(obj):
        if not link.send(obj):
            broken[0] = True

    def scan():
        """Loops that run now, or ran in the last RECENT seconds."""
        found = {}
        for n in visible(only):
            path = os.path.join(PROJECTS, n)
            a = os.path.join(path, ".agent")
            if not os.path.isdir(os.path.join(a, "sessions")):
                continue
            recent = False
            try:
                recent = time.time() - max(os.path.getmtime(os.path.join(a, "sessions", f)) for f in os.listdir(os.path.join(a, "sessions"))) < RECENT
            except (OSError, ValueError):
                pass
            if pid_alive(os.path.join(a, "loop.pid")) or (recent and not os.path.exists(os.path.join(a, "team-main"))):
                found[n] = path
        for n in list(channels):
            if n not in found:
                del channels[n]
                send({"op": "gone", "ch": n})
        for n, path in found.items():
            if n not in channels:
                channels[n] = Channel(n, path, send)
                channels[n].guarded("its session", channels[n].reset)
                if not (n in hist_threads and hist_threads[n].is_alive()):
                    hist_threads[n] = threading.Thread(target=history, args=(n, path, channels[n].team_dir or path, flow_q), daemon=True)
                    hist_threads[n].start()

    def mains():
        return sorted({c.team_dir or c.path for c in channels.values()})

    def resync():
        """The server keeps what the page shows across a reconnect; synced tells it which channels and boards to drop."""
        send({"op": "hello", "version": 2, "host": os.uname().nodename})
        channels.clear()
        boards.clear()
        hist_threads.clear()   # a restarted server has no timeline: every agent's history is sent again
        scan()
        send({"op": "synced", "channels": sorted(channels), "projects": [os.path.basename(m) for m in mains()]})

    backoff = 2
    while True:
        broken[0] = False
        t_connect = time.time()
        link.connect()
        log("connected" if not stdio else "stdio")
        resync()
        t_snap = t_scan = 0.0
        while link.alive() and not broken[0]:
            for c in list(channels.values()):
                c.guarded("its stream", c.poll)
            for _ in range(400):   # the timeline's history, a slice per turn so the live streams stay live
                try:
                    item = flow_q.get_nowait()
                except queue.Empty:
                    break
                if item.get("ch") in channels:
                    send(item)
            now = time.time()
            if now - t_scan > SCAN_EVERY:
                t_scan = now
                scan()
            if now - t_snap > SNAP_EVERY:
                t_snap = now
                for c in list(channels.values()):
                    c.guarded("its task panel", c.snapshot)
                    c.guarded("its timeline", c.flow_rows)
                for m in mains():
                    try:
                        b = board(m)
                    except Exception as exc:
                        fault(f"{os.path.basename(m)} (sprint board)", exc)
                        continue
                    if b is not None and b != boards.get(m):
                        boards[m] = b
                        send({"op": "board", "project": os.path.basename(m), "board": b})
            try:
                cmd = link.cmds.get(timeout=0.25)
            except queue.Empty:
                continue
            op, cid = cmd.get("op"), str(cmd.get("id", ""))[:32]
            if op == "_eof":
                return
            if op == "resync":
                ch = cmd.get("ch")
                if ch in channels:
                    channels[ch].guarded("its session", channels[ch].reset)
                    channels[ch].guarded("its task panel", channels[ch].snapshot)
                else:
                    resync()
                    t_snap = 0.0
                continue
            if op not in ("message", "answer"):
                continue
            ch = channels.get(cmd.get("ch"))
            text = clean(cmd.get("text", ""), 4000).strip()
            try:
                if ch is None:
                    raise ValueError("that agent is not on the console")
                if not text:
                    raise ValueError("empty message")
                if op == "message":
                    ch.message(text, bool(cmd.get("stop")))
                else:
                    ask = str(cmd.get("ask", ""))
                    if not re.fullmatch(r"\d{1,4}", ask):
                        raise ValueError("bad request number")
                    ch.answer(ask, text)
                    ch.snapshot()
                send({"op": "ack", "id": cid, "ok": True})
            except Exception as e:   # a refused or failed command is answered, never fatal
                send({"op": "ack", "id": cid, "ok": False, "error": str(e)[:200]})
        if stdio:
            return
        log(f"link down; reconnecting in {backoff}s")
        try:
            link.proc.kill()
        except (OSError, AttributeError):
            pass
        backoff = 2 if time.time() - t_connect > 60 else min(60, backoff * 2)
        time.sleep(backoff)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
