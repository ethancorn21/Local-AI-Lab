#!/usr/bin/env python3
"""agent-watch's viewer: a Claude Code-style live view of a Pi agent loop, from Pi's --mode json event stream.

Shows the agent's thinking (dim; Ctrl-T hides it), its answers (light markdown, code blocks highlighted) and each tool
call the way Claude Code does: edits as coloured diffs with line numbers, written files with syntax highlighting,
command output trimmed to its first lines. What the driver writes to the loop log (saved work, merges, new tasks,
waits) appears in between, so the view never goes quiet without saying why.

Layout, like Claude Code: finished lines go into the terminal's normal output, so scrollback and following the bottom
work as they do for any command. Under them a footer is redrawn in place: the line being streamed, an activity row
(what runs right now: a command with its latest output line, a tool call being written, thinking, the driver between
sessions, a stopped loop), the message line and the status bar (context, speed and session time, from the model
server's own metrics). There is no scroll region: with one, macOS Terminal stopped following the output and left
stale rows behind on resize.

Talking to the agent (--follow on a terminal): type on the message line above the status bar.
  Enter  sends the message. Pi hands it to the model after its current turn: the response being generated and its
         tool calls finish first, which can take a few minutes when it is deep in thought.
  Esc    with a message typed: stops the running session now; the loop's next session starts with your message.
  Ctrl-T shows / hides thinking.  Ctrl-U clears the input.  Ctrl-C closes the viewer (the loop keeps running).
Messages go through <project>/.agent/inbox/: the human-messages Pi extension delivers them during a session, the
driver puts any left over into the next session's prompt.

Usage: pi-live --follow <project>    follow the newest .agent/sessions/iter-*.jsonl, switching as sessions start
       pi-live                       read events from stdin (view only)
Env: LLM_URL (default: the LLM_URL in the project's .agent/team.env, so each team agent shows its own server, else
http://127.0.0.1:8080); AGENT_WATCH_BG light|dark: the terminal's background, for the syntax and diff colours
(default light); AGENT_WATCH_COLOR=1 forces colours when stdout is not a terminal.
"""
import codecs
import glob
import json
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import threading
import time
import tty
import unicodedata
import urllib.request

try:
    from pygments import highlight
    from pygments.formatters import Terminal256Formatter
    from pygments.lexers import get_lexer_by_name, get_lexer_for_filename
    from pygments.util import ClassNotFound
except ImportError:
    highlight = None

BASE = os.environ.get("LLM_URL", "http://127.0.0.1:8080")
BG = os.environ.get("AGENT_WATCH_BG", "light")
TTY = sys.stdout.isatty()
COLOR = TTY or os.environ.get("AGENT_WATCH_COLOR") == "1"


def sgr(*codes):
    return f"\033[{';'.join(map(str, codes))}m" if COLOR else ""


RST, BOLD, DIM, ITAL = sgr(0), sgr(1), sgr(2), sgr(3)
RED, GREEN, YEL, CYAN, GREY = sgr(31), sgr(32), sgr(33), sgr(36), sgr(90)
ADD_BG, DEL_BG = (sgr(48, 5, 22), sgr(48, 5, 52)) if BG == "dark" else (sgr(48, 5, 194), sgr(48, 5, 224))
DOT, ELBOW = "⏺", "⎿"
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
FORMATTER = Terminal256Formatter(style="monokai" if BG == "dark" else "xcode") if highlight else None
ANSI = re.compile(r"\033\[[0-9;?]*[A-Za-z]")
CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")   # every control character but tab and newline
LOG_LINE = re.compile(r"^\d{4}-\d\d-\d\d (\d\d:\d\d:\d\d) (.*)$")
DIFF_LINES, WRITE_LINES, OUTPUT_LINES = 40, 12, 6

lock = threading.RLock()   # re-entrant: Ctrl-C can land while the main thread holds it
ui = {"cols": 80, "input": "", "thinking": True, "label": "", "t0": time.time(), "phase": "", "sprint": "",
      "composing": None, "project": None, "task_id": "", "session_file": None, "ended": None, "loop_on": True,
      "sess_on": True, "loop_last": None}
INTERACTIVE = False


def k(n):
    return f"{n / 1000:.1f}k"


def dur(s):
    s = max(0, int(s))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60:02d}s"
    if s < 86400:
        return f"{s // 3600}h{s % 3600 // 60:02d}m"
    return f"{s // 86400}d{s % 86400 // 3600}h"


def cells(s):
    """Terminal columns taken by plain text: wide (East Asian) characters take two, combining marks none."""
    if s.isascii():
        return len(s)
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def clip(plain, n):
    """At most n columns of plain text, '…' marking the cut."""
    if cells(plain) <= n:
        return plain
    kept, w = "", 0
    for c in plain:
        w += cells(c)
        if w > n - 1:
            break
        kept += c
    return kept + "…"


def tail(plain, n):
    """The last n columns of plain text, '…' marking the cut."""
    if cells(plain) <= n:
        return plain
    kept, w = "", 0
    for c in reversed(plain):
        w += cells(c)
        if w > n - 1:
            break
        kept = c + kept
    return "…" + kept


def wrap1(line, width):
    """(first row, rest) of a line wider than width columns, cut at the last space that fits."""
    w, cut, space = 0, len(line), -1
    for i, c in enumerate(line):
        w += cells(c)
        if w > width:
            cut = i
            break
        if c == " ":
            space = i
    if space > 0:
        return line[:space], line[space + 1:]
    return line[:cut], line[cut:]


def clean(v):
    """The agent's text made safe to print: escape sequences and control characters dropped (a stray cursor move
    would break the footer), tabs as four spaces."""
    if isinstance(v, str):
        return v if v.isprintable() else CTRL.sub("", ANSI.sub("", v)).replace("\t", "    ")
    if isinstance(v, dict):
        return {key: clean(x) for key, x in v.items()}
    if isinstance(v, list):
        return [clean(x) for x in v]
    return v


def pid_alive(name):
    try:
        os.kill(int(open(os.path.join(ui["project"], ".agent", name)).read().strip()), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


# ---------------------------------------------------------------- syntax highlighting

LEXERS = {}


def lexer(path=None, lang=None):
    if not (highlight and COLOR):
        return None
    key = path or f"lang:{lang}"
    if key not in LEXERS:
        try:
            lx = get_lexer_for_filename(path, stripnl=False) if path else get_lexer_by_name(lang or "text", stripnl=False)
        except (ClassNotFound, TypeError):
            lx = None
        LEXERS[key] = lx
    return LEXERS[key]


def hl(line, lx, bg=""):
    """One line of code with syntax colours; with bg, the background survives the formatter's resets."""
    if not lx:
        return bg + line
    return bg + highlight(line, lx, FORMATTER).rstrip("\n")   # the 256-colour formatter only resets the foreground


# ---------------------------------------------------------------- the screen: finished lines, then the footer

TAIL = ["\n\n"]   # last two visible characters written, so blocks get exactly one blank line between them


class Screen:
    """Finished lines go into the terminal's normal output. The footer under them is whole rows, each narrower than
    the terminal so none wraps, and is erased (cursor up, clear to the end of the screen) and redrawn around every
    write. All writing happens in flush(), under the lock, one write per redraw."""

    def __init__(self):
        self.pending, self.drawn, self.kind = [], [], None

    def add(self, s, kind="agent"):
        with lock:
            self.pending.append(s)
            plain = ANSI.sub("", s)
            if plain:
                TAIL[0] = (TAIL[0] + plain)[-2:]
                self.kind = kind

    def erase(self, cols):
        """Back to the footer's first row and clear from there; rows wider than a narrowed terminal were re-wrapped."""
        h = sum(max(1, -(-cells(ANSI.sub("", r)) // cols)) for r in self.drawn)
        return ("\r" + (f"\033[{h - 1}A" if h > 1 else "") + "\033[J") if self.drawn else ""

    def flush(self):
        with lock:
            text = "".join(self.pending)
            self.pending = []
            if not TTY:
                if text:
                    sys.stdout.write(text)
                    sys.stdout.flush()
                return
            cols = shutil.get_terminal_size().columns
            rows = footer(cols)
            if not text and rows == self.drawn and cols == ui["cols"]:
                return
            if text and not TAIL[0].endswith("\n"):   # the footer starts on a row of its own
                text += "\n"
                TAIL[0] = TAIL[0][-1] + "\n"
            sys.stdout.write("\033[?2026h" + self.erase(cols) + text + "\r\n".join(rows) + "\033[?2026l")
            sys.stdout.flush()
            self.drawn, ui["cols"] = rows, cols

    def close(self):
        """Leave the finished lines and remove the footer."""
        with lock:
            self.flush()
            if TTY:
                sys.stdout.write(self.erase(ui["cols"]) + "\033[?2026l\033[?2004l\033[?25h" + RST)
                sys.stdout.flush()
            self.drawn = []


SCREEN = Screen()
out = SCREEN.add


def gap():
    """Start a new block: exactly one blank line after whatever came before."""
    t = TAIL[0]
    out("" if t == "\n\n" else "\n" if t.endswith("\n") else "\n\n")


def footer(cols):
    w = cols - 1
    rows = []
    live = R.live(w)
    if live:
        rows.append(live)
    rows.append(GREY + clip(activity(), w) + RST)
    if INTERACTIVE:
        if ui["input"]:
            shown = CTRL.sub("", ui["input"].replace("\n", "⏎").replace("\t", " "))
            rows.append(f"{BOLD}›{RST} {tail(shown, w - 3)}\033[7m \033[0m")
        else:
            hint = (f"› message the agent: type, Enter sends (read after its current step) · Esc stops the session "
                    f"and sends now · Ctrl-T thinking {'on' if ui['thinking'] else 'off'} · Ctrl-C quits")
            rows.append(GREY + clip(hint, w) + RST)
    rows.append(f"\033[7m\033[1m {clip(status(), w - 2)} \033[0m")
    return rows


def activity():
    """One line on what is happening right now."""
    now = time.time()
    spin = SPIN[int(now * 5) % len(SPIN)]
    last = ui["loop_last"]
    news = f" · {last[1]} ({dur(now - last[0])} ago)" if last else ""
    if ui["project"] and not ui["loop_on"]:
        return f"■ loop stopped{news}"
    if ui["project"] and not ui["sess_on"]:
        return f"{spin} between sessions{news}"
    return f"{spin} {R.doing(now)}"


def status():
    now = time.time()
    parts = [p for p in (ui["label"], ui["sprint"], ui["phase"]) if p]
    if not ui["project"] or ui["sess_on"]:
        parts.append(f"session {dur(now - ui['t0'])}")
    elif ui["ended"]:
        parts.append(f"session ended {dur(now - ui['ended'])} ago")
    return " | ".join(parts)


# ---------------------------------------------------------------- status: model server, loop state, sprint

VLLM_LAST = [None]   # (time, generation_tokens_total) for the vLLM rate


def vllm_phase():
    """vLLM has no /slots: read its Prometheus /metrics (generated-token counter, running requests, KV pool use)."""
    try:
        text = urllib.request.urlopen(BASE + "/metrics", timeout=2).read().decode()
    except Exception:
        return "model server unreachable (tunnel down?)"
    vals = {}
    for ln in text.splitlines():
        for key in ("vllm:generation_tokens_total", "vllm:num_requests_running", "vllm:kv_cache_usage_perc"):
            if ln.startswith(key + "{") or ln.startswith(key + " "):
                vals[key] = vals.get(key, 0.0) + float(ln.rsplit(" ", 1)[1])
    now, gen = time.time(), vals.get("vllm:generation_tokens_total", 0.0)
    last, VLLM_LAST[0] = VLLM_LAST[0], (now, gen)
    running = vals.get("vllm:num_requests_running", 0) > 0
    rate = (gen - last[1]) / (now - last[0]) if last and now > last[0] else 0.0
    phase = f"gen {rate:5.1f} tok/s" if running and rate > 0 else ("reading prompt" if running else "idle")
    return f"{phase} | KV pool {100 * vals.get('vllm:kv_cache_usage_perc', 0):.0f}%"


def llama_phase(state):
    """llama-server's /slots: context used and speed of the running request."""
    s = json.load(urllib.request.urlopen(BASE + "/slots", timeout=2))[0]
    dec = ((s.get("next_token") or [{}])[0]).get("n_decoded", 0)
    used, n_ctx, task_id = s.get("n_prompt_tokens", 0), s.get("n_ctx", 1), s.get("id_task")
    now, last = time.time(), state.get("last")
    if not s.get("is_processing"):
        phase = "idle"
    elif dec == 0:
        done = s.get("n_prompt_tokens_processed", 0) + s.get("n_prompt_tokens_cache", 0)
        phase = f"reading prompt {min(100, 100 * done / max(used, 1)):3.0f}%"
    elif last and last[2] == task_id and dec > last[1]:
        state.setdefault("rates", []).append((dec - last[1]) / (now - last[0]))
        del state["rates"][:-3]
        phase = f"gen {sum(state['rates']) / len(state['rates']):5.1f} tok/s"
    else:
        phase = "generating"
    state["last"] = (now, dec, task_id)
    return f"ctx {k(used)}/{k(n_ctx)} ({100 * used / n_ctx:.0f}%) | {phase}"


def sprint_line():
    """Where the current task sits in the sprint and how far the sprint is, from sprint-progress (next to this
    script): '4 of 6 in this sprint | sprint 1/6 done, 3 in progress, 2 to go', or '' if unavailable."""
    if not ui.get("project"):
        return ""
    tool = os.path.join(os.path.dirname(os.path.realpath(__file__)), "sprint-progress")
    cmd = [tool, ui["project"]] + (["--task", ui["task_id"]] if ui.get("task_id") else [])
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def status_loop():
    state = {}
    while True:
        try:   # this thread keeps the footer alive: nothing may end it
            try:
                ui["phase"] = llama_phase(state)
            except Exception:
                ui["phase"] = vllm_phase()
            if ui["project"]:
                ui["loop_on"], ui["sess_on"] = pid_alive("loop.pid"), pid_alive("pi.pid")
                if ui["session_file"]:
                    ui["ended"] = os.path.getmtime(ui["session_file"])
                if time.time() - state.get("sprint_t", 0) > 15:   # merges move it; a few seconds of lag is fine
                    state["sprint_t"] = time.time()
                    ui["sprint"] = sprint_line()
            SCREEN.flush()
        except Exception:
            pass
        time.sleep(1)


# ---------------------------------------------------------------- talking to the agent

def send(msg, now):
    d = os.path.join(ui["project"], ".agent", "inbox")
    os.makedirs(d, exist_ok=True)
    name = f"{int(time.time() * 1000)}{'.now' if now else ''}.md"
    tmp = os.path.join(d, "." + name + ".tmp")
    with open(tmp, "w") as fh:
        fh.write(msg + "\n")
    os.rename(tmp, os.path.join(d, name))
    if now:
        note = "stopping this session; the next one starts with your message" if pid_alive("pi.pid") \
            else "no session is running: the next one starts with your message"
    else:
        note = "queued: the agent reads it after its current step" if pid_alive("pi.pid") \
            else "no session is running: the next one starts with your message"
    R.interject(f"{YEL}{BOLD}» you:{RST}{YEL} {msg}{RST}\n  {GREY}{note}{RST}")


def input_loop(fd):
    dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
    buf, paste = b"", False

    def add(b):
        ui["input"] += dec.decode(b).replace("\r", "\n")

    while True:
        try:
            data = os.read(fd, 1024)
        except OSError:
            return
        if not data:
            return
        buf += data
        while buf:
            if paste:
                end = buf.find(b"\033[201~")
                if end < 0:
                    add(buf)
                    buf = b""
                else:
                    add(buf[:end])
                    buf, paste = buf[end + 6:], False
                continue
            if buf.startswith(b"\033[200~"):
                buf, paste = buf[6:], True
                continue
            c = buf[0]
            if c == 0x1B:
                if len(buf) == 1:
                    if select.select([fd], [], [], 0.05)[0]:
                        buf += os.read(fd, 1024)
                        continue
                    buf = b""
                    msg = ui["input"].strip()
                    if msg:
                        ui["input"] = ""
                        send(msg, now=True)
                    continue
                m = re.match(rb"\033(\[[0-9;?]*[ -/]*[@-~]|O.|.)", buf, re.S)   # arrow keys etc.: ignored
                buf = buf[m.end():] if m else buf[1:]
                continue
            buf = buf[1:]
            if c in (0x0D, 0x0A):
                msg = ui["input"].strip()
                ui["input"] = ""
                if msg:
                    send(msg, now=False)
            elif c in (0x7F, 0x08):
                ui["input"] = ui["input"][:-1]
            elif c == 0x15:
                ui["input"] = ""
            elif c == 0x14:
                ui["thinking"] = not ui["thinking"]
                R.interject(f"{GREY}(thinking {'shown' if ui['thinking'] else 'hidden'}){RST}")
            elif c >= 0x20:
                j = 0
                while j < len(buf) and buf[j] >= 0x20 and buf[j] != 0x7F:
                    j += 1
                add(bytes([c]) + buf[:j])
                buf = buf[j:]
        SCREEN.flush()


# ---------------------------------------------------------------- rendering Pi's events

def md(line, fence):
    """Assistant text, one line: code fences highlighted, headers and **bold** bold, `code` cyan."""
    stripped = line.strip()
    if stripped.startswith("```"):
        return GREY + line + RST, (None if fence else (stripped[3:].strip() or "text"))
    if fence:
        return hl(line, lexer(lang=fence)) + RST, fence
    if stripped.startswith("#"):
        return BOLD + stripped.lstrip("#").strip() + RST, None
    line = re.sub(r"\*\*(.+?)\*\*", lambda m: BOLD + m.group(1) + RST, line)
    line = re.sub(r"`([^`]+)`", lambda m: CYAN + m.group(1) + RST, line)
    return line, None


def tool_header(name, args):
    a = args or {}
    first = lambda s: str(s or "").strip().splitlines()[0] if str(s or "").strip() else ""
    if name == "bash":
        cmd = str(a.get("command", ""))
        more = " …" if "\n" in cmd.strip() else ""
        return f"{BOLD}Bash{RST}({first(cmd)}{more})"
    if name == "edit":
        return f"{BOLD}Update{RST}({a.get('path')})"
    if name == "write":
        return f"{BOLD}Write{RST}({a.get('path')})"
    if name == "read":
        rng = ""
        if a.get("offset") or a.get("limit"):
            start = int(a.get("offset") or 1)
            rng = f", lines {start}-{start + int(a['limit']) - 1}" if a.get("limit") else f", from line {start}"
        return f"{BOLD}Read{RST}({a.get('path')}{rng})"
    if name == "web_search":
        return f"{BOLD}Web Search{RST}(\"{a.get('query')}\")"
    if name == "web_fetch":
        return f"{BOLD}Fetch{RST}({a.get('url')})" + (f" {GREY}asking: {a['question']}{RST}" if a.get("question") else "")
    if name == "ask_human":
        return f"{YEL}{BOLD}Ask the human{RST}{YEL} ({'blocking' if a.get('blocking') is not False else 'non-blocking'}){RST}"
    return f"{BOLD}{name}{RST}({clip(json.dumps(a), 120)})"


def result_text(e, key="result"):
    content = (e.get(key) or {}).get("content") or []
    return "".join(c.get("text", "") for c in content if isinstance(c, dict))


def elbow(lines, colour=GREY):
    """Claude Code's result block: first line after ⎿, the rest indented under it."""
    return "".join(f"  {ELBOW}  " + colour + l + RST + "\n" if i == 0 else "     " + colour + l + RST + "\n"
                   for i, l in enumerate(lines))


def render_diff(path, diff):
    lx = lexer(path=path)
    rows, shown = diff.split("\n"), []
    for line in rows[:DIFF_LINES]:
        m = re.match(r"^([ +-])(\s*\d*)\s(.*)$", line)
        if not m:
            shown.append(f"      {GREY}{line}{RST}")
            continue
        sign, num, code = m.group(1), m.group(2).strip(), m.group(3)
        bg = ADD_BG if sign == "+" else DEL_BG if sign == "-" else ""
        body = hl(code, lx, bg) if bg else DIM + code + RST
        shown.append(f"      {GREY}{num:>4}{RST} {bg}{sign} {body}\033[K{RST}" if COLOR else f"      {num:>4} {sign} {code}")
    if len(rows) > DIFF_LINES:
        shown.append(f"      {GREY}… +{len(rows) - DIFF_LINES} lines{RST}")
    return "\n".join(shown) + "\n"


def render_result(name, args, e):
    a, text = args or {}, result_text(e)
    if e.get("isError"):
        return elbow([f"Error: {l}" for l in (text.strip().splitlines() or ["(no message)"])[:4]], RED)
    if name == "edit":
        diff = ((e.get("result") or {}).get("details") or {}).get("diff") or ""
        adds = sum(1 for l in diff.split("\n") if l.startswith("+"))
        rems = sum(1 for l in diff.split("\n") if l.startswith("-"))
        head = elbow([f"Updated {a.get('path')} with {adds} addition{'s' * (adds != 1)} and "
                      f"{rems} removal{'s' * (rems != 1)}"], "")
        return head + (render_diff(a.get("path"), diff) if diff else "")
    if name == "write":
        lines = str(a.get("content", "")).rstrip("\n").split("\n")
        lx = lexer(path=a.get("path"))
        body = "".join(f"      {GREY}{i + 1:>4}{RST} {hl(l, lx)}{RST}\n" for i, l in enumerate(lines[:WRITE_LINES]))
        more = f"      {GREY}… +{len(lines) - WRITE_LINES} lines{RST}\n" if len(lines) > WRITE_LINES else ""
        return elbow([f"Wrote {len(lines)} lines to {a.get('path')}"], "") + body + more
    if name == "read":
        n = len(text.rstrip("\n").split("\n")) if text.strip() else 0
        return elbow([f"Read {n} lines"])
    if name == "web_search":
        n = len(re.findall(r"^\d+\. ", text, re.M))
        return elbow([f"{n} result{'s' * (n != 1)}"])
    if name == "web_fetch":
        return elbow([clip((text.split("\n")[1:2] or [""])[0], 150)])
    lines = text.rstrip("\n").split("\n") if text.strip() else ["(no output)"]
    shown = lines[:OUTPUT_LINES] + ([f"… +{len(lines) - OUTPUT_LINES} lines"] if len(lines) > OUTPUT_LINES else [])
    return elbow(shown)


class Renderer:
    """Pi's events -> finished lines (Screen.add) plus the unfinished one, which the footer shows (live())."""

    def __init__(self):
        self.reset()

    def reset(self):
        self.mode = None          # thinking / text / None
        self.text, self.fence, self.first_line = "", None, True
        self.pend, self.think_rows, self.ended = "", 0, False
        self.t_think, self.user_msgs, self.last_header, self.t_event = 0.0, 0, None, time.time()
        self.tools = {}           # running tools: toolCallId -> [name, args, started, latest output line]

    def interject(self, s):
        """A line from the viewer itself (the human's message, a toggle) in the middle of the stream. The line being
        streamed stays in the footer and carries on below it."""
        out(s + "\n")

    def end_stream(self):
        if self.mode == "thinking":
            self.commit_think(final=True)
        elif self.mode == "text":
            self.flush_text(final=True)
        self.mode = None

    def think_row(self, text):
        if not self.think_rows and not text.strip():   # blank lines before the first words
            return
        out(f"{GREY}{ITAL}{'  ' if self.think_rows else '✻ '}{text}{RST}\n")
        self.think_rows += 1

    def commit_think(self, final=False):
        """Print the finished rows of the thinking stream, wrapped at word boundaries to the terminal's width; the
        unfinished row stays for the footer."""
        width = max(20, ui["cols"] - 3)
        while self.pend:
            line, nl, rest = self.pend.partition("\n")
            if cells(line) > width:
                head, more = wrap1(line, width)
                self.think_row(head)
                self.pend = more + nl + rest
            elif nl or final:
                self.think_row(line)
                self.pend = rest
            else:
                break

    def flush_text(self, final=False):
        while "\n" in self.text or (final and self.text):
            line, _, rest = self.text.partition("\n")
            self.text = rest
            if self.first_line and not line.strip():   # leading blank lines of an answer
                continue
            shown, self.fence = md(line, self.fence)
            prefix = f"{DOT} " if self.first_line else "  "
            self.first_line = False
            out(prefix + shown + RST + "\n")

    def start_text(self):
        self.end_stream()
        gap()
        self.mode, self.text, self.first_line, self.fence, self.last_header = "text", "", True, None, None

    def live(self, width):
        """The row being streamed, for the footer."""
        if self.mode == "thinking" and self.pend and ui["thinking"]:
            return f"{GREY}{ITAL}{'  ' if self.think_rows else '✻ '}{self.pend}{RST}"
        if self.mode == "text" and self.text.strip():
            return f"{DOT if self.first_line else ' '} " + md(tail(self.text, width - 2), self.fence)[0] + RST
        return ""

    def doing(self, now):
        quiet = now - self.t_event
        quiet = f" · no new output for {dur(quiet)}" if quiet > 10 else ""
        if self.tools:
            name, args, t, line = next(iter(self.tools.values()))
            s = f"running {ANSI.sub('', tool_header(name, args))} · {dur(now - t)}"
            s += f" (+{len(self.tools) - 1} more)" if len(self.tools) > 1 else ""
            return s + (f" · {line}" if line else "")
        c = ui["composing"]
        if c:   # vLLM sends a long argument in a few big chunks: the count can sit still while the model writes
            return f"writing a {c[0]} call ({k(c[1])} chars so far){quiet}"
        if self.mode == "thinking":
            return f"thinking · {dur(now - self.t_think)}" + ("" if ui["thinking"] else " (hidden: Ctrl-T shows it)")
        if self.mode == "text":
            return "answering"
        if self.ended:
            return "session finished: the driver takes over"
        if re.search(r"\bgen(erating)?\b", ui["phase"]):   # generating, yet nothing streams: a tool call held back
            return f"the model is writing its next tool call (shown when complete){quiet}"
        if "reading prompt" in ui["phase"]:
            return f"the model is reading the prompt{quiet}"
        return f"waiting for the model{quiet}"

    def event(self, e):
        t = e.get("type")
        self.t_event = time.time()
        if t == "message_update":
            d = e.get("assistantMessageEvent") or {}
            dt = d.get("type")
            if dt == "thinking_start":
                self.end_stream()
                gap()
                self.mode, self.t_think, self.pend, self.think_rows, self.last_header = "thinking", time.time(), "", 0, None
            elif dt == "thinking_delta" and self.mode == "thinking":
                if ui["thinking"]:
                    self.pend += d.get("delta", "")
                    self.commit_think()
                elif self.pend:   # just hidden: keep what was already shown
                    self.commit_think(final=True)
            elif dt == "thinking_end" and self.mode == "thinking":
                self.commit_think(final=True)
                if not self.think_rows:
                    out(f"{GREY}✻ Thought for {dur(time.time() - self.t_think)}{RST}\n")
                self.mode = None
            elif dt == "text_start":
                self.start_text()
            elif dt == "text_delta":
                if self.mode != "text":
                    self.start_text()
                self.text += d.get("delta", "")
                self.flush_text()
            elif dt == "text_end":
                self.flush_text(final=True)
                self.mode = None
            elif dt == "toolcall_start":
                ui["composing"] = [d.get("toolName") or "tool", 0]
            elif dt == "toolcall_delta" and ui["composing"]:
                ui["composing"][1] += len(d.get("delta", ""))
            elif dt == "toolcall_end":
                ui["composing"] = None
        elif t == "message_end" and (e.get("message") or {}).get("role") == "user":
            self.end_stream()
            msg = e["message"]
            text = "".join(c.get("text", "") for c in (msg.get("content") or []) if isinstance(c, dict)).strip()
            self.user_msgs += 1
            if self.user_msgs == 1:   # the loop's prompt for this session
                head, sep, extra = text.partition("The human sent you")
                out(f"{GREY}❯ {clip(head.strip().replace(chr(10), ' '), 200)}{RST}\n")
                if sep:
                    out(f"{YEL}{BOLD}» from you:{RST}{YEL} {sep}{extra}{RST}\n")
            elif text.startswith("[harness]"):
                out(f"{YEL}⚑ {clip(text.splitlines()[0], 200)}{RST}\n")
            else:
                out(f"{BOLD}❯ {text}{RST}\n")
        elif t == "tool_execution_start":
            self.end_stream()
            ui["composing"] = None
            self.tools[e.get("toolCallId")] = [e.get("toolName"), e.get("args") or {}, time.time(), ""]
            gap()
            out(f"{CYAN}{DOT}{RST} {tool_header(e.get('toolName'), e.get('args'))}\n")
            self.last_header = e.get("toolCallId")
            if e.get("toolName") == "ask_human":
                req = str((e.get("args") or {}).get("request", "")).splitlines()
                out("".join(f"  {YEL}│ {l}{RST}\n" for l in req[:12]))
        elif t == "tool_execution_update":   # a command's output so far: its latest line goes on the activity row
            tool = self.tools.get(e.get("toolCallId"))
            lines = [l.strip() for l in result_text(e, "partialResult").splitlines() if l.strip()]
            if tool and lines:
                tool[3] = lines[-1]
        elif t == "tool_execution_end":
            name, args = self.tools.pop(e.get("toolCallId"), [e.get("toolName"), {}])[:2]
            if self.last_header != e.get("toolCallId"):   # tools ran in parallel: say which one this result is
                gap()
                out(f"{GREY}{DOT}{RST} {GREY}{ANSI.sub('', tool_header(name, args))}{RST}\n")
            out(render_result(name, args, e))
            self.last_header = None
        elif t in ("compaction_start", "auto_retry_start"):
            self.end_stream()
            out(f"{YEL}[{t}] {e.get('reason') or e.get('errorMessage') or ''}{RST}\n")
        elif t == "agent_end":
            self.end_stream()
            self.ended = True


R = Renderer()


# ---------------------------------------------------------------- following a project

def log_start(path, n):
    """Byte offset in the loop log just after session n's 'iteration n:' line, so the view starts with everything
    the driver logged since; without one, its last ten lines."""
    data = open(path, "rb").read()
    i = data.rfind(f" iteration {n}: ".encode()) if n else -1
    if i >= 0:
        j = data.find(b"\n", i)
        return len(data) if j < 0 else j + 1
    return len(data) - sum(len(l) for l in data.splitlines(keepends=True)[-10:])


def follow(project):
    """Yield the events of the newest session file (replaying it from the start), the driver's new loop-log lines
    as {"type": "_loop"}, and None when there is nothing new. A newer session file is taken only once the current
    one is read to its end, and a line still being written waits for its newline."""
    log_path = os.path.join(project, ".agent/loop.log")
    current, n, fh, buf, log, log_buf = None, 0, None, "", None, b""
    while True:
        line = fh.readline() if fh else ""
        if line:
            buf += line
            if buf.endswith("\n"):
                text, buf = buf, ""
                try:
                    yield clean(json.loads(text))
                except json.JSONDecodeError:
                    pass
            continue
        files = sorted(glob.glob(os.path.join(project, ".agent/sessions/iter-*.jsonl")))
        if fh is None and files:   # first the newest session, so the log can start where that session started
            current = files[-1]
            fh = open(current, errors="replace")
            n = int(os.path.basename(current)[5:9])
            yield {"type": "_session", "path": current, "n": n}
            continue
        if log is None and os.path.exists(log_path):
            log = open(log_path, "rb")
            log.seek(log_start(log_path, n))
        if log:
            if os.path.getsize(log_path) < log.tell():   # rewritten
                log.seek(0)
            for raw in iter(log.readline, b""):
                log_buf += raw
                if not log_buf.endswith(b"\n"):
                    break
                text, log_buf = log_buf.decode("utf-8", "replace").rstrip("\n"), b""
                yield {"type": "_loop", "line": clean(text)}
        files = sorted(glob.glob(os.path.join(project, ".agent/sessions/iter-*.jsonl")))   # again: lines came first
        if files and files[-1] != current:
            current, buf = files[-1], ""
            fh = open(current, errors="replace")
            n = int(os.path.basename(current)[5:9])
            yield {"type": "_session", "path": current, "n": n}
            continue
        yield None
        time.sleep(0.2)


def start_session(path, n):
    project = ui["project"]
    task, t0 = "", os.path.getmtime(path)
    try:
        for l in open(os.path.join(project, ".agent/loop.log"), errors="replace"):
            if f"iteration {n}:" in l:
                task = l.split(f"iteration {n}: ", 1)[-1].split(" (harness")[0].strip()
                try:
                    t0 = time.mktime(time.strptime(l[:19], "%Y-%m-%d %H:%M:%S"))
                except ValueError:
                    pass
    except OSError:
        pass
    m = re.match(r"tasks/(\d+[a-z]*)-(.+)\.md$", task)
    short = f"task {m.group(1)} ({m.group(2).replace('-', ' ')})" if m else task
    ui.update(task_id=m.group(1) if m else "", label=f"session {n} | {short}", t0=t0, session_file=path,
              ended=os.path.getmtime(path), loop_on=pid_alive("loop.pid"), sess_on=pid_alive("pi.pid"))
    ui["sprint"] = sprint_line()
    R.end_stream()
    R.reset()
    gap()
    out(f"{BOLD}── session {n} · {short}{' · ' + ui['sprint'] if ui['sprint'] else ''} ──{RST}\n")


def loop_line(line):
    m = LOG_LINE.match(line)
    if m:
        try:
            ts = time.mktime(time.strptime(line[:19], "%Y-%m-%d %H:%M:%S"))
        except ValueError:
            ts = time.time()
        ui["loop_last"] = (ts, m.group(2))
    if re.search(r" iteration \d+: ", line):   # the session header says it
        return
    if SCREEN.kind != "loop":
        gap()
    colour = YEL if re.search(r"\b(WARNING|ERROR|STUCK|stalled|rejected)\b", line) else GREY
    out(f"{colour}◆ {m.group(1) + ' ' + m.group(2) if m else line}{RST}\n", kind="loop")


def team_url(project):
    """A team agent's model server: the LLM_URL line in its worktree's .agent/team.env."""
    try:
        for l in open(os.path.join(project, ".agent/team.env")):
            m = re.match(r"\s*(?:export\s+)?LLM_URL=['\"]?([^'\"\s]+)", l)
            if m:
                return m.group(1)
    except OSError:
        pass
    return None


def stdin_events():
    for line in sys.stdin:
        try:
            yield clean(json.loads(line))
        except json.JSONDecodeError:
            pass


def main():
    global INTERACTIVE, BASE
    source = stdin_events()
    old = None
    ui["cols"] = shutil.get_terminal_size().columns
    if len(sys.argv) == 3 and sys.argv[1] == "--follow":
        ui["project"] = os.path.realpath(sys.argv[2])
        if "LLM_URL" not in os.environ:
            BASE = team_url(ui["project"]) or BASE
        source = follow(ui["project"])
        INTERACTIVE = TTY and sys.stdin.isatty()
    if TTY:
        sys.stdout.write("\033[?25l" + ("\033[?2004h" if INTERACTIVE else ""))   # hide the cursor; bracketed paste
    if INTERACTIVE:
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)
        threading.Thread(target=input_loop, args=(fd,), daemon=True).start()
    if TTY:
        threading.Thread(target=status_loop, daemon=True).start()
    last = 0.0
    try:
        for e in source:
            if e is not None:
                with lock:   # the footer reads the renderer's state from the other threads
                    t = e.get("type")
                    if t == "_session":
                        start_session(e["path"], e["n"])
                    elif t == "_loop":
                        loop_line(e["line"])
                    else:
                        R.event(e)
                if time.time() - last < 0.05:   # catching up: redraw at most 20 times a second
                    continue
            SCREEN.flush()
            last = time.time()
        R.end_stream()
    finally:
        if old:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        R.end_stream()
        SCREEN.close()
