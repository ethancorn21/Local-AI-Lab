#!/usr/bin/env python3
"""Claude Code-style live view of Pi's --mode json event stream.

Streams thinking (dim), answers (normal) and tool calls (cyan) into the terminal, with a status bar pinned to the
bottom row: iteration/task, context used vs window, generation and prompt-processing speed. Speed and context come
from llama-server's /slots endpoint (through the tunnel), so they are the model server's own numbers.
Usage: pi-live                       read events from stdin
       pi-live --follow <project>    follow the newest .agent/sessions/iter-*.jsonl, switching as iterations start
Env: LLM_URL (default http://127.0.0.1:8080), PI_LIVE_LABEL (e.g. "iter 3 | tasks/001-parser.md").
Ctrl-C only stops this viewer; the agent loop keeps running.
"""
import glob
import re
import json
import os
import shutil
import sys
import threading
import time
import urllib.request

BASE = os.environ.get("LLM_URL", "http://127.0.0.1:8080")
URL = BASE + "/slots"
LABEL = os.environ.get("PI_LIVE_LABEL", "")
TTY = sys.stdout.isatty()
DIM, CYAN, RED, YEL, BOLD, RST = ("\033[2m", "\033[36m", "\033[31m", "\033[33m", "\033[1m", "\033[0m") if TTY else ("",) * 6
lock = threading.Lock()
state = {"mode": None}          # which stream is being printed: thinking / text
ITER_START = [time.time()]   # reset when --follow switches to a new iteration


def out(s):
    with lock:
        sys.stdout.write(s)
        sys.stdout.flush()


def setup_region():
    if not TTY:
        return 0
    rows = shutil.get_terminal_size().lines
    sys.stdout.write(f"\033[1;{rows - 1}r\033[{rows - 1};1H")   # scroll region = all but the last row
    sys.stdout.flush()
    return rows


def k(n):
    return f"{n / 1000:.1f}k"


VLLM_LAST = [None]   # (time, generation_tokens_total) for the vLLM rate


def vllm_status():
    """vLLM has no /slots: read its Prometheus /metrics (generated-token counter, running requests, KV pool use)."""
    try:
        text = urllib.request.urlopen(BASE + "/metrics", timeout=2).read().decode()
    except Exception:
        return "model server unreachable (tunnel down?)"
    vals = {}
    for ln in text.splitlines():
        for key in ("vllm:generation_tokens_total", "vllm:num_requests_running", "vllm:kv_cache_usage_perc"):
            if ln.startswith(key + "{") or ln.startswith(key + " "):
                vals[key] = vals.get(key, 0.0) + float(ln.rsplit(" ", 1)[1])
    now, gen = time.time(), vals.get("vllm:generation_tokens_total", 0.0)
    last, VLLM_LAST[0] = VLLM_LAST[0], (now, gen)
    running = vals.get("vllm:num_requests_running", 0) > 0
    rate = (gen - last[1]) / (now - last[0]) if last and now > last[0] else 0.0
    phase = f"gen {rate:5.1f} tok/s" if running and rate > 0 else ("reading prompt" if running else "idle")
    return f"vLLM | {phase} | KV pool {100 * vals.get('vllm:kv_cache_usage_perc', 0):.0f}%"


def status_loop():
    last = None
    rates = []
    rows = setup_region()
    while True:
        time.sleep(1)
        try:
            s = json.load(urllib.request.urlopen(URL, timeout=2))[0]
        except Exception:
            line = vllm_status()
        else:
            # n_prompt_tokens is the slot's total token count and already includes generated tokens; a request is
            # identified by id_task. Speed = growth of n_decoded within one request.
            dec = ((s.get("next_token") or [{}])[0]).get("n_decoded", 0)
            used, n_ctx, task_id = s.get("n_prompt_tokens", 0), s.get("n_ctx", 1), s.get("id_task")
            now = time.time()
            if not s.get("is_processing"):
                phase = "idle"
            elif dec == 0:
                done = s.get("n_prompt_tokens_processed", 0) + s.get("n_prompt_tokens_cache", 0)
                phase = f"reading prompt {min(100, 100 * done / max(used, 1)):3.0f}%"
            elif last and last[2] == task_id and dec > last[1]:
                rates.append((dec - last[1]) / (now - last[0]))
                del rates[:-3]
                phase = f"gen {sum(rates) / len(rates):5.1f} tok/s"
            else:
                phase = "generating"
            last = (now, dec, task_id)
            pct = 100 * used / n_ctx
            colour = "\033[41m" if pct >= 75 else "\033[43m\033[30m" if pct >= 50 else ""
            mins, secs = divmod(int(now - ITER_START[0]), 60)
            bar = "\033[0m\033[7m\033[1m"   # reverse video + bold, re-applied after each coloured segment
            line = (f"{LABEL} | {colour}ctx {k(used)}/{k(n_ctx)} ({pct:.0f}%){bar} | {phase} | "
                    f"iter {mins}m{secs:02d}s")
        if TTY:
            cols = shutil.get_terminal_size().columns
            visible = len(re.sub(r"\033\[[0-9;]*m", "", line))
            if visible > cols - 2:   # never wrap the bar: trim the label (task path) first, then hard-cut
                line = line.replace(LABEL, LABEL[: max(0, len(LABEL) - (visible - cols + 3))], 1)
            if shutil.get_terminal_size().lines != rows:
                rows = setup_region()
            with lock:
                sys.stdout.write(f"\0337\033[{rows};1H\033[2K\033[7m\033[1m {line} \033[K\033[0m\0338")
                sys.stdout.flush()


def switch(mode, header=""):
    if state["mode"] != mode:
        out(RST + "\n" + header)
        state["mode"] = mode


def follow(project):
    """Yield event lines from the newest iteration file, replaying it from the start, then switch when a newer one
    appears. Sets the status label from the loop log."""
    global LABEL
    current, fh = None, None
    while True:
        files = sorted(glob.glob(os.path.join(project, ".agent/sessions/iter-*.jsonl")))
        if files and files[-1] != current:
            current = files[-1]
            fh = open(current)
            n = int(os.path.basename(current)[5:9])
            task = ""
            try:
                for l in open(os.path.join(project, ".agent/loop.log")):
                    if f"iteration {n}:" in l:
                        task = l.rsplit(": ", 1)[-1].strip()
            except OSError:
                pass
            LABEL = f"iter {n} | {task}"
            ITER_START[0] = os.path.getmtime(os.path.join(project, ".agent/loop.log"))
            out(f"{RST}\n{BOLD}===== iteration {n}: {task} ====={RST}\n")
        line = fh.readline() if fh else ""
        if line:
            yield line
        else:
            time.sleep(0.2)


def main():
    source = sys.stdin
    if len(sys.argv) == 3 and sys.argv[1] == "--follow":
        source = follow(sys.argv[2])
    threading.Thread(target=status_loop, daemon=True).start()
    for line in source:
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        t = e.get("type")
        if t == "message_update":
            d = e.get("assistantMessageEvent") or {}
            if d.get("type") == "thinking_delta":
                switch("thinking", f"{DIM}* thinking: ")
                out(DIM + d.get("delta", ""))
            elif d.get("type") == "text_delta":
                switch("text", "")
                out(RST + d.get("delta", ""))
        elif t == "tool_execution_start":
            args = e.get("args") or {}
            detail = args.get("command") or args.get("path") or args.get("file_path") or json.dumps(args)[:150]
            first = str(detail).splitlines()[0][:150] if detail else ""
            state["mode"] = None
            out(f"{RST}\n{CYAN}{BOLD}> {e.get('toolName')}{RST}{CYAN} {first}{RST}")
        elif t == "tool_execution_end" and e.get("isError"):
            res = (e.get("result") or {}).get("content") or [{}]
            out(f"\n{RED}  ! failed: {str(res[0].get('text', ''))[:200]}{RST}")
        elif t in ("compaction_start", "auto_retry_start"):
            state["mode"] = None
            out(f"\n{YEL}[{t}] {e.get('reason') or e.get('errorMessage') or ''}{RST}")
        elif t == "agent_end":
            state["mode"] = None
            out(RST + "\n")
    if TTY:
        out("\033[r")   # restore full-screen scrolling


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        if TTY:
            sys.stdout.write("\033[r" + RST + "\n")
