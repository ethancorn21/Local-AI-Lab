#!/usr/bin/env bash
# agent-start <project> : start a project's loop in the background. No tmux: it keeps running after you log out.
# <project> is a name under ~/projects or a path. Watch it with `agent-watch <project>` (Ctrl-C leaves the view, the
# loop keeps going); stop it with `agent-stop <project>`. Output goes to <project>/.agent/loop.out, the loop's own log
# to .agent/loop.log.
set -uo pipefail
export PATH="$HOME/.npm-global/bin:$HOME/bin:$PATH"
arg=${1:?usage: agent-start <project name or dir>}
if [ -d "$arg" ]; then P=$(realpath "$arg"); else P="$HOME/projects/$arg"; fi
[ -d "$P/tasks" ] || { echo "No project at $P (expected a tasks/ folder)."; exit 1; }
mkdir -p "$P/.agent"
if ! flock -n "$P/.agent/loop.lock" true; then echo "Already running. Watch it: agent-watch $arg"; exit 0; fi
# The driver reads a task's status from its first line; a queue with nothing workable stops at once.
open=$(for f in "$P"/tasks/[0-9]*.md; do [ -f "$f" ] && head -1 "$f"; done | grep -ciE '^status:[[:space:]]*(open|in-progress|split)')
if [ "${open:-0}" -eq 0 ]; then
  echo "Nothing to work on: no task file in $P/tasks/ whose first line is 'Status: open'."; exit 1
fi
rm -f "$P/.agent/PAUSE"
VIEWER=json setsid nohup agent-loop "$P" >> "$P/.agent/loop.out" 2>&1 < /dev/null &
echo $! > "$P/.agent/loop.pid"
sleep 4
if kill -0 "$(cat "$P/.agent/loop.pid")" 2>/dev/null; then
  echo "Running in the background."
  echo "  Watch:  agent-watch $arg     (Ctrl-C leaves the view; the loop keeps going)"
  echo "  Stop:   agent-stop $arg      (after the current session; --now to stop immediately)"
else
  echo "The loop stopped right away. Its last lines:"; tail -n 5 "$P/.agent/loop.log" 2>/dev/null || tail -n 5 "$P/.agent/loop.out"
  exit 1
fi
