#!/usr/bin/env bash
# agent-watch <project> : live view of a running loop (the agent's thinking, tool calls and output as they happen).
# <project> is a name under ~/projects or a path. Safe to Ctrl-C or close at any time: the loop keeps running.
arg=${1:-.}
if [ -d "$arg" ]; then P=$(realpath "$arg"); else P="$HOME/projects/$arg"; fi
exec "$(dirname "$(realpath "$0")")/pi-live" --follow "$P"
