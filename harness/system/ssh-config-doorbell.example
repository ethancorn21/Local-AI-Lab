# ~/.ssh/config of the agent user on the harness VM: `ssh doorbell send|fetch|ack` talks to the AI box's Telegram relay
# (see harness/tools/ring-doorbell and telecloak-pull). The key only runs the relay there (forced command); it cannot
# open a shell or forward ports, and it never gets the bot token or the encryption key.
# The AI box's host key goes in ~/.ssh/known_hosts first (copy the line the model tunnel already verified).
Host doorbell
  HostName <ai-box-address>
  User <doorbell-account>
  IdentityFile ~/.ssh/doorbell_ed25519
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking yes
