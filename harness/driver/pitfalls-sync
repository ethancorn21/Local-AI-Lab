#!/usr/bin/env python3
"""pitfalls-sync [project dir] : keep PITFALLS.md, the project's one file of lasting facts, in shape.

Only in a project that has a PITFALLS.md (projects started before it keep their PITFALL entries in DECISIONS.md).
Agents read the contents block at the top when a session starts and grep the rest when they need it; they may edit,
merge and delete entries (git keeps the history). This keeps the file searchable and the block true:
- PITFALL/LESSON entries still written to DECISIONS.md move to the `## Unsorted` section, text unchanged (the heading
  goes from `## ` to `#### `), for an agent to file under its section. They used to stay in DECISIONS.md forever: 77
  of them were 87% of frontpage's 74 KB DECISIONS.md, which every session read whole (2026-10-04).
- The fixed top sections exist: a missing one is added back, empty.
- The contents block is regenerated: each section with its entry count (subsections by name), and how many entries
  lack a `Where:` or `Symptom:` line, the keys an agent searches with.
Exit codes: 0 = nothing to change, 3 = files updated, 1 = error (nothing written).
"""
import os, re, sys

ACTIVE, PITFALLS = "DECISIONS.md", "PITFALLS.md"
FIXED = ["Agent tools and harness", "This machine and its environment", "Libraries and frameworks", "This codebase"]
UNSORTED = "Unsorted"
TOC_START = "<!-- contents:start (generated by the driver from the headings below; do not edit) -->"
TOC_END = "<!-- contents:end -->"
STICKY = re.compile(r"\b(PITFALL|LESSON)\b")
HEADING = re.compile(r"^(#{1,4}) ")
KEY = {"Where": re.compile(r"^\s*(\*\*)?Where:"), "Symptom": re.compile(r"^\s*(\*\*)?Symptom:")}


def split_decisions(lines):
    """-> (lines before the first entry, [entry line lists]), the generated archive index left in the prefix."""
    prefix, entries, fence, index = [], [], False, False
    for line in lines:
        if line.startswith("<!-- archive-index:start"):
            index = True
        if index:
            (entries[-1] if entries else prefix).append(line)
            index = not line.startswith("<!-- archive-index:end")
            continue
        if line.lstrip().startswith("```"):
            fence = not fence
        if not fence and line.startswith("## "):
            entries.append([line])
        elif entries:
            entries[-1].append(line)
        else:
            prefix.append(line)
    return prefix, entries


def drop_toc(lines):
    """The file without its contents block. Union merges of two agents' copies can leave two blocks or stray lines:
    everything from the first start marker to the last end marker goes."""
    starts = [i for i, l in enumerate(lines) if l.startswith("<!-- contents:start")]
    ends = [i for i, l in enumerate(lines) if l.startswith(TOC_END)]
    if not starts and not ends:
        return lines
    a = starts[0] if starts else ends[0]
    b = ends[-1] if ends and ends[-1] >= a else next((i - 1 for i in range(a + 1, len(lines)) if lines[i].startswith("## ")), len(lines) - 1)
    return lines[:a] + lines[b + 1:]


def sections(lines):
    """-> [(section name, start index)] of the `## ` headings outside code fences."""
    out, fence = [], False
    for i, line in enumerate(lines):
        if line.lstrip().startswith("```"):
            fence = not fence
        elif not fence and line.startswith("## "):
            out.append((line[3:].strip(), i))
    return out


def entries(lines):
    """-> [(section, subsection, entry lines)] for every `#### ` entry outside code fences."""
    out, sec, sub, cur, fence = [], None, None, None, False
    for line in lines:
        if line.lstrip().startswith("```"):
            fence = not fence
        m = None if fence else HEADING.match(line)
        if m:
            cur = None
            level = len(m.group(1))
            if level == 2:
                sec, sub = line[3:].strip(), None
            elif level == 3:
                sub = line[4:].strip()
            elif level == 4:
                cur = [line]
                out.append((sec, sub, cur))
            continue
        if cur is not None:
            cur.append(line)
    return out


def toc(lines):
    es = entries(lines)
    order = [name for name, _ in sections(lines)]
    out = [TOC_START,
           "Contents, with the number of entries. Search for a file, function, library or error text: "
           "`grep -n -i \"<key>\" PITFALLS.md`; every entry's one-line fact: `grep -n \"^#### \" PITFALLS.md`."]
    for name in order:
        mine = [e for e in es if e[0] == name]
        if name == UNSORTED and not mine:
            continue
        subs = {}
        for _, sub, _ in mine:
            if sub:
                subs[sub] = subs.get(sub, 0) + 1
        line = f"- {name} ({len(mine)})" + (": " + ", ".join(f"{s} {n}" for s, n in subs.items()) if subs else "")
        if name == UNSORTED:
            line += " - moved here from DECISIONS.md by the driver: file each under its section"
        out.append(line)
    lacking = sum(1 for _, _, e in es if not all(any(k.match(l) for l in e) for k in KEY.values()))
    if lacking:
        out.append(f"{lacking} entr{'y lacks' if lacking == 1 else 'ies lack'} a `Where:` or `Symptom:` line: "
                   "add them when you touch those entries.")
    return out + [TOC_END]


def main():
    os.chdir(sys.argv[1] if len(sys.argv) > 1 else ".")
    if not os.path.exists(PITFALLS):
        return 0
    pit_old = open(PITFALLS).read()
    act_old = open(ACTIVE).read() if os.path.exists(ACTIVE) else ""
    lines = drop_toc(pit_old.rstrip("\n").split("\n"))
    n_before = len(entries(lines))

    prefix, des = split_decisions(act_old.split("\n")) if act_old else ([], [])
    moving = [e for e in des if STICKY.search(e[0])]
    keep = [e for e in des if not STICKY.search(e[0])]

    names = [name for name, _ in sections(lines)]
    for name in FIXED:   # a missing fixed section comes back, before Unsorted
        if name not in names:
            at = dict(sections(lines)).get(UNSORTED, len(lines))
            lines[at:at] = ["", f"## {name}", ""]
            names = [n for n, _ in sections(lines)]
    if moving:
        if UNSORTED not in names:
            lines += ["", f"## {UNSORTED}", ""]
        moved = []
        for e in moving:
            body = "\n".join(e[1:]).strip("\n")
            moved += ["", "#### " + e[0][3:].rstrip()] + ([body] if body else [])
        at = len(lines)   # the end of Unsorted: the next section after it, or the end of the file
        secs = sections(lines)
        idx = [i for i, (name, _) in enumerate(secs) if name == UNSORTED][0]
        if idx + 1 < len(secs):
            at = secs[idx + 1][1]
        lines[at:at] = moved + [""]

    title_end = next((i + 1 for i, l in enumerate(lines) if l.startswith("# ")), 0)
    lines[title_end:title_end] = [""] + toc(lines) if title_end else toc(lines)
    pit_new = re.sub(r"\n{3,}", "\n\n", "\n".join(lines).rstrip("\n") + "\n")
    act_new = None
    if moving:
        act_new = "\n".join(prefix).rstrip("\n") + "\n\n" + "\n".join("\n".join(e).rstrip("\n") + "\n" for e in keep)
        act_new = act_new.rstrip("\n") + "\n"

    n_after = len(entries(pit_new.split("\n")))
    if n_after != n_before + len(moving) or not all("#### " + e[0][3:].rstrip() in pit_new for e in moving):
        print(f"pitfalls-sync: {n_before} + {len(moving)} entries became {n_after} - refusing to write", file=sys.stderr)
        return 1
    changed = False
    for path, old, new in ((PITFALLS, pit_old, pit_new), (ACTIVE, act_old, act_new)):
        if new is None or new == old:
            continue
        open(path + ".tmp", "w").write(new)
        os.replace(path + ".tmp", path)
        changed = True
    return 3 if changed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # never half-write; the driver logs and carries on
        print(f"pitfalls-sync: {exc}", file=sys.stderr)
        sys.exit(1)
