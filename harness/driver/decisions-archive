#!/usr/bin/env python3
"""decisions-archive [project dir] : keep DECISIONS.md small without losing anything.

Entries of tasks whose file says `Status: done` (or `dropped`) move VERBATIM to DECISIONS-archive.md, grouped by task.
A task that is not finished keeps only its newest DECISIONS_KEEP (3) entries in DECISIONS.md; its older entries move
to the archive too (frontpage 2026-10-02: a goal check rerun 19 times left 23 entries, and every session of both
agents spent ~20k tokens reading them).
Task ids are NNN or, for subtasks the agent splits off, NNN plus letters (025a). DECISIONS.md keeps a generated index
with one line per archived task (id, name, entry count) pointing the agent at the archive to grep. A task that is no
longer finished (reopened) gets its entries moved back. PITFALL/LESSON entries and entries without a task id never
move: they apply beyond one task.

Safety: the set of entries (exact text) before and after must be identical, or nothing is written.
Exit codes: 0 = nothing to change, 3 = files updated, 1 = error (nothing written).

decisions-archive --show <task id>... : print those tasks' entries (not PITFALL/LESSON) and the newest 3 entries
without a task id (the driver's project-wide notes), for PROGRESS.md: in a project with PITFALLS.md the agent reads
its own task's journal at spawn and searches DECISIONS.md for the rest. Entries over SHOW_MAX bytes are cut, with
the grep that finds the whole entry.
"""
import collections, datetime, glob, hashlib, os, re, sys

ACTIVE, ARCHIVE = "DECISIONS.md", "DECISIONS-archive.md"
KEEP = int(os.environ.get("DECISIONS_KEEP", "3"))
IDX_START = "<!-- archive-index:start (generated by the driver from DECISIONS-archive.md; do not edit) -->"
IDX_END = "<!-- archive-index:end -->"
TASK_MARK = re.compile(r"^<!-- task (\d{3}[a-z]*) -->\s*$")
TASK_ID = re.compile(r"^## (?:\d{4}-\d{2}-\d{2}\s+)?(\d{3}[a-z]*)\b")
TASK_FILE = re.compile(r"^(\d{3}[a-z]*)-(.+)\.md$")
FINISHED = ("done", "dropped")
STICKY = re.compile(r"\b(PITFALL|LESSON)\b")
SHOW_MAX = 4096
ARCHIVE_HEADER = """# Decisions archive

Entries of finished tasks, moved here verbatim from DECISIONS.md by the driver when each task was verified done, and
the older entries of tasks still open (DECISIONS.md keeps their newest ones).
Nothing was edited or summarized. DECISIONS.md lists the archived tasks; search here for the full reasoning:
`grep -n -i "<keyword>" DECISIONS-archive.md`, or a whole task with `grep -n "^## .*<task id>" DECISIONS-archive.md`.
Do not edit this file. If a task is reopened, the driver moves its entries back to DECISIONS.md.
"""


def split_entries(lines):
    """-> (lines before the first entry, [entry line lists]). An entry starts at a `## ` line outside code fences."""
    prefix, entries, fence = [], [], False
    for line in lines:
        if line.lstrip().startswith("```"):
            fence = not fence
        if not fence and line.startswith("## "):
            entries.append([line])
        elif entries:
            entries[-1].append(line)
        else:
            prefix.append(line)
    return prefix, entries


def text(entry):
    return "\n".join(entry).rstrip("\n ")


def task_of(entry):
    m = TASK_ID.match(entry[0])
    return m.group(1) if m else None


def read(path):
    return open(path).read().split("\n") if os.path.exists(path) else []


def load_active(lines):
    """Drop the generated index block, then split."""
    out, skip = [], False
    for line in lines:
        if line.startswith("<!-- archive-index:start"):
            skip = True
        elif line.startswith(IDX_END):
            skip = False
            continue
        if not skip:
            out.append(line)
    return split_entries(out)


def load_archive(lines):
    """-> OrderedDict task id -> [entries]. Lines outside task sections are the fixed header.
    (Until 2026-10-02 the end of the file was found with a sentinel "task 999" section that was then dropped: the
    archived entries of the real task 999, the goal check, were lost on the next run.)"""
    sections, cur, buf = collections.OrderedDict(), None, []
    for line in lines + [None]:
        m = TASK_MARK.match(line) if line is not None else None
        if m or line is None:
            if cur is not None:
                sections.setdefault(cur, []).extend(split_entries(buf)[1])
            if m:
                cur, buf = m.group(1), []
        elif cur is not None:
            buf.append(line)
    return sections


def shown(entry):
    """An entry for PROGRESS.md: its heading one level down (PROGRESS.md's own sections are `## `), cut at SHOW_MAX."""
    head, lines, size, kept = entry[0], ["#" + entry[0]], len(entry[0]), 0
    body = text(entry).split("\n")[1:]
    for line in body:
        if size + len(line) + 1 > SHOW_MAX:
            break
        lines.append(line)
        size += len(line) + 1
        kept += 1
    if kept < len(body):
        rest = sum(len(l) + 1 for l in body[kept:])
        lines.append(f"... ({rest / 1024:.1f} KB more: `grep -n -A 200 -F '{head}' DECISIONS.md`)")
    return "\n".join(lines)


def show(tids):
    _, entries = load_active(read(ACTIVE))
    mine = [e for e in entries if task_of(e) in tids and not STICKY.search(e[0])]
    notes = [e for e in entries if not task_of(e) and not STICKY.search(e[0])][-3:]
    print("## Your task's journal\n")
    print("Its newest `DECISIONS.md` entries, the driver's notes on it included (a rejected done claim says why here). "
          "Search `DECISIONS.md` and `DECISIONS-archive.md` for other tasks' reasoning.\n")
    print("\n\n".join(shown(e) for e in mine) if mine else "(no entries yet)")
    if notes:
        print("\n## Project-wide driver notes (newest)\n")
        print("\n\n".join(shown(e) for e in notes))
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--show":
        return show(set(sys.argv[2:]))
    os.chdir(sys.argv[1] if len(sys.argv) > 1 else ".")
    status, names = {}, {}
    for f in glob.glob("tasks/[0-9][0-9][0-9]*-*.md"):
        m = TASK_FILE.match(os.path.basename(f))
        if not m:
            continue
        tid, name = m.group(1), m.group(2)
        first = open(f).readline()
        m = re.match(r"\s*status:\s*([a-z-]+)", first.lower())   # the first word (agent-loop status_of)
        status[tid] = m.group(1) if m else ""
        names[tid] = name
    act_lines, arc_lines = read(ACTIVE), read(ARCHIVE)
    if not act_lines:
        return 0
    prefix, entries = load_active(act_lines)
    sections = load_archive(arc_lines)
    before = sorted(hashlib.sha256(text(e).encode()).hexdigest() for e in entries + [e for s in sections.values() for e in s])

    # Per task, oldest first: what is already archived (moved earlier), then the active entries in file order.
    # Finished task: everything to the archive. Open task: its newest KEEP entries stay in front of the agent, older
    # ones go to the archive (a reopened task gets back only its newest). Untagged and PITFALL/LESSON entries never
    # move, and neither do the entries of a task id without a task file (it may exist on another agent's branch).
    archived = {id(e) for es in sections.values() for e in es}
    history = collections.OrderedDict((tid, list(es)) for tid, es in sections.items())
    for e in entries:
        tid = task_of(e)
        if tid and not STICKY.search(e[0]):
            history.setdefault(tid, []).append(e)
    sections, stay = collections.OrderedDict(), set()
    for tid, es in history.items():
        if tid not in status:
            to_archive = [e for e in es if id(e) in archived]
            stay.update(id(e) for e in es if id(e) not in archived)
        elif status[tid] in FINISHED:
            to_archive = es
        else:
            cut = max(0, len(es) - KEEP)
            to_archive = es[:cut]
            stay.update(id(e) for e in es[cut:])
        if to_archive:
            sections[tid] = to_archive
    tagged = lambda e: task_of(e) and not STICKY.search(e[0])
    keep = [e for e in entries if not tagged(e) or id(e) in stay]          # active entries, original order
    keep += [e for es in history.values() for e in es if id(e) in archived and id(e) in stay]   # moved back, at the end

    after = sorted(hashlib.sha256(text(e).encode()).hexdigest() for e in keep + [e for s in sections.values() for e in s])
    if before != after:
        print("decisions-archive: entry set changed during sync - refusing to write", file=sys.stderr)
        return 1

    sections = collections.OrderedDict(sorted(sections.items()))
    arc_out = [ARCHIVE_HEADER.rstrip("\n")]
    for tid, es in sections.items():
        arc_out += ["", f"<!-- task {tid} -->", f"# Task {tid} {names.get(tid, '')}".rstrip(), ""]
        arc_out += ["\n".join([text(e), ""]) for e in es]
    idx = []
    if sections:
        n = sum(len(s) for s in sections.values())
        idx = [IDX_START, "## Archived decisions", "",
               f"{n} entries were moved verbatim to `DECISIONS-archive.md`: all of a finished task's, and the older ones "
               "of a task still open (its newest stay below). Before trying "
               "an approach in an area one of them touched, grep the archive (e.g. `grep -n -i \"collision\" "
               "DECISIONS-archive.md`) and read only the matching entries, never the whole file.", ""]
        idx += [(f"- {tid} {names.get(tid, '')} ({len(es)} {'entry' if len(es) == 1 else 'entries'}"
                 + ("" if status.get(tid) in FINISHED else ", older ones; the task is still open") + ")").replace("  ", " ")
                for tid, es in sections.items()]
        idx += ["", IDX_END]
    act_out = ["\n".join(prefix).rstrip("\n"), ""] + (idx + [""] if idx else []) + ["\n".join([text(e), ""]) for e in keep]
    new_act = "\n".join(act_out).rstrip("\n") + "\n"
    # an archive emptied by reopens is rewritten (header only), never left holding entries that moved back
    new_arc = "\n".join(arc_out).rstrip("\n") + "\n" if sections or arc_lines else None

    changed = False
    for path, new in ((ACTIVE, new_act), (ARCHIVE, new_arc)):
        if new is None or (os.path.exists(path) and open(path).read() == new):
            continue
        tmp = path + ".tmp"
        open(tmp, "w").write(new)
        os.replace(tmp, path)
        changed = True
    return 3 if changed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # never half-write; the driver logs and carries on
        print(f"decisions-archive: {exc}", file=sys.stderr)
        sys.exit(1)
