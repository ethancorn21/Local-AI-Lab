#!/usr/bin/env python3
"""decisions-archive [project dir] : keep DECISIONS.md small without losing anything.

Entries of tasks whose file says `Status: done` (or `dropped`) move VERBATIM to DECISIONS-archive.md, grouped by task.
Task ids are NNN or, for subtasks the agent splits off, NNN plus letters (025a). DECISIONS.md keeps a generated index
with one line per archived task (id, name, entry count) pointing the agent at the archive to grep. A task that is no
longer finished (reopened) gets its entries moved back. PITFALL/LESSON entries and entries without a task id never
move: they apply beyond one task.

Safety: the set of entries (exact text) before and after must be identical, or nothing is written.
Exit codes: 0 = nothing to change, 3 = files updated, 1 = error (nothing written).
"""
import collections, datetime, glob, hashlib, os, re, sys

ACTIVE, ARCHIVE = "DECISIONS.md", "DECISIONS-archive.md"
IDX_START = "<!-- archive-index:start (generated by the driver from DECISIONS-archive.md; do not edit) -->"
IDX_END = "<!-- archive-index:end -->"
TASK_MARK = re.compile(r"^<!-- task (\d{3}[a-z]*) -->\s*$")
TASK_ID = re.compile(r"^## (?:\d{4}-\d{2}-\d{2}\s+)?(\d{3}[a-z]*)\b")
TASK_FILE = re.compile(r"^(\d{3}[a-z]*)-(.+)\.md$")
FINISHED = ("done", "dropped")
STICKY = re.compile(r"\b(PITFALL|LESSON)\b")
ARCHIVE_HEADER = """# Decisions archive

Entries of finished tasks, moved here verbatim from DECISIONS.md by the driver when each task was verified done.
Nothing was edited or summarized. DECISIONS.md lists the archived tasks; search here for the full reasoning:
`grep -n -i "<keyword>" DECISIONS-archive.md`, or a whole task with `grep -n "^## .*<task id>" DECISIONS-archive.md`.
Do not edit this file. If a task is reopened, the driver moves its entries back to DECISIONS.md.
"""


def split_entries(lines):
    """-> (lines before the first entry, [entry line lists]). An entry starts at a `## ` line outside code fences."""
    prefix, entries, fence = [], [], False
    for line in lines:
        if line.lstrip().startswith("```"):
            fence = not fence
        if not fence and line.startswith("## "):
            entries.append([line])
        elif entries:
            entries[-1].append(line)
        else:
            prefix.append(line)
    return prefix, entries


def text(entry):
    return "\n".join(entry).rstrip("\n ")


def task_of(entry):
    m = TASK_ID.match(entry[0])
    return m.group(1) if m else None


def read(path):
    return open(path).read().split("\n") if os.path.exists(path) else []


def load_active(lines):
    """Drop the generated index block, then split."""
    out, skip = [], False
    for line in lines:
        if line.startswith("<!-- archive-index:start"):
            skip = True
        elif line.startswith(IDX_END):
            skip = False
            continue
        if not skip:
            out.append(line)
    return split_entries(out)


def load_archive(lines):
    """-> OrderedDict task id -> [entries]. Lines outside task sections are the fixed header."""
    sections, cur = collections.OrderedDict(), None
    buf = []
    for line in lines + ["<!-- task 999 -->"]:
        m = TASK_MARK.match(line)
        if m:
            if cur is not None:
                sections[cur] = split_entries(buf)[1]
            cur, buf = m.group(1), []
        elif cur is not None:
            buf.append(line)
    sections.pop("999", None)
    return sections


def main():
    os.chdir(sys.argv[1] if len(sys.argv) > 1 else ".")
    status, names = {}, {}
    for f in glob.glob("tasks/[0-9][0-9][0-9]*-*.md"):
        m = TASK_FILE.match(os.path.basename(f))
        if not m:
            continue
        tid, name = m.group(1), m.group(2)
        first = open(f).readline()
        status[tid] = re.sub(r"^status:\s*", "", first.strip().lower())
        names[tid] = name
    act_lines, arc_lines = read(ACTIVE), read(ARCHIVE)
    if not act_lines:
        return 0
    prefix, entries = load_active(act_lines)
    sections = load_archive(arc_lines)
    before = sorted(hashlib.sha256(text(e).encode()).hexdigest() for e in entries + [e for s in sections.values() for e in s])

    keep = []
    for e in entries:
        tid = task_of(e)
        if tid and status.get(tid) in FINISHED and not STICKY.search(e[0]):
            sections.setdefault(tid, []).append(e)
        else:
            keep.append(e)
    for tid in list(sections):  # reopened task (file exists, not finished): its history belongs in front of the agent again
        if tid in status and status[tid] not in FINISHED:
            keep.extend(sections.pop(tid))

    after = sorted(hashlib.sha256(text(e).encode()).hexdigest() for e in keep + [e for s in sections.values() for e in s])
    if before != after:
        print("decisions-archive: entry set changed during sync - refusing to write", file=sys.stderr)
        return 1

    sections = collections.OrderedDict(sorted(sections.items()))
    arc_out = [ARCHIVE_HEADER.rstrip("\n")]
    for tid, es in sections.items():
        arc_out += ["", f"<!-- task {tid} -->", f"# Task {tid} {names.get(tid, '')}".rstrip(), ""]
        arc_out += ["\n".join([text(e), ""]) for e in es]
    idx = []
    if sections:
        n = sum(len(s) for s in sections.values())
        idx = [IDX_START, "## Archived decisions of finished tasks", "",
               f"{n} entries of the finished tasks below were moved verbatim to `DECISIONS-archive.md`. Before trying "
               "an approach in an area one of them touched, grep the archive (e.g. `grep -n -i \"collision\" "
               "DECISIONS-archive.md`) and read only the matching entries, never the whole file.", ""]
        idx += [f"- {tid} {names.get(tid, '')} ({len(es)} {'entry' if len(es) == 1 else 'entries'})".replace("  ", " ")
                for tid, es in sections.items()]
        idx += ["", IDX_END]
    act_out = ["\n".join(prefix).rstrip("\n"), ""] + (idx + [""] if idx else []) + ["\n".join([text(e), ""]) for e in keep]
    new_act = "\n".join(act_out).rstrip("\n") + "\n"
    # an archive emptied by reopens is rewritten (header only), never left holding entries that moved back
    new_arc = "\n".join(arc_out).rstrip("\n") + "\n" if sections or arc_lines else None

    changed = False
    for path, new in ((ACTIVE, new_act), (ARCHIVE, new_arc)):
        if new is None or (os.path.exists(path) and open(path).read() == new):
            continue
        tmp = path + ".tmp"
        open(tmp, "w").write(new)
        os.replace(tmp, path)
        changed = True
    return 3 if changed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # never half-write; the driver logs and carries on
        print(f"decisions-archive: {exc}", file=sys.stderr)
        sys.exit(1)
