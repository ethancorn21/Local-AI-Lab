# agent-team-lib : team mode for agent-loop, sourced when TEAM_DIR is set (agent-team sets it up; see agent-team).
# Several agents build one project at once. Each works in its own git worktree on branch agent/<id>; `main`, checked
# out in TEAM_DIR, collects finished work. Coordination state lives in TEAM_DIR/.agent/team/ (never in git):
#   claims/<key>/owner   one top-level task (its subtasks included) belongs to one agent: "<agent> <loop pid> <epoch> <task file>"
#   loops/<id>.pid       the agents' running loops
#   loops/<id>.beat      touched by an agent's loop all the time (also during sessions and waits): a claim is stale,
#                        and can be taken over, only when its agent's loop is not running AND its heartbeat is older
#                        than TEAM_STALE_MIN (120). A restart or a short stop never looks like a crash.
#   merge.lock           one merge into main at a time
#   prep/<id>/owner      an idle agent is preparing that task: "<agent> <loop pid> <epoch>" (see Prep below)
#   prep-tries/<id>      prep sessions on that task that wrote no notes (two and it is not prepared again)
#   takeover/<key>/asker a faster agent with nothing to build asks the holder for that claim (see Takeover below)
#   carry/<key>          a claim just given: "<giver> <commit>" and the paths of its work, for the new owner to apply
#   events.jsonl         what happened, for monitoring (agent-team status): claims, waits, merges, conflicts
#   STOP                 written by the agent that ran the last goal check; the others stop too
# Rules in code, not prose: a task is offered only when its `Depends on:` tasks are done in main and its `Touches:`
# paths do not overlap the paths of a task another agent holds; an accepted task goes into main only after main has
# been merged into the branch and the tests pass there.
TEAM=${TEAM_DIR:-}/.agent/team
BRANCH=agent/${AGENT_ID:-}
[ -n "${TEAM_DIR:-}" ] && mkdir -p "$TEAM/claims" "$TEAM/loops"   # (agent-team init loads this only for the plan text)
# Timing tests run alone across the checkouts (pylib/agent_testlock.py): every pytest of this loop, its sessions
# included, loads the plugin; a run with a *perf* test file locks tests.lock exclusively, any other run shared.
if [ -n "${TEAM_DIR:-}" ] && [ -f "$HOME/.agent-kit/pylib/agent_testlock.py" ] && [[ ,${PYTEST_PLUGINS:-}, != *,agent_testlock,* ]]; then
  export AGENT_TEST_LOCK=$TEAM/tests.lock
  export PYTHONPATH=$HOME/.agent-kit/pylib${PYTHONPATH:+:$PYTHONPATH}
  export PYTEST_PLUGINS=agent_testlock${PYTEST_PLUGINS:+,$PYTEST_PLUGINS}
fi

tev() {  # tev <event> [task] [detail] : one line in the team's event log
  jq -n -c --arg t "$(date -Iseconds)" --arg a "$AGENT_ID" --arg e "$1" --arg task "${2:-}" --arg d "${3:-}" \
    '{time: $t, agent: $a, event: $e, task: $task, detail: $d}' >> "$TEAM/events.jsonl"
}
claim_key() { task_id "$1" | grep -oE '^[0-9]+'; }   # 025b -> 025: a claim covers the task and all its subtasks
owner_line() { cat "$TEAM/claims/$1/owner" 2>/dev/null; }
team_beat() { touch "$TEAM/loops/$AGENT_ID.beat" 2>/dev/null || true; }
agent_alive() {  # agent_alive <id> : its loop runs, or it stopped less than TEAM_STALE_MIN minutes ago (restart, stop)
  local f=$TEAM/loops/$1.pid b=$TEAM/loops/$1.beat
  [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && return 0
  [ -f "$b" ] && [ $(( $(date +%s) - $(stat -c %Y "$b") )) -lt $(( ${TEAM_STALE_MIN:-120} * 60 )) ]
}
claim_owner() {  # claim_owner <key> : the agent holding a live claim on it (this agent's own claims always count)
  local a
  read -r a _ <<<"$(owner_line "$1")"
  [ -n "${a:-}" ] || return 0
  if [ "$a" = "$AGENT_ID" ] || agent_alive "$a"; then echo "$a"; fi
}
claim_task() {  # claim_task <task file> : take the task (atomic); fails while another live agent holds it
  local k d o; k=$(claim_key "$1"); d=$TEAM/claims/$k
  if ! mkdir "$d" 2>/dev/null; then
    o=$(claim_owner "$k")
    if [ -z "$o" ]; then   # the holder's loop is gone: take the claim over (rename is atomic: one agent wins)
      local old; old=$(owner_line "$k")
      mv "$d" "$TEAM/claims/.stale-$k-$$-$(date +%s)" 2>/dev/null && mkdir "$d" 2>/dev/null || return 1
      tev stale_claim "$1" "$old"; log "team: took over the stale claim on $k ($old)"
    elif [ "$o" != "$AGENT_ID" ]; then return 1; fi
  fi
  local p; read -r o p _ <<<"$(owner_line "$k")"
  [ "${o:-}" = "$AGENT_ID" ] && [ "${p:-}" = "$$" ] && return 0
  echo "$AGENT_ID $$ $(date +%s) $P/$1" > "$d/owner"
  # 000 and 999 skip the check below (the driver reopens them itself, in-progress), so a checkout that is only behind
  # main could take the planning task again right after another agent finished it (team test 2026-10-04: the pick ran
  # between this checkout's sync and the other agent's merge; the plan ran twice). Catch up with main, then look again.
  case $1 in tasks/000-*|tasks/999-*)
    if ! git merge-base --is-ancestor main HEAD && team_sync && [ "$(status_of "$1")" = done ]; then
      rm -rf "${TEAM:?}/claims/$k"; tev stale_view "$1" "done in main, this checkout was behind"
      log "team: $1 was just finished by another agent (this checkout was behind main) - not taking it"; return 1
    fi ;;
  esac
  # Another agent may have finished it between this checkout's last sync and the claim: it merges into main before
  # it releases, so main knows. Then this checkout is only behind: give the claim back.
  if [ -n "$(done_in_main "$1")" ]; then
    rm -rf "${TEAM:?}/claims/$k"; tev stale_view "$1" "done in main before this checkout synced"
    log "team: $1 was just finished by another agent - not taking it"; return 1
  fi
  tev claim "$1"; return 0
}
done_in_main() {  # done_in_main <task file> : its status in main, if this checkout still shows it open but main has it done or dropped
  case $1 in tasks/000-*|tasks/999-*) return 0 ;; esac   # the driver itself reopens these (GOAL.md change, a new goal-check round)
  [ "$(status_of "$1")" = open ] || return 0   # in progress here = reopened by this agent: this checkout knows better
  local m s; m=$(compgen -G "$TEAM_DIR/tasks/$(task_id "$1")-*.md" | head -1)
  [ -n "$m" ] || return 0
  s=$(status_of "$m"); case $s in done|dropped) echo "$s" ;; esac
  return 0
}
release_claim() {  # release_claim <task file> : after the top-level task is merged into main or dropped
  local k; k=$(claim_key "$1")
  [ "$(claim_owner "$k")" = "$AGENT_ID" ] || return 0
  rm -rf "${TEAM:?}/claims/$k"; tev release "$1"; log "team: released $k"
}
others_tasks() {  # task files (in their worktrees) that other live agents hold
  local o a p f
  for o in "$TEAM"/claims/*/owner; do
    [ -f "$o" ] || continue
    read -r a p _ f < "$o"
    [ "$a" != "$AGENT_ID" ] && agent_alive "$a" && [ -f "$f" ] && echo "$f"
  done
  return 0
}
deps_of() { sed -n 's/^Depends on:[[:space:]]*//Ip' "$1" | head -1 | grep -oE '\b[0-9]+[a-z]*\b' || true; }
unmet_deps() {  # unmet_deps <task file> : its dependencies that are not done (or dropped) in main
  local d f s p
  p=$(claim_key "$1")
  for d in $(deps_of "$1"); do
    # A subtask's dependency on its own parent is void: the parent (split) waits for its subtasks, so the two would
    # wait for each other (frontpage 2026-10-03: 221a "Depends on: 221" left both agents idle).
    [ "$(task_id "$1")" != "$p" ] && [[ $d =~ ^[0-9]+$ ]] && [ "$((10#$d))" = "$((10#$p))" ] && continue
    [[ $d =~ ^[0-9]+$ ]] && d=$(printf %03d "$((10#$d))")
    f=$(compgen -G "$TEAM_DIR/tasks/$d-*.md" | head -1)
    if [ -z "$f" ]; then echo "$d"; continue; fi
    s=$(status_of "$f"); [ "$s" = done ] || [ "$s" = dropped ] || echo "$d"
  done
  return 0
}
touches_of() {  # the task's Touches: paths, normalised (no ./, no trailing / or globs); words that are not paths dropped
  sed -n 's/^Touches:[[:space:]]*//Ip' "$1" | head -1 | tr -d '`' | tr ',;' '  ' | tr -s ' ' '\n' \
    | grep -E '^(\.|\*|[A-Za-z0-9_@.*/-]*[./][A-Za-z0-9_@.*/-]*)$' | sed -E 's#^\./##; s#/?\*+$##; s#/+$##; s#^$#.#' || true
}
overlap() {  # overlap <task A> <task B> : a Touches path of one equals or contains one of the other's
  local x y
  for x in $(touches_of "$1"); do for y in $(touches_of "$2"); do
    { [ "$x" = . ] || [ "$y" = . ] || [ "$x" = "$y" ] || [[ $x == "$y"/* ]] || [[ $y == "$x"/* ]]; } && return 0
  done; done
  return 1
}
team_why_not() {  # team_why_not <task file> : why another agent's presence keeps this task from this agent (empty = free)
  local k o t u
  k=$(claim_key "$1"); o=$(claim_owner "$k")
  if [ -n "$o" ] && [ "$o" != "$AGENT_ID" ]; then echo "held by agent $o"; return 0; fi
  # The goal check grades the finished project: frontpage 2026-10-03, a 999 left open from an earlier round was taken
  # (Depends on: none) while three tasks were still being built, and ran six sessions checking unfinished work.
  case $1 in tasks/999-*) t=$(open_in_main); [ -n "$t" ] && { echo "the goal check waits until every other task is finished ($t)"; return 0; } ;; esac
  if [ -f "$TEAM/handed/$k" ] && [ "$(cut -d' ' -f1 "$TEAM/handed/$k")" = "$AGENT_ID" ]; then echo "handed over to a bigger agent"; return 0; fi
  # Own work too waits for its declared dependencies: frontpage 2026-10-03, an agent spent 8 sessions on a subtask
  # that needed another agent's unfinished task (it builds stand-ins instead of the feature). Claim is kept.
  u=$(unmet_deps "$1"); [ -n "$u" ] && { echo "waits for $(echo $u | tr ' ' ,)"; return 0; }
  [ -n "$o" ] && return 0   # own claim: subtasks and continuing work, no other checks
  u=$(done_in_main "$1"); [ -n "$u" ] && { echo "already $u in main"; return 0; }
  # An agent with a smaller context window (TEAM_MAX_TOUCHES in its env file) leaves big tasks to the others: on
  # frontpage the 114k agent spent whole sessions reading a 14-file task and ran out of window before writing anything.
  if [ -n "${TEAM_MAX_TOUCHES:-}" ]; then
    u=$(touches_of "$1" | grep -c .)
    [ "$u" -gt "$TEAM_MAX_TOUCHES" ] && { echo "too big for this agent's window ($u files > $TEAM_MAX_TOUCHES)"; return 0; }
  fi
  for t in $(others_tasks); do overlap "$1" "$t" && { echo "touches the same files as $(task_id "$t")"; return 0; }; done
  return 0
}
team_workable() { [ -z "$(team_why_not "$1")" ]; }
team_idle_reason() {  # one line: why nothing is workable for this agent
  local f s r out=""
  for f in tasks/[0-9]*.md; do
    [ -f "$f" ] || continue; s=$(status_of "$f")
    case $s in done|dropped) continue ;; esac
    r=$(team_why_not "$f"); [ -z "$r" ] && r=$s
    out+="$(task_id "$f") $r; "
  done
  printf '%s' "${out:-no open tasks}" | cut -c1-400
}
live_agents() {  # ids of agents whose loops run, this one included
  local f
  for f in "$TEAM"/loops/*.pid; do [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && basename "$f" .pid; done
  return 0
}
team_lead() { [ "$(live_agents | sort | head -1)" = "$AGENT_ID" ]; }   # the first live agent runs goal checks
others_hold_claims() { local o a; for o in "$TEAM"/claims/*/owner; do [ -f "$o" ] || continue; a=$(claim_owner "$(basename "$(dirname "$o")")"); [ -n "$a" ] && [ "$a" != "$AGENT_ID" ] && return 0; done; return 1; }
any_claims() { local o; for o in "$TEAM"/claims/*/owner; do [ -f "$o" ] && [ -n "$(claim_owner "$(basename "$(dirname "$o")")")" ] && return 0; done; return 1; }
task_range() {  # task_range : the numbers this agent gives the top-level tasks it creates (a: 200-499, b: 500-799, ...)
  local i; i=$(( $(printf %d "'$AGENT_ID") - 97 )); echo "${TASK_RANGE:-$(( 200 + 300 * i ))-$(( 499 + 300 * i ))}"
}

# Sync: the latest main into this agent's branch before every pick (and during waits). A conflict is left to the next
# session (SYNC_CONFLICT goes into its prompt); the branch stays as it was.
SYNC_CONFLICT=""
team_sync() {
  commit_leftovers "uncommitted work before syncing with main"
  git merge-base --is-ancestor main HEAD && { SYNC_CONFLICT=""; return 0; }
  if git merge --no-ff --no-edit -m "[driver] sync: merge main into $BRANCH" main > /dev/null 2>&1; then
    SYNC_CONFLICT=""; log "team: merged the latest main into $BRANCH"; return 0
  fi
  SYNC_CONFLICT=$(git diff --name-only --diff-filter=U | tr '\n' ' ' | sed 's/ $//')
  git merge --abort 2>/dev/null
  log "team: main conflicts with $BRANCH in: $SYNC_CONFLICT - the next session resolves it"; tev sync_conflict "" "$SYNC_CONFLICT"
  return 1
}
# Accepted: bring the branch into main. Under the team's merge lock: merge main into the branch, re-run the tests if
# main brought anything, then fast-forward main. A conflict or a new test failure reopens the task with the reason.
team_merge() {  # team_merge <task file>
  local f=$1 files cur new base d
  exec 8> "$TEAM/merge.lock"; flock 8
  commit_leftovers "before merging $(task_id "$f") into main"
  if ! git merge-base --is-ancestor main HEAD; then
    if ! git merge --no-ff --no-edit -m "[driver] merge main into $BRANCH before merging $(task_id "$f")" main > /dev/null 2>&1; then
      files=$(git diff --name-only --diff-filter=U | tr '\n' ' ' | sed 's/ $//'); git merge --abort 2>/dev/null; flock -u 8
      tev merge_conflict "$f" "$files"; log "team: $f accepted but conflicts with main in: $files - reopened"
      VERIFY=rejected
      reopen "$f" "- Accepted, but it cannot go into main yet: your branch conflicts with main (the other agent's finished work) in: $files"$'\n'"    Run \`git merge main\`, resolve each conflict keeping both sides' intent, run the tests, commit, then set the task done again."$'\n'
      return 1
    fi
    if ! run_tests; then
      cur=$(failing_set "$TEST_OUT"); base=.agent/baselines/$(task_id "$f").txt; [ -f "$base" ] || base=$BASELINE
      new=$(comm -13 <(sort -u "$base" 2>/dev/null) <(echo "$cur" | sed '/^$/d'))
      if [ -n "$new" ] || [ -z "$cur" ]; then
        flock -u 8; tev post_merge_fail "$f" "$(echo $new | cut -c1-200)"; log "team: tests fail after merging main into $BRANCH - $f reopened"
        VERIFY=rejected
        reopen "$f" "- Accepted on its own, but after merging main (the other agent's finished work) these tests fail:"$'\n'"${TEST_REPORT:-$(sed 's/^/    /' <<<"$new")}"$'\n'"    Fix the combination (your branch now contains main), then set the task done again."$'\n'
        return 1
      fi
    fi
  fi
  if git -C "$TEAM_DIR" merge --ff-only -q "$BRANCH" > /dev/null 2>&1; then
    rm -f .agent/merge-pending
    tev merge "$f" "$(git rev-parse --short HEAD)"; log "team: $f merged into main ($(git rev-parse --short HEAD))"
    d=$(ls "$TEAM_DIR"/tasks/[0-9]*.md 2>/dev/null | xargs -n1 basename | cut -d- -f1 | sort | uniq -d | tr '\n' ' ')
    [ -n "$d" ] && { tev dup_task_id "" "$d"; log "WARNING team: duplicate task numbers in main: $d"; }
  else
    touch .agent/merge-pending
    tev merge_failed "$f" "main refused a fast-forward (uncommitted changes in $TEAM_DIR?)"
    log "WARNING team: main ($TEAM_DIR) refused the fast-forward of $BRANCH - retried before the next session"
  fi
  flock -u 8
  return 0
}
team_retry_merge() {  # a fast-forward that main refused earlier, retried before the next pick
  [ -f .agent/merge-pending ] || return 0
  exec 8> "$TEAM/merge.lock"; flock 8
  if git merge-base --is-ancestor main HEAD && git -C "$TEAM_DIR" merge --ff-only -q "$BRANCH" > /dev/null 2>&1; then
    rm -f .agent/merge-pending; tev merge "" "retry $(git rev-parse --short HEAD)"; log "team: pending merge into main done"
  fi
  flock -u 8
}
# Nothing workable. Wait while another agent holds work (main changes when it finishes); when nobody holds anything,
# the lead agent runs the goal check (or breaks a dependency deadlock), and the others wait for it or for STOP.
# Prints: wait | goal | stop | force <task file>
team_idle_decision() {
  local f
  [ -f "$TEAM/STOP" ] && { echo stop; return; }
  others_hold_claims && { echo wait; return; }   # only this agent's own claims, none workable: nobody frees them, so force
  team_lead || { echo wait; return; }
  f=$(TEAM_IGNORE=1 next_task)   # open work nobody holds and nobody can start: its dependencies cannot be met
  [ -n "$f" ] && { echo "force $f"; return; }
  echo goal
}
TEAM_WAIT_T0="" TEAM_WAIT_REASON=""
team_wait() {  # one wait step (60 s) while another agent works
  team_beat
  local r; r=$(team_idle_reason)
  if [ -z "$TEAM_WAIT_T0" ]; then
    TEAM_WAIT_T0=$(date +%s); TEAM_WAIT_REASON=$r
    log "team: nothing to take now - waiting for the other agent(s): $r"; tev wait_start "" "$r"
  elif [ "$r" != "$TEAM_WAIT_REASON" ]; then   # e.g. "no open tasks" during planning, then "waits for 203": the watcher needs to see that
    TEAM_WAIT_REASON=$r; log "team: still waiting, now because: $r"; tev wait_reason "" "$r"
  fi
  [ -f .agent/PAUSE ] && { log "PAUSE file found while waiting - stopping"; exit 0; }
  sleep "${TEAM_WAIT_S:-60}"
  team_sync || true
}
team_wait_done() {  # a task was picked after a wait: record how long this agent was held up
  [ -n "$TEAM_WAIT_T0" ] || return 0
  local s=$(( $(date +%s) - TEAM_WAIT_T0 )); TEAM_WAIT_T0="" TEAM_WAIT_REASON=""
  log "team: waited $((s / 60)) min for the other agent(s)"; tev wait_end "${1:-}" "$s"
}
# A task too big for another running agent (over its TEAM_MAX_TOUCHES) can only ever go to the bigger agents, and a
# claim covers a task's subtasks too: frontpage 2026-10-03, a re-plan put a 19-file task first in the chain and the
# 8-file agent sat idle. So the agent that takes such a task first splits it into new top-level tasks the small agent
# can take, and the task itself waits for them (its own Depends on). `Split: no - <reason>` in the task opts out.
smallest_other_limit() {  # the smallest TEAM_MAX_TOUCHES among the other running agents (their env files), or empty
  local id v m=""
  for id in $(live_agents); do
    [ "$id" = "$AGENT_ID" ] && continue
    v=$(sed -n 's/^TEAM_MAX_TOUCHES=//p' "$HOME/.agent-kit/agents/$id.env" 2>/dev/null | tail -1)
    [[ $v =~ ^[0-9]+$ ]] || continue
    if [ -z "$m" ] || [ "$v" -lt "$m" ]; then m=$v; fi
  done
  echo "$m"
}
team_split_note() {  # team_split_note <task file> : the split instruction for a task too big for another agent, or nothing
  local lim n
  case $(task_id "$1") in 000|999) return 0 ;; esac
  grep -qiE '^Split:[[:space:]]*no' "$1" && return 0
  lim=$(smallest_other_limit); [ -n "$lim" ] || return 0
  n=$(touches_of "$1" | grep -c .); [ "$n" -gt "$lim" ] || return 0
  printf '%s' " SPLIT THIS TASK FIRST: it changes $n files, and another agent can only take tasks of at most $lim files, so as one task it waits for you alone. Split what is not built yet into new top-level tasks (the lowest free numbers in $(task_range)) of at most $lim files each, every one with a Goal, testable Acceptance criteria, a \`Depends on:\` line and a \`Touches:\` line, so that parts which do not need each other can be built at the same time. Either this task keeps what is already built and what the parts need first (the parts then depend on this task), or, when nothing is built yet, it waits for the parts (add their numbers to its \`Depends on:\` line). Move the acceptance boxes the parts deliver into the parts, and cut this task's \`Touches:\` line down to the files it still changes itself. Where another open task depends on this one and needs a part, add that part's number to its \`Depends on:\` line too. Commit and end the session: the driver puts these task files into main at once, so the other agent can take the parts. Only if the work truly cannot be divided: add the line \`Split: no - <reason>\` under this task's \`Touches:\` line and carry on."
}
team_publish_split() {  # team_publish_split <task file> <commit before the session> : after a session told to split
  # its task, the task files it wrote or changed go into main at once (the parts, this task, Depends on lines added to
  # others), so the other agents can take the parts now; code still reaches main only with an accepted task. A task
  # another agent holds, or one main changed meanwhile, is left to the normal merge.
  local f o files=""
  for f in $(git diff --name-only "$2" HEAD -- 'tasks/[0-9]*.md'); do
    [ -f "$f" ] || continue
    o=$(claim_owner "$(claim_key "$f")")
    if [ -z "$o" ]; then   # an unclaimed task: only if main still has the version this session started from
      [ "$(git rev-parse -q --verify "main:$f" 2>/dev/null)" = "$(git rev-parse -q --verify "$2:$f" 2>/dev/null)" ] || continue
    elif [ "$o" != "$AGENT_ID" ]; then continue; fi   # this agent's own tasks: nobody else edits them
    files+=" $f"
  done
  [ -n "$files" ] || { log "team: $1 was to be split, but no task file changed - nothing published"; return 0; }
  exec 8> "$TEAM/merge.lock"; flock 8
  # shellcheck disable=SC2086
  if git -C "$TEAM_DIR" checkout "$BRANCH" -- $files && git -C "$TEAM_DIR" commit -q -m "[driver] $(task_id "$1") split by agent $AGENT_ID: task files published to main ($(for f in $files; do task_id "$f"; done | tr '\n' ' ' | sed 's/ $//'))" -- $files; then
    tev split_published "$1" "$files"; log "team: $1 split - task files published to main:$files"
  else
    git -C "$TEAM_DIR" reset -q -- $files 2>/dev/null; git -C "$TEAM_DIR" checkout -q main -- $files 2>/dev/null
    tev split_publish_failed "$1" "$files"; log "WARNING team: could not publish the split of $1 to main"
  fi
  flock -u 8
  return 0
}
open_in_main() {  # task ids in main, besides 000 and 999, that are not done or dropped
  local f
  for f in "$TEAM_DIR"/tasks/[0-9]*.md; do
    [ -f "$f" ] || continue
    case $(basename "$f") in 000-*|999-*) continue ;; esac
    case $(status_of "$f") in done|dropped) ;; *) task_id "$f" ;; esac
  done | tr '\n' ' ' | sed 's/ $//'
}
# A task the smaller agent cannot get through goes to a bigger agent that is waiting for work: frontpage 2026-10-03,
# agent b (114k window, about a quarter of a's speed) spent 10 sessions on 220 without ticking a box, the last four
# cut off at the window's edge, while agent a waited for it (the same had happened with 205 and 215). After
# TEAM_HANDOVER_SESSIONS (3) sessions in a row without a newly ticked box, while a bigger agent waits, this agent gives
# the task up: its branch is kept as a backup branch and reset to main (the half-done work must not ride into main with
# its next task), the claim is released, and $TEAM/handed/<key> keeps it from taking the task again.
agent_limit() { sed -n 's/^TEAM_MAX_TOUCHES=//p' "$HOME/.agent-kit/agents/$1.env" 2>/dev/null | tail -1; }
waiting_bigger_agent() {  # a running agent with a bigger window than this one (no limit, or a higher one) that waits now
  local id l e mine=${TEAM_MAX_TOUCHES:-}
  [ -n "$mine" ] || return 0
  for id in $(live_agents); do
    [ "$id" = "$AGENT_ID" ] && continue
    l=$(agent_limit "$id"); { [ -z "$l" ] || [ "$l" -gt "$mine" ]; } || continue
    e=$(tail -n 3000 "$TEAM/events.jsonl" 2>/dev/null | jq -r --arg a "$id" \
        'select(.agent == $a and (.event | test("^(wait_start|wait_reason|wait_end|claim)$"))) | .event' 2>/dev/null | tail -1)
    case $e in wait_start|wait_reason) echo "$id"; return 0 ;; esac
  done
  return 0
}
team_handover_finish() {  # back up this agent's branch and take the handed task's work off it, for a task marked handed over by it
  local m k a s b
  for m in "$TEAM"/handed/*; do
    [ -f "$m" ] || continue
    read -r a _ s _ < "$m"; [ "$a" = "$AGENT_ID" ] && [ "$s" = pending ] || continue
    k=$(basename "$m"); b="$BRANCH-handover-$k-$(date +%Y%m%d-%H%M)"
    commit_leftovers "before handing $k over"
    if [ "$(git rev-list --count main..HEAD)" -gt 0 ]; then
      git branch "$b" HEAD || { log "WARNING team: could not back up $BRANCH before handing $k over"; continue; }
      # With other claims still held, only this task's files go back to main's; their work stays (frontpage
      # 2026-10-06: handing 243 over reset agent/b to main, and its session on 253, which it still held, was lost
      # and done again). With none, the whole branch is reset as before.
      if [ -n "$(own_claims)" ] && team_put_back "$k" "handed over to a bigger agent"; then
        log "team: $k handed over - this branch's work on it is kept on $b, and its files on $BRANCH are put back as main has them"
      else
        git reset -q --hard main || { log "WARNING team: could not reset $BRANCH after handing $k over"; continue; }
        log "team: $k handed over - this branch's work on it is kept on $b, and $BRANCH is reset to main"
      fi
    else b=none; fi
    echo "$AGENT_ID $(date +%s) kept $b" > "$m"; tev handover_reset "" "$k backup $b"
  done
  return 0
}
team_handover_check() {  # team_handover_check <task file> <boxes ticked when the session started> : after each session
  local k f n to; k=$(claim_key "$1"); f=.agent/progress-$k
  case $k in 000|999) return 0 ;; esac
  mkdir -p .agent
  n=$(grep -cE '^[[:space:]]*- \[x\]' "$1" 2>/dev/null || true); n=${n:-0}
  [ "$n" -gt "${2:-0}" ] && echo 1 >> "$f" || echo 0 >> "$f"   # 1 = this session ticked a box
  [ "$(tail -n "${TEAM_HANDOVER_SESSIONS:-3}" "$f" | grep -c '^0$')" -ge "${TEAM_HANDOVER_SESSIONS:-3}" ] || return 0
  to=$(waiting_bigger_agent); [ -n "$to" ] || return 0
  mkdir -p "$TEAM/handed"; echo "$AGENT_ID $(date +%s) pending" > "$TEAM/handed/$k"
  release_claim "$1"; rm -f "$f"
  tev handover "$1" "to agent $to: ${TEAM_HANDOVER_SESSIONS:-3} sessions without a newly ticked box"
  log "team: $1 handed over to agent $to (${TEAM_HANDOVER_SESSIONS:-3} sessions in a row without a newly ticked box, and agent $to is waiting)"
  team_handover_finish
}
team_prompt() {  # the team part of the session prompt
  local t a txt
  txt=" TEAM MODE: you are agent $AGENT_ID; other agents build other tasks of this project at the same time, each in its own checkout and git branch. The driver merges every accepted task into \`main\` and merges \`main\` into your branch before each session. Rules: change only the files your task's \`Touches:\` line names (add a path there first if your task really needs another); do not edit other tasks' files, except to add new tasks; new top-level tasks you create take the lowest free number in $(task_range) and need a \`Depends on:\` line and a \`Touches:\` line, one module per task, so the agents can work in parallel; tests must not bind fixed network ports or write outside the project and the temp dir (the other checkouts run their tests at the same time); never run git merge, rebase, reset, stash or switch branches unless this prompt asks you to resolve a merge. If your task cannot be finished before another task is done, do not build stand-ins for it: add that task's number to your task's \`Depends on:\` line, commit, and end the session; the driver gives you other work and brings this task back once that one is merged."
  for t in $(others_tasks); do
    a=$(grep -l -- "$t" "$TEAM"/claims/*/owner 2>/dev/null | head -1 | xargs -r cat | cut -d' ' -f1)
    txt+=" Agent ${a:-?} is working on $(task_id "$t") ($(sed -n 's/^# //p' "$t" | head -1 | cut -c1-80)), touching: $(touches_of "$t" | tr '\n' ' ' | sed 's/ $//')."
  done
  [ -n "$SYNC_CONFLICT" ] && txt+=" FIRST, before your task step: merging the latest \`main\` into your branch conflicts in: $SYNC_CONFLICT. Run \`git merge main\`, resolve every conflict keeping both sides' intent (main holds the other agents' finished work), run the tests, and commit the merge."
  printf '%s' "$txt"
}
# Who takes what: the critical path first. A task's rank is the longest chain of open tasks that waits on it, itself
# included; agents take the highest rank first, so long chains start early. A slower agent (TEAM_SPEED in the env
# files, relative, default 1) takes the lowest rank first while a faster agent runs: tasks nothing waits on, so the fast
# agents never wait for it. (frontpage 2026-10-04: lowest number first would have handed agent b, a quarter of a's
# speed, the module split six tasks wait on, and a would have waited for b; replayed, a idles 5 of 15 task lengths
# instead of 3 of 13.) With two fast cards and one slow one, both fast agents take the long chains.
agent_speed() {  # agent_speed <id>
  local v=""
  [ "$1" = "$AGENT_ID" ] && v=${TEAM_SPEED:-}
  [ -n "$v" ] || v=$(sed -n 's/^TEAM_SPEED=//p' "$HOME/.agent-kit/agents/$1.env" 2>/dev/null | tail -1)
  [[ $v =~ ^[0-9]+([.][0-9]+)?$ ]] && echo "$v" || echo 1
}
team_is_slow() {  # a faster agent's loop runs
  local id me; me=$(agent_speed "$AGENT_ID")
  for id in $(live_agents); do
    [ "$id" = "$AGENT_ID" ] && continue
    awk -v o="$(agent_speed "$id")" -v m="$me" 'BEGIN { exit !(o > m) }' && return 0
  done
  return 1
}
team_ranks() {  # "<id> <rank>" for each open task of this checkout (000 and 999 aside)
  local f
  for f in tasks/[0-9]*.md; do
    [ -f "$f" ] || continue
    case $f in tasks/000-*|tasks/999-*) continue ;; esac
    case $(status_of "$f") in done|dropped) continue ;; esac
    printf '%s\t%s\n' "$(task_id "$f")" "$(deps_of "$f" | tr '\n' ' ')"
  done | plan-schedule --ranks 2>/dev/null
}
rank_of() { awk -v t="$1" '$1 == t { print $2; f = 1 } END { if (!f) print 0 }' <<<"$2"; }   # rank_of <id> <team_ranks>
claim_rank() { awk -v k="$1" '{ id = $1; sub(/[a-z]+$/, "", id) } id == k && $2 > m { m = $2 } END { print m + 0 }' <<<"$2"; }   # claim_rank <key> <team_ranks> : its tasks' highest rank
own_claims() { local o; for o in "$TEAM"/claims/*/owner; do [ -f "$o" ] && [ "$(cut -d' ' -f1 "$o")" = "$AGENT_ID" ] && basename "$(dirname "$o")"; done; return 0; }
team_pick_order() {  # the task files in the order this agent takes them: the planning task; then its own claims, the
  # highest rank first, slow agent or not: finishing what it holds comes first (frontpage 2026-10-06: agent b held 253,
  # which five tasks waited on, and 243b, which nothing did; its lowest-rank-first order took 243b and parked 253 for
  # 39 minutes while agent a waited); then the rest by rank (a slower agent the lowest first, see above)
  local f k ranks slow="" own
  ranks=$(team_ranks); team_is_slow && slow=1
  own=" $(own_claims | tr '\n' ' ')"
  compgen -G 'tasks/000-*.md' || true
  for f in tasks/[0-9]*.md; do
    [ -f "$f" ] || continue
    case $f in tasks/000-*) continue ;; esac
    k=$(claim_key "$f")
    if [[ $own == *" $k "* ]]; then printf '0 -%s -%s %s\n' "$(claim_rank "$k" "$ranks")" "$(rank_of "$(task_id "$f")" "$ranks")" "$f"
    elif [ -n "$slow" ]; then printf '1 %s 0 %s\n' "$(rank_of "$(task_id "$f")" "$ranks")" "$f"
    else printf '1 -%s 0 %s\n' "$(rank_of "$(task_id "$f")" "$ranks")" "$f"; fi
  done | sort -k1,1n -k2,2n -k3,3n -k4,4 | cut -d' ' -f4
}

# Takeover: an idle faster agent takes over a task a slower agent holds when other tasks wait on it. frontpage
# 2026-10-06: agent a merged 252 and went back to its own 244; 14 s later agent b (a quarter of a's speed) took 253, the
# only task free for it, which five tasks waited on. At 14:37 a had nothing left (b held 253 and 243), b's next session
# went to 243b, and a waited 47 minutes. The 3-session hand-over is for an agent that is stuck, not one that is slow,
# and prep moves notes, never a claim. So:
#   - asking: an agent with nothing to build, before it prepares anything (real work beats notes), asks for the claim
#     of a slower running agent that other open tasks wait on (rank 2+) and that it could build now itself
#     (dependencies done in main, its own size limit, no file overlap with any other claim, no open request to the
#     human about it); the highest rank first (team-takeover pick). $TEAM/takeover/<key>/asker = "<asker> <loop pid>
#     <epoch> <asker's checkout>". Then it waits: the answer takes seconds, or one hand-over of the holder's session.
#   - answering: only the holder's loop changes its claim. Between sessions it gives the claim at once; during a session
#     on that task, wrapup's driver signal (.agent/handover-now) makes the session write its hand-over and end, and the
#     claim goes after it; during a session on another task (the claim is parked), its watcher gives it at once.
#   - giving: the claim's owner becomes the asker. $TEAM/carry/<key> = "<holder> <commit>" and the task's paths
#     (team-takeover paths): the asker applies that work to its branch before its next session, whose prompt says so.
#     The holder's branch gets those paths back as main has them (its other claims' work stays): at once between
#     sessions, else right after the session, before anything of that branch is verified or merged.
agent_running() { local f=$TEAM/loops/$1.pid; [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null; }
team_has_slower() {  # another running agent is slower than this one (only then can this one take anything over)
  local id me; me=$(agent_speed "$AGENT_ID")
  for id in $(live_agents); do
    [ "$id" = "$AGENT_ID" ] && continue
    awk -v o="$(agent_speed "$id")" -v m="$me" 'BEGIN { exit !(o < m) }' && return 0
  done
  return 1
}
team_takeover_why_not() {  # team_takeover_why_not <holder's checkout> <key> : why this agent could not build that claim now (empty: it could)
  local hw=$1 k=$2 top s t q pending="" startable=""
  top=$(compgen -G "$hw/tasks/$k-*.md" | head -1); [ -n "$top" ] || { echo "no task file"; return 0; }
  s=$(status_of "$top"); case $s in done|dropped|blocked) echo "$s"; return 0 ;; esac
  for q in "$hw"/.agent/asks/[0-9]*.md; do   # a request to the human about it is open in the holder's checkout
    [ -f "$q" ] && grep -qx 'status: open' "$q" || continue
    t=$(sed -n 's/^task: //p' "$q" | head -1); [ -n "$t" ] && [ "$(claim_key "$t")" = "$k" ] && { echo "waits for the human"; return 0; }
  done
  t=$(unmet_deps "$top"); [ -n "$t" ] && { echo "waits for $(echo $t | tr ' ' ,)"; return 0; }
  for t in "$hw"/tasks/$k[a-z]*-*.md; do   # split: an unfinished subtask must be able to start
    [ -f "$t" ] || continue
    case $(status_of "$t") in done|dropped) continue ;; open|in-progress) [ -z "$(unmet_deps "$t")" ] && startable=1 ;; esac
    pending=1
  done
  [ -n "$pending" ] && [ -z "$startable" ] && { echo "no subtask can start"; return 0; }
  if [ -n "${TEAM_MAX_TOUCHES:-}" ]; then
    t=$(touches_of "$top" | grep -c .); [ "$t" -gt "$TEAM_MAX_TOUCHES" ] && { echo "too big for this agent ($t files > $TEAM_MAX_TOUCHES)"; return 0; }
  fi
  for t in $(others_tasks); do
    [ "$(claim_key "$t")" = "$k" ] && continue
    overlap "$top" "$t" && { echo "touches the same files as $(task_id "$t")"; return 0; }
  done
  return 0
}
team_takeover_facts() {  # team-takeover pick's input: one line per claim another running agent holds
  local o a f k ranks me
  ranks=$(team_ranks); me=$(agent_speed "$AGENT_ID")
  for o in "$TEAM"/claims/*/owner; do
    [ -f "$o" ] || continue
    read -r a _ _ f < "$o"; k=$(basename "$(dirname "$o")")
    case $k in 000|999) continue ;; esac
    [ -n "$a" ] && [ "$a" != "$AGENT_ID" ] && agent_running "$a" || continue
    [ -d "$TEAM/takeover/$k" ] && continue   # another agent asked for it already
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$k" "$a" "$(agent_speed "$a")" "$me" "$(claim_rank "$k" "$ranks")" "$(team_takeover_why_not "${f%/tasks/*}" "$k")"
  done
}
team_takeover_candidate() {  # the claim this agent would ask for now, or nothing
  [ "${TEAM_TAKEOVER:-1}" = 1 ] && team_has_slower || return 0
  team_takeover_facts | team-takeover pick 2>/dev/null
}
team_takeover_ask() {  # team_takeover_ask : an agent with nothing to build asks for a slower agent's claim; true while its request is open
  [ "${TEAM_TAKEOVER:-1}" = 1 ] || return 1
  local d a k o top why
  for d in "$TEAM"/takeover/*/; do   # its earlier request: open while the holder still holds the claim
    [ -f "$d/asker" ] || continue; read -r a _ < "$d/asker"; [ "$a" = "$AGENT_ID" ] || continue
    k=$(basename "$d"); o=$(claim_owner "$k")
    [ -n "$o" ] && [ "$o" != "$AGENT_ID" ] && agent_running "$o" && return 0
    rm -rf "$d"   # given to this agent, finished, released, or its holder stopped
  done
  team_has_slower || return 1
  why=$(mktemp); k=$(team_takeover_facts | team-takeover pick 2> "$why"); why=$(cat "$why"; rm -f "$why")
  [ -n "$k" ] || return 1
  mkdir -p "$TEAM/takeover"; mkdir "$TEAM/takeover/$k" 2>/dev/null || return 1
  echo "$AGENT_ID $$ $(date +%s) $PWD" > "$TEAM/takeover/$k/asker"   # the loop runs in its checkout
  read -r o _ _ top <<<"$(owner_line "$k")"
  tev takeover_asked "$top" "from agent $o: $(grep "^$k " <<<"$why" | head -1)"
  log "team: nothing to build - asked agent $o for $k (a slower agent; other tasks wait on it)"
  return 0
}
team_put_back() {  # team_put_back <key> <why> [paths] : that task's files on this branch become main's again; its other work stays
  local k=$1 p co="" rm="" paths
  if [ $# -ge 3 ]; then paths=$3
  else paths=$(team-takeover paths "$k" main HEAD .agent/iterations.jsonl 2>/dev/null) || return 1; fi   # failed: nothing changed
  for p in $paths; do
    if git cat-file -e "main:$p" 2>/dev/null; then co+=" $p"; else rm+=" $p"; fi
  done
  # shellcheck disable=SC2086
  [ -z "$co" ] || git checkout -q main -- $co || log "WARNING team: could not put back $k's files: $co"
  # shellcheck disable=SC2086
  [ -z "$rm" ] || git rm -q -r --ignore-unmatch -- $rm > /dev/null || log "WARNING team: could not remove $k's new files: $rm"
  git diff --cached --quiet || git commit -q -m "[driver] $k $2: its files on this branch put back as main has them"
}
team_takeover_give() {  # team_takeover_give <key> now|later : the holder gives its claim to the agent that asked for it
  local k=$1 d=$TEAM/takeover/$1 a ap aw top sha paths err
  read -r a ap _ aw < "$d/asker" || return 0
  if ! kill -0 "$ap" 2>/dev/null; then rm -rf "$d"; tev takeover_dropped "" "$k: agent $a's loop is gone"; return 0; fi
  [ "$2" = now ] && commit_leftovers "before giving $k to agent $a"
  sha=$(git rev-parse HEAD); err=$(mktemp)
  # without the task's paths its work would stay on this branch and reach main: then the claim stays here
  if ! paths=$(team-takeover paths "$k" main "$sha" .agent/iterations.jsonl 2> "$err"); then
    log "WARNING team: team-takeover paths failed for $k ($(head -c 200 "$err")) - not giving it to agent $a"; rm -f "$err"; return 0
  fi
  paths=$(echo $paths)
  top=$(compgen -G "tasks/$k-*.md" | head -1); [ -n "$top" ] || top=tasks/$(basename "$(owner_line "$k" | cut -d' ' -f4)")
  # In this order, so a watcher stopped half-way (the session ended) leaves nothing wrong: the work for the asker, this
  # branch's put-back (settle skips it while the claim is still this agent's), then the claim, then the request.
  mkdir -p "$TEAM/carry"
  printf '%s %s\n%s\n' "$AGENT_ID" "$sha" "$paths" > "$TEAM/carry/.$k.$$" && mv "$TEAM/carry/.$k.$$" "$TEAM/carry/$k"
  echo "$a $paths" > ".agent/put-back-$k"
  echo "$a $ap $(date +%s) $aw/$top" > "$TEAM/claims/$k/.owner.$$" && mv "$TEAM/claims/$k/.owner.$$" "$TEAM/claims/$k/owner"
  rm -rf "$d"; rm -f ".agent/progress-$k"
  [ "$2" = now ] && team_takeover_settle
  tev takeover "$top" "to agent $a: $(wc -w <<<"$paths") file(s) of its work go with it ($(git rev-parse --short "$sha"))$(sed 's/^/; /' "$err" | tr -d '\n' | cut -c1-200)"
  log "team: gave $k to agent $a (a faster agent with nothing to build; other tasks wait on it) - $(wc -w <<<"$paths") file(s) of its work go with it"
  rm -f "$err"
}
team_takeover_settle() {  # put back the files of claims given away during a session (before anything is verified or merged)
  local f k a paths
  for f in .agent/put-back-*; do
    [ -f "$f" ] || continue
    k=${f#.agent/put-back-}; read -r a paths < "$f"
    [ "$(claim_owner "$k")" = "$AGENT_ID" ] || team_put_back "$k" "taken over by agent $a" "$paths"   # still its own: the give never finished
    rm -f "$f"
  done
  return 0
}
team_takeover_answer() {  # the holder, between sessions: gives every claim of its that was asked for
  local d k
  for d in "$TEAM"/takeover/*/; do
    [ -f "$d/asker" ] || continue; k=$(basename "$d")
    [ "$(claim_owner "$k")" = "$AGENT_ID" ] && team_takeover_give "$k" now
  done
  return 0
}
team_takeover_receive() {  # the work of a claim given to this agent, onto its branch
  local c k h sha paths base p
  for c in "$TEAM"/carry/*; do
    [ -f "$c" ] || continue; k=$(basename "$c")
    read -r h sha < "$c"
    [ "$h" != "$AGENT_ID" ] && [ "$(claim_owner "$k")" = "$AGENT_ID" ] || continue
    paths=$(sed -n 2p "$c"); team_sync || true
    if [ -n "$paths" ]; then
      base=$(git merge-base main "$sha")
      # shellcheck disable=SC2086
      if git diff --binary "$base" "$sha" -- $paths | git apply --index --check 2>/dev/null; then
        git diff --binary "$base" "$sha" -- $paths | git apply --index
      else   # main changed those files since: the holder's version wins (no other agent could hold them)
        for p in $paths; do
          if git cat-file -e "$sha:$p" 2>/dev/null; then git checkout -q "$sha" -- "$p"; else git rm -q -r --ignore-unmatch -- "$p" > /dev/null; fi
        done
        tev takeover_carry_overwrite "" "$k: $paths"; log "team: $k's work did not apply cleanly on main - took agent $h's version of its files"
      fi
      git diff --cached --quiet || git commit -q -m "[driver] $k taken over from agent $h: its work carried ($h@$(git rev-parse --short "$sha"))"
    fi
    echo "$h $(git rev-parse --short "$sha")" > ".agent/taken-over-$k"
    rm -f "$c"; tev takeover_carried "" "$k from agent $h: $(wc -w <<<"$paths") file(s)"
    log "team: took over $k from agent $h - $(wc -w <<<"$paths") file(s) of its work carried into $BRANCH"
  done
  return 0
}
team_forward_answers() {  # answered requests about a task another agent now holds: to that agent's inbox, closed here
  # (frontpage 2026-10-06: the human answered b's request 001 about 253 at 18:41, a took 253 over at 18:42, and the
  # answer stayed in b's checkout, where no session would ever read it)
  local q t k o f w ms
  for q in .agent/asks/[0-9]*.md; do
    [ -f "$q" ] && grep -qx 'status: answered' "$q" || continue
    t=$(sed -n 's/^task: //p' "$q" | head -1); [ -n "$t" ] || continue
    k=$(claim_key "$t"); o=$(claim_owner "$k"); [ -n "$o" ] && [ "$o" != "$AGENT_ID" ] || continue
    read -r _ _ _ f <<<"$(owner_line "$k")"; w=${f%/tasks/*}; [ -d "$w" ] || continue
    mkdir -p "$w/.agent/inbox"; ms=$(( $(date +%s%N) / 1000000 ))
    { printf 'The human answered a request that agent %s filed about task %s before the task was given to you. The request and the answer:\n\n' "$AGENT_ID" "$(task_id "$t")"; cat "$q"; } > "$w/.agent/inbox/.$ms.tmp" \
      && mv "$w/.agent/inbox/.$ms.tmp" "$w/.agent/inbox/$ms.md" || continue
    sed -i 's/^status: answered$/status: closed/' "$q"
    printf '\n## Forwarded (%s, by the driver)\nTask %s is agent %s'"'"'s now: this answer went to its inbox.\n' "$(date '+%F %H:%M')" "$(task_id "$t")" "$o" >> "$q"
    tev takeover_answer_forwarded "$t" "$(basename "$q") to agent $o"; log "team: $(basename "$q") answered for $(task_id "$t"), which agent $o holds now - forwarded to its inbox"
  done
  return 0
}
team_takeover_sync() { team_takeover_settle; team_takeover_answer; team_takeover_receive; team_forward_answers; }   # before every pick
TAKEOVER_CUT=""
team_takeover_poll() {  # team_takeover_poll [task file of the running session] : during a session, every TEAM_TAKEOVER_POLL_S
  local cur="" d k a
  [ -n "${1:-}" ] && cur=$(claim_key "$1")
  team_forward_answers   # .agent/asks is not in git: safe during a session
  for d in "$TEAM"/takeover/*/; do
    [ -f "$d/asker" ] || continue; k=$(basename "$d")
    [ "$(claim_owner "$k")" = "$AGENT_ID" ] || continue
    if [ "$k" != "$cur" ]; then team_takeover_give "$k" later; continue; fi   # parked: given at once
    [ "$TAKEOVER_CUT" = "$k" ] && continue
    read -r a _ < "$d/asker"; TAKEOVER_CUT=$k
    echo "agent $a, on a faster card, has nothing to build and takes this task over (other tasks wait on it)" > .agent/handover-now
    tev takeover_cut "$1" "asked by agent $a"; log "team: agent $a asked for $k - this session is told to write its hand-over and end"
  done
  return 0
}
team_session_watch() { TAKEOVER_CUT=""; while sleep "${TEAM_TAKEOVER_POLL_S:-20}"; do team_beat; team_takeover_poll "$1"; done; }   # team_session_watch <task file> : background, during a build session
team_takeover_note() {  # team_takeover_note <task file> : the prompt's note on a task just taken over (its first session only)
  local f h s; f=.agent/taken-over-$(claim_key "$1")
  [ -f "$f" ] || return 0; read -r h s < "$f"; rm -f "$f"
  printf '%s' " TAKEN OVER: agent $h, on a slower card, was building this task; the driver gave it to you because other tasks wait on it. Its work so far is in your branch (commit $s): the task file's hand-over, its ticked boxes and its code. Read the hand-over, check that work against the acceptance criteria, then continue from it; redo only what is wrong."
}

# Prep: an agent with nothing to take prepares a task that starts soon (its dependencies are being built, or could
# start now), so whoever takes it checks a plan instead of researching from scratch (frontpage 2026-10-04: agent b had
# waited 862 minutes over the project, and agent a spent a whole session researching 230 before writing any code).
# Notes only, in tasks/prep/<id>.md, one writer (the lock $TEAM/prep/<id>); the driver keeps nothing else of the session
# and puts the notes into main when it ends. The session is cut short (wrapup's driver signal) as soon as the task can
# be built: then this agent takes it with its own notes, or an agent that claimed it waits a little for them.
prep_file() { echo "tasks/prep/$(task_id "$1").md"; }
prep_owner() {  # prep_owner <id> : the agent whose running loop prepares that task
  local a p
  [ -f "$TEAM/prep/$1/owner" ] || return 0
  read -r a p _ < "$TEAM/prep/$1/owner" || return 0
  kill -0 "$p" 2>/dev/null && echo "$a"; return 0
}
prep_lock() {  # prep_lock <task file> : take the prep lock (atomic); a lock whose loop is gone is taken over
  local id d; id=$(task_id "$1"); d=$TEAM/prep/$id; mkdir -p "$TEAM/prep"
  if ! mkdir "$d" 2>/dev/null; then
    [ -z "$(prep_owner "$id")" ] || return 1
    mv "$d" "$TEAM/prep/.stale-$id-$$-$(date +%s)" 2>/dev/null && mkdir "$d" 2>/dev/null || return 1
  fi
  echo "$AGENT_ID $$ $(date +%s)" > "$d/owner"; tev prep_start "$1"; return 0
}
prep_ready() {  # prep_ready <task file> : it can be built now, by this agent or another (prep ends)
  local m; m=$(compgen -G "$TEAM_DIR/tasks/000-*.md" | head -1)
  [ -n "$m" ] && [ "$(status_of "$m")" != done ] && return 0   # a re-plan started: the task may change
  [ -n "$(done_in_main "$1")" ] && return 0
  [ -n "$(claim_owner "$(claim_key "$1")")" ] && return 0
  [ -z "$(team_why_not "$1")" ]
}
prep_layers() {  # prep_layers <task file> : how many unbuilt layers stand before it can start: 1 = it waits only on
  # tasks being built or startable now; 2 = on a task that itself waits on such work; ... (0 = no unmet dependency)
  local d df n m=0 seen=${2:-}
  for d in $(unmet_deps "$1"); do
    df=$(compgen -G "$TEAM_DIR/tasks/$d-*.md" | head -1)
    if [ -z "$df" ] || [[ " $seen " == *" $d "* ]]; then n=99   # unknown task or a cycle: never prepared
    elif [ -n "$(claim_owner "$(claim_key "$df")")" ] || [ -z "$(unmet_deps "$df")" ]; then n=1
    else n=$(( $(prep_layers "$df" "$seen $d") + 1 )); fi
    [ "$n" -gt "$m" ] && m=$n
  done
  echo "$m"
}
# What a prep reads, against what this agent can read. The build limit (TEAM_MAX_TOUCHES, a file count) is for building,
# where reading, edits, test output and retries share the window; prep only reads, so it is limited by the size of the
# existing files and folders the task touches (files still to be created cost nothing), against this agent's hand-over
# limit less spawn reads and the notes (b: 75k - 25k = 50k tokens, ~200 KB). frontpage 2026-10-04: a 24-file task was
# 184 KB (~47k tokens), its 9- to 11-file neighbours 43-112 KB. A prep that still runs long writes its notes at the
# hand-over limit (wrapup), so the worst case is partial notes.
prep_read_bytes() {  # prep_read_bytes <task file>
  local p
  for p in $(touches_of "$1"); do
    [ -e "$p" ] && find "$p" -type f -not -path '*/.*' -not -path '*/__pycache__/*' -not -path '*/node_modules/*' -printf '%s\n'
  done | awk '{ s += $1 } END { print s + 0 }'
}
prep_budget_bytes() { echo $(( ( ${WRAPUP_SOFT_TOKENS:-120000} - ${TEAM_PREP_RESERVE_TOKENS:-25000} ) * 4 )); }
team_prep_target() {  # the task this idle agent prepares, or nothing: open, unclaimed, not prepared, small enough to read
  # in this agent's window (above); the nearest
  # to starting first (fewest unbuilt layers before it), then the longest chain behind it. Deeper tasks are prepared
  # too, once nothing nearer is left: their notes build on guesses, but an idle GPU builds nothing (frontpage
  # 2026-10-04: after preparing 242, b sat idle with 231-238 waiting behind 242 and 239 under a one-layer rule).
  # None while planning runs (the plan may still change every task).
  [ "${TEAM_PREP:-1}" = 1 ] || return 0
  local m f id l r best="" bl=999 br=0 ranks
  m=$(compgen -G "$TEAM_DIR/tasks/000-*.md" | head -1)
  [ -n "$m" ] && [ "$(status_of "$m")" != done ] && return 0
  ranks=$(team_ranks)
  for f in tasks/[0-9]*.md; do
    [ -f "$f" ] || continue
    case $f in tasks/000-*|tasks/999-*) continue ;; esac
    [ "$(status_of "$f")" = open ] || continue
    id=$(task_id "$f")
    [ -f "$(prep_file "$f")" ] && continue
    [ "$(cat "$TEAM/prep-tries/$id" 2>/dev/null || echo 0)" -lt 2 ] || continue
    grep -qxF -- "$f" <<<"${WAITING:-}" && continue
    [ -z "$(claim_owner "$(claim_key "$f")")" ] && [ -z "$(prep_owner "$id")" ] && [ -z "$(done_in_main "$f")" ] || continue
    team_workable "$f" && continue   # free for this agent: it is taken, not prepared
    [ "$(prep_read_bytes "$f")" -le "$(prep_budget_bytes)" ] || continue
    l=$(prep_layers "$f"); [ "$l" -lt 99 ] || continue
    r=$(rank_of "$id" "$ranks")
    if [ "$l" -lt "$bl" ] || { [ "$l" -eq "$bl" ] && [ "$r" -gt "$br" ]; }; then best=$f; bl=$l; br=$r; fi
  done
  echo "$best"
}
team_prep_basis() {  # team_prep_basis <task file> : one line, what the notes are built on (prompt and the notes' stamp)
  local d df o l t out=""
  l=$(prep_layers "$1")
  for d in $(unmet_deps "$1"); do
    df=$(compgen -G "$TEAM_DIR/tasks/$d-*.md" | head -1); t=$(sed -n 's/^# //p' "$df" 2>/dev/null | head -1 | cut -c1-70)
    o=$(claim_owner "$(claim_key "${df:-x}")")
    if [ -n "$o" ]; then out+=" $d ($t: being built by agent $o, branch agent/$o);"
    elif [ -z "$(unmet_deps "${df:-x}")" ]; then out+=" $d ($t: not started, can start now);"
    elif git cat-file -e "main:tasks/prep/$d.md" 2>/dev/null || [ -f "tasks/prep/$d.md" ]; then out+=" $d ($t: not started yet, prep notes tasks/prep/$d.md);"
    else out+=" $d ($t: not started yet, no notes);"; fi
  done
  [ -n "$out" ] || out=" no task, but another agent's task changes the same files;"
  printf '%s' "$l step(s) before it could start; built on:$out"
}
team_prep_prompt() {  # team_prep_prompt <task file> <iteration> : the whole prompt of a prep session
  local f=$1 id pf l basis deep=""
  id=$(task_id "$f"); pf=$(prep_file "$f"); basis=$(team_prep_basis "$f"); l=${basis%% *}
  [ "$l" -ge 2 ] 2>/dev/null && deep=" This task is $l steps from starting: tasks it waits on are not built yet, so what they will provide is a guess. Work from their task files, their prep notes where they have them, and the work in progress they in turn wait on, and mark those assumptions \"inferred\". Plan at the level that will survive: behaviour, interfaces, tests; name files and lines only where they will not move (a task that splits or moves modules changes them)."
  printf '%s' "You are iteration $2 of an autonomous coding loop, in a PREP SESSION: there is nothing you can build right now, so you prepare a task that starts later, $f. It is ${basis/; built on:/. It waits for:}$deep Write $pf so that the agent that takes $id can check your plan and start building at once, instead of researching from scratch. Read $f, the code and tests it will change, and what its dependencies will provide: their task files and prep notes, and work in progress on other agents' branches, read only (\`git log main..agent/<id>\`, \`git diff main...agent/<id> -- <path>\`, \`git show agent/<id>:<path>\`). $pf holds: 1. Assumptions: what each dependency will provide (names, signatures, data shapes, files), each marked \"seen on its branch\", \"seen in main\" or \"inferred\". 2. Plan: the steps, mapped to the task's acceptance boxes, with the files and functions to change. 3. Tests: the end-to-end, integration or golden tests to add or change, with their cases. 4. Risks and open questions (the human is not asked during prep: questions go here). Code sketches are welcome inside the notes. This session is not a task step: AGENTS.md's rules for the hand-over, PROGRESS.md, DECISIONS.md and task status do not apply (its reading rules do). Change nothing but $pf: the driver keeps only that file. Write it early and improve it as you go, committing each time (\`git add $pf && git commit -m \"prep $id: <what>\"\`): the session is ended as soon as the task can be built or other work is free. Then stop."
}
team_prep_watch() {  # team_prep_watch <task file> : in the background during a prep session. Real work beats prep: once
  # the task can be built, or any task is free for this agent, wrapup's driver signal tells the session to write its
  # notes and end (it ends a few turns later at most)
  local f=$1 t why
  while sleep "${TEAM_PREP_POLL_S:-20}"; do
    team_beat
    team_takeover_poll   # this agent's own claims a faster agent asked for are given at once (none is being built)
    if prep_ready "$f"; then why="task $(task_id "$f") can be built now (its dependencies are in main, or another agent took it)"
    elif t=$(team_takeover_candidate) && [ -n "$t" ]; then why="task $t, held by slower agent $(claim_owner "$t"), can be taken over by you (other tasks wait on it)"
    else t=$(next_task); [ -n "$t" ] || continue; why="task $(task_id "$t") is free for you to build"; fi
    echo "$why" > .agent/wrapup-now
    log "prep $(task_id "$f"): $why - the session is told to write its notes and end"; tev prep_cut "$f" "$why"
    return 0
  done
}
team_prep_finish() {  # team_prep_finish <task file> <commit before the session> [basis] : keep only the notes, stamped
  # with what they were built on, publish them to main, free the lock. Everything else the session changed is put back.
  local f=$1 h0=$2 basis=${3:-} id pf x p
  id=$(task_id "$f"); pf=$(prep_file "$f")
  commit_leftovers "uncommitted work after the prep session for $id"
  x=$(git diff --name-only "$h0" HEAD | grep -vxF -- "$pf" || true)
  [ -n "$x" ] && { log "prep $id: put back $(wc -w <<<"$x") other changed file(s): $(echo $x | cut -c1-150)"; tev prep_reverted "$f" "$(echo $x | cut -c1-200)"; }
  # The branch becomes where the session started plus one commit with the notes: the session's own commits never
  # reach main, not even in its history (the branch only goes into main with this agent's next accepted task).
  if [ "$(git rev-parse HEAD)" != "$h0" ]; then
    local keep=""
    if [ -s "$pf" ]; then
      keep=$(mktemp)
      { [ -n "$basis" ] && printf '> Prep notes by agent %s, %s, written %s\n> Check every assumption against main before building on it.\n\n' "$AGENT_ID" "$(date '+%F %H:%M')" "$basis"; cat "$pf"; } > "$keep"
    fi
    git reset -q --hard "$h0"
    if [ -n "$keep" ]; then mkdir -p "$(dirname "$pf")"; mv "$keep" "$pf"; git add "$pf" && git commit -q -m "[driver] prep $id: notes by agent $AGENT_ID"; fi
  fi
  if [ ! -s "$pf" ]; then
    mkdir -p "$TEAM/prep-tries"; echo $(( $(cat "$TEAM/prep-tries/$id" 2>/dev/null || echo 0) + 1 )) > "$TEAM/prep-tries/$id"
    log "prep $id: no notes written"; tev prep_empty "$f"
  else
    exec 8> "$TEAM/merge.lock"; flock 8
    if git -C "$TEAM_DIR" checkout "$BRANCH" -- "$pf" && { git -C "$TEAM_DIR" diff --cached --quiet -- "$pf" || git -C "$TEAM_DIR" commit -q -m "[driver] prep notes for $id by agent $AGENT_ID" -- "$pf"; }; then
      tev prep_published "$f" "$(wc -c < "$pf") bytes"; log "team: prep notes for $id published to main ($pf)"
    else
      git -C "$TEAM_DIR" reset -q -- "$pf" 2>/dev/null; git -C "$TEAM_DIR" checkout -q main -- "$pf" 2>/dev/null || rm -f "${TEAM_DIR:?}/$pf"
      tev prep_publish_failed "$f"; log "WARNING team: could not publish $pf to main"
    fi
    flock -u 8
  fi
  rm -rf "${TEAM:?}/prep/$id"; rm -f .agent/wrapup-now
}
team_prep_handoff() {  # team_prep_handoff <task file> : just claimed, but another agent is still preparing it. Its session
  # has been told to end (its watch sees the claim): the notes come first, waited for at most TEAM_PREP_HANDOFF_S.
  local id o t0 s got pf
  id=$(task_id "$1"); o=$(prep_owner "$id"); pf=$(prep_file "$1")
  if [ -n "$o" ] && [ "$o" != "$AGENT_ID" ]; then
    t0=$(date +%s); log "team: agent $o is still preparing $id - waiting up to ${TEAM_PREP_HANDOFF_S:-300}s for its notes"
    while [ -n "$(prep_owner "$id")" ] && [ $(( $(date +%s) - t0 )) -lt "${TEAM_PREP_HANDOFF_S:-300}" ]; do team_beat; sleep "${TEAM_PREP_HANDOFF_POLL_S:-5}"; done
    s=$(( $(date +%s) - t0 )); team_sync || true
    got="not yet - starting without them"; [ -f "$pf" ] && got=received
    tev prep_handoff "$1" "${s}s, notes $got"; log "team: waited ${s}s for agent $o's prep notes on $id ($got)"
  fi
  # notes that reached main after this checkout's last sync (published between that sync and the claim)
  if [ ! -f "$pf" ] && git cat-file -e "main:$pf" 2>/dev/null; then team_sync || true; fi
  return 0
}
team_prep_note() {  # team_prep_note <task file> : the session prompt's pointer to the task's prep notes, if it has any
  local pf; pf=$(prep_file "$1"); [ -f "$pf" ] || pf="tasks/prep/$(claim_key "$1").md"
  [ -f "$pf" ] || return 0
  if [ -z "$(handover_of "$1")" ]; then
    printf '%s' " PREP NOTES: $pf was written for this task by an agent that had no work, before the task could start. Read it first: it saves you the research. Check each of its assumptions against what main has now (the dependencies' real code), fix the plan where they are wrong, then build. Say in your hand-over which assumptions were wrong."
  else
    printf '%s' " Prep notes for this task: $pf."
  fi
}

# Planning a team project: tasks must say what they need and what they touch, so the scheduler can run them in parallel.
TEAM_PLAN_CRITERIA='- [ ] Every task file besides 000 and 999 has a `Depends on:` line (the numbers of the tasks that must be finished first, or `none`) and a `Touches:` line (the files and directories the task will create or change)
- [ ] The work is split into modules that two agents can build at the same time: tasks that could run at once touch different files, and PLAN.md shows the order as waves (all tasks of a wave can run at once, and most waves have two or more tasks)
- [ ] Tests never bind a fixed network port (use port 0) or write outside the project and the system temp dir: two checkouts of this project run their tests at the same time'
TEAM_PLAN_NOTE='- Two agents build this project at the same time, each in its own checkout; a task goes to one agent once all its `Depends on:` tasks are finished, and never while the other agent works on a task that touches the same files. Put shared foundations first (project skeleton, data model, the interfaces between modules), so the later tasks can go ahead independently. A subtask that needs the result of another task says so in its own `Depends on:` line. Avoid hotspot files: when many tasks would edit the same file (README, a central config module, the sample config), give each module its own file or section, or make those edits once in an early task; the driver replays the schedule and sends the plan back once if shared files make tasks wait that their dependencies would let run at once. List only real dependencies: tasks that touch the same files are already kept apart.'
team_plan_schedule() {  # plan-schedule's input: "<id> TAB <deps> TAB <ids it shares files with> TAB <touches>" per open task
  local f g c files=()
  for f in tasks/[0-9]*.md; do
    case $f in tasks/000-*|tasks/999-*) continue ;; esac
    case $(status_of "$f") in done|dropped|split) continue ;; esac
    files+=("$f")
  done
  for f in "${files[@]}"; do
    c=""; for g in "${files[@]}"; do [ "$f" != "$g" ] && overlap "$f" "$g" && c+=" $(task_id "$g")"; done
    printf '%s\t%s\t%s\t%s\n' "$(task_id "$f")" "$(deps_of "$f" | tr '\n' ' ')" "$c" "$(touches_of "$f" | tr '\n' ' ')"
  done
}
team_plan_check() {  # extra checks of the planning task's done claim in team mode
  local f r=""
  for f in tasks/[0-9]*.md; do
    case $f in tasks/000-*|tasks/999-*) continue ;; esac
    grep -qiE '^Depends on:' "$f" || r+="    $f has no \`Depends on:\` line"$'\n'
    grep -qiE '^Touches:' "$f" || r+="    $f has no \`Touches:\` line"$'\n'
  done
  [ -n "$r" ] && printf '%s\n%s' "- Team project: every task needs \`Depends on:\` and \`Touches:\` lines:" "$r"
  # Shared files: the scheduler never runs two tasks that share a file, so what matters is whether that makes the plan
  # slower than its dependencies already do; plan-schedule replays it. (frontpage 2026-10-04: a per-file count, more
  # than 3 open tasks per file, ignored the dependencies and rejected a plan the shared files did not slow at all, 16
  # sessions in a row.) Its advice sends a plan back once per GOAL.md version, so planning never spins on it; tasks
  # that can never start (dependency cycle) always send it back.
  local adv rc key mark=$TEAM/plan-advised
  adv=$(team_plan_schedule | plan-schedule "$(ls "$TEAM/agents" 2>/dev/null | wc -l)"); rc=$?
  case $rc in
    0) ;;
    4) printf '%s\n' "$adv" ;;
    3) key=$(cat GOAL.md 2>/dev/null | sha256sum | cut -c1-12)
       if [ "$(cat "$mark" 2>/dev/null)" != "$key" ]; then echo "$key" > "$mark"; printf '%s\n' "$adv"
       else log "plan accepted with the schedule advice already given once for this GOAL.md: $(head -1 <<<"$adv" | cut -c16-200)" > /dev/null
       fi ;;
    *) log "WARNING: plan-schedule failed (rc $rc) - the plan was not checked for shared files" > /dev/null ;;
  esac
  return 0
}
