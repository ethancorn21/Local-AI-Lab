#!/usr/bin/env python3
"""task-audit <init|scan|owner FILE|missing FILE> : who owns each task, and what the agent changed in the queue.

The agent owns HOW work is done: it may split tasks into subtasks (tasks/025a-*.md), add tasks, rewrite its own tasks.
The human owns WHAT done means: the acceptance boxes of tasks the agent did not create. Registry: .agent/tasks.json.
  init [FILE..] register every task file not yet known as the human's (run at loop start: files present when a loop
               starts were written by a human); with FILEs, only those (team mode: tasks the other agents created
               arrive through merges and must not become the human's); records each one's acceptance boxes
  scan         after an iteration: register new task files as the agent's, and report (one line each, for the loop
               log) new tasks, human tasks whose boxes went missing, and new or changed `## Proposed changes` sections
  owner FILE   print human or agent
  missing FILE print the human's boxes that are no longer in the file (one per line)
  format [--team] FILE..  what the driver cannot read in these task files, in plain words, one line each (run after
               every session on the task files it changed; the next session's prompt says what to fix). The lines the
               driver reads: line 1 `Status: <word>`, `Depends on: 229, 231` (or none), in a team `Touches: <paths>`.
               A local model copies the example it is shown, and the format guide showed `## Depends on` with a list
               until 2026-10-08: such a task got no dependencies at all and nobody was told (refactor map, card 2).
Box identity = the first line of a `- [ ]` / `- [x]` item, whitespace-normalised, tick state ignored.
"""
import glob, hashlib, json, os, re, sys

REG = ".agent/tasks.json"
TASK_FILE = re.compile(r"^(\d{3}[a-z]*)-.+\.md$")
BOX = re.compile(r"^\s*- \[[ xX]\]\s*(.*)$")


def boxes(path):
    out = []
    for line in open(path, encoding="utf-8", errors="replace"):
        m = BOX.match(line)
        if m:
            out.append(re.sub(r"\s+", " ", m.group(1)).strip())
    return out


def proposal(path):
    text = open(path, encoding="utf-8", errors="replace").read()
    m = re.search(r"(?ms)^## Proposed changes\s*\n(.*?)(?=^## |\Z)", text)
    return m.group(1).strip() if m else ""


def sha(s):
    return hashlib.sha256(s.encode()).hexdigest()[:16]


def tasks():
    out = {}
    for f in sorted(glob.glob("tasks/*.md")):
        m = TASK_FILE.match(os.path.basename(f))
        if m:
            out[m.group(1)] = f
    return out


def load():
    return json.load(open(REG)) if os.path.exists(REG) else {}


def save(reg):
    tmp = REG + ".tmp"
    json.dump(reg, open(tmp, "w"), indent=1, sort_keys=True)
    os.replace(tmp, REG)


def title(f):
    for line in open(f, encoding="utf-8", errors="replace"):
        if line.startswith("# "):
            return line[2:].strip()[:120]
    return ""


def missing(reg, tid, f):
    e = reg.get(tid)
    if not e or e["owner"] != "human":
        return []
    have = set(boxes(f))
    return [b for b in e["boxes"] if b not in have]


STATUSES = ("open", "in-progress", "split", "done", "blocked", "dropped")
DEP_LINE = re.compile(r"^Depends on:[ \t]*(.*)$", re.I)      # agent-team-lib deps_of reads the first such line
DEP_HEAD = re.compile(r"^#+\s*Depends on\b", re.I)
TASK_NO = re.compile(r"\b[0-9]+[a-z]*\b")


def format_problems(f, team):
    lines = open(f, encoding="utf-8", errors="replace").read().splitlines()
    first = lines[0] if lines else ""
    out = []
    m = re.match(r"\s*Status:\s*([A-Za-z-]+)", first, re.I)   # the first word (agent-loop status_of)
    status = m.group(1).lower() if m else ""
    if status not in STATUSES:
        out.append(f"line 1 is `{first[:60]}`: the first line must be `Status: <word>`, the word one of {', '.join(STATUSES)}")
    deps = [(i, l) for i, l in enumerate(lines, 1) if DEP_LINE.match(l)]
    heads = [i for i, l in enumerate(lines, 1) if DEP_HEAD.match(l)]
    if heads and not deps:
        i, ids = heads[0], []
        for l in lines[i:]:
            if l.startswith("#"):
                break
            ids += TASK_NO.findall(l) if l.lstrip().startswith(("-", "*")) else []
        out.append(f"line {i}: `{lines[i - 1].strip()}` is a heading, and the driver reads dependencies only from one line "
                   f"`Depends on: 229, 231` (or `Depends on: none`), so this task has none. Write `Depends on: {', '.join(ids) or 'none'}` instead")
    if deps:
        i, l = deps[0]
        v = DEP_LINE.match(l).group(1).strip()
        if not TASK_NO.search(v) and not re.fullmatch(r"(none|-)?\.?\s*(\(.*\))?", v, re.I):
            out.append(f"line {i}: `{l.strip()[:80]}` names no task number the driver can read; write the numbers "
                       "(`Depends on: 229, 231`) or `Depends on: none`")
    mt = TASK_FILE.match(os.path.basename(f))
    tid = mt.group(1) if mt else ""
    top = re.fullmatch(r"\d{3}", tid) and tid not in ("000", "998", "999")   # subtasks share their parent's claim
    if team and top and status in ("open", "in-progress", "blocked") \
            and not any(re.match(r"^Touches:", l, re.I) for l in lines):
        out.append("no `Touches:` line, so the driver cannot keep the other agents off this task's files: "
                   "add `Touches: <the files and folders it changes>`")
    return [f"{f} {p}" for p in out]


def main():
    cmd = sys.argv[1]
    if cmd == "format":
        team = "--team" in sys.argv[2:]
        for f in (a for a in sys.argv[2:] if a != "--team"):
            if os.path.isfile(f):
                for p in format_problems(f, team):
                    print(p)
        return 0
    reg, ts = load(), tasks()
    if cmd == "init":
        n = 0
        only = {m.group(1) for m in (TASK_FILE.match(os.path.basename(a)) for a in sys.argv[2:]) if m}
        for tid, f in ts.items():
            if tid not in reg and (not sys.argv[2:] or tid in only):
                reg[tid] = {"owner": "human", "file": f, "boxes": boxes(f), "proposal": sha(proposal(f)), "reported": ""}
                n += 1
        save(reg)
        if n:
            print(f"registered {n} task file(s) present at loop start as the human's")
        return 0
    if cmd == "scan":
        for tid, f in ts.items():
            if tid not in reg:
                reg[tid] = {"owner": "agent", "file": f, "boxes": [], "proposal": "", "reported": ""}
                parent = re.match(r"^(\d{3}[a-z]*?)[a-z]$", tid)
                kind = f"subtask of {parent.group(1)}" if parent else "TOP-LEVEL task - review it (veto: set Status: dropped)"
                print(f"NEW TASK by agent: {f} ({kind}): {title(f)}")
        for tid, e in reg.items():
            if e["owner"] != "human":
                continue
            f = ts.get(tid)
            if not f:
                if e.get("reported") != "deleted":
                    print(f"WARNING: the human's task {e['file']} was deleted or renamed")
                    e["reported"] = "deleted"
                continue
            e["file"] = f
            gone = missing(reg, tid, f)
            mark = sha("\n".join(gone)) if gone else ""
            if mark != e.get("reported", ""):
                if gone:
                    print(f"WARNING: acceptance criteria of {f} changed by the agent - missing: " + " | ".join(g[:80] for g in gone))
                e["reported"] = mark
            p = proposal(f)
            if sha(p) != e.get("proposal") :
                if p:
                    print(f"PROPOSAL in {f}: " + re.sub(r"\s+", " ", p)[:300])
                e["proposal"] = sha(p)
        save(reg)
        return 0
    if cmd in ("owner", "missing"):
        f = sys.argv[2]
        m = TASK_FILE.match(os.path.basename(f))
        tid = m.group(1) if m else ""
        if cmd == "owner":
            print(reg.get(tid, {}).get("owner", "agent"))
        else:
            for b in missing(reg, tid, f):
                print(b)
        return 0
    print(__doc__, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
