#!/usr/bin/env python3
"""codemap-gen [--init] [project dir] : regenerate CODEMAP.md from the code, so no agent has to maintain it.

One line per tracked source file: path, length, the first sentence of its header comment, its exports. Everything in
CODEMAP.md above the generated-section marker (title, architecture rules) is hand-written and kept verbatim. A
CODEMAP.md without the marker is someone's hand-written map: left alone unless --init (which keeps nothing of it).
Exit codes: 0 = unchanged, 3 = CODEMAP.md rewritten, 1 = error (nothing written).
"""
import os, re, subprocess, sys

MARK = "<!-- generated by the driver below this line from each file's header comment and exports: do not edit, changes are overwritten -->"
DEFAULT_TOP = """# CODEMAP

The file map below is generated by the driver before every session from the code itself: one line per file with the
first sentence of the file's header comment and its exports. Keep each file's header comment accurate when you change
the file; that is where this map comes from. The text above the marker line is hand-written and yours to edit.
"""
EXTS = (".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".py", ".sh", ".html", ".css")
SKIP = re.compile(r"^(tasks|codemap|\.agent|node_modules)/|(^|/)\.")
MAX_EXPORTS = 10
RANGE_MIN_LINES = 150  # files at least this long get line ranges for their exported functions and classes
TOP_DECL = re.compile(r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function\*?|class|const|let|var)\s", re.M)
PY_TOP = re.compile(r"^(?:async\s+)?(?:def|class)\s|^[A-Za-z_]\w*\s*=", re.M)

JS_EXPORT = [  # (rank, pattern): functions and classes are listed before constants
    (0, re.compile(r"^export\s+(?:default\s+)?(?:async\s+)?function\*?\s+([A-Za-z_$][\w$]*)", re.M)),
    (0, re.compile(r"^export\s+(?:default\s+)?class\s+([A-Za-z_$][\w$]*)", re.M)),
    (1, re.compile(r"^export\s+(?:const|let|var)\s+([A-Za-z_$][\w$]*)", re.M)),
]
JS_EXPORT_LIST = re.compile(r"^export\s*\{([^}]*)\}", re.M)
PY_DEF = re.compile(r"^(?:async\s+)?(?:def|class)\s+([A-Za-z]\w*)", re.M)


def header(text, path):
    """The file's leading comment (or Python docstring) as one string."""
    lines = text.split("\n")
    if lines and lines[0].startswith("#!"):
        lines = lines[1:]
    body = "\n".join(lines).lstrip()
    if path.endswith(".py"):
        m = re.match(r'(?s)^[rRuU]?("""|\'\'\')(.*?)\1', body)
        if m:
            return m.group(2)
    m = re.match(r"(?s)^/\*\*?(.*?)\*/", body)
    if m:
        return re.sub(r"(?m)^\s*\*\s?", "", m.group(1))
    m = re.match(r"(?s)^<!--(.*?)-->", body)
    if m:
        return m.group(1)
    out = []
    for line in body.split("\n"):
        s = line.strip()
        if s.startswith("//"):
            out.append(s[2:].strip())
        elif s.startswith("#") and path.endswith((".py", ".sh")):
            out.append(s[1:].strip())
        else:
            break
    return "\n".join(out)


def first_sentence(h):
    h = re.sub(r"\s+", " ", h).strip()
    if not h:
        return ""
    m = re.search(r"(?<!\be\.g)(?<!\bi\.e)(?<!\betc)[.!?](?=\s|$)", h)
    s = h[: m.end()] if m else h
    return s if len(s) <= 180 else s[:177].rstrip() + "..."


def exports(text, path):
    """-> [(name, start line or None, end line or None)]: functions/classes first, then constants."""
    names = []
    if path.endswith((".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx")):
        found = []
        for rank, rx in JS_EXPORT:
            found += [(rank, m.start(), m.group(1)) for m in rx.finditer(text)]
        tops = [m.start() for m in TOP_DECL.finditer(text)]
        for m in JS_EXPORT_LIST.finditer(text):
            for part in m.group(1).split(","):
                part = part.strip()
                if part:
                    found.append((1, m.start(), part.split(" as ")[-1].strip()))
        if re.search(r"^export\s+default\s+(?!(async\s+)?(function|class)\s+[A-Za-z_$])", text, re.M):
            found.append((0, len(text), "default"))
        names = [(n, pos if rank == 0 else None) for rank, pos, n in sorted(found)]
    elif path.endswith(".py"):
        tops = [m.start() for m in PY_TOP.finditer(text)]
        names = [(m.group(1), m.start()) for m in PY_DEF.finditer(text)]
    else:
        tops = []
    line = lambda pos: text.count("\n", 0, pos) + 1
    out, seen = [], set()
    for n, pos in names:
        if n in seen:
            continue
        seen.add(n)
        if pos is None:
            out.append((n, None, None))
            continue
        # a function's range ends where the next top-level declaration begins (trailing blank and comment lines,
        # e.g. the next section's divider or doc comment, dropped)
        nxt = next((t for t in tops if t > pos), len(text))
        end = line(nxt) - 1 if nxt < len(text) else text.count("\n") + 1
        lines = text.split("\n")
        while end > line(pos) and (not lines[end - 1].strip() or lines[end - 1].lstrip().startswith(("//", "/*", "*", "#"))):
            end -= 1
        out.append((n, line(pos), end))
    return out


def line_for(path):
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    n = text.count("\n") + (0 if text.endswith("\n") or not text else 1)
    desc = first_sentence(header(text, path)) or "(no header comment - add one)"
    ex = exports(text, path)
    ranged = n >= RANGE_MIN_LINES
    shown = [f"{nm} L{a}-{b}" if ranged and a else nm for nm, a, b in ex[:MAX_EXPORTS]]
    more = f", ... (+{len(ex) - MAX_EXPORTS} more)" if len(ex) > MAX_EXPORTS else ""
    ex_s = f" Exports: {', '.join(shown)}{more}." if ex else ""
    return f"- `{path}` ({n} lines) - {desc}{ex_s}"


def main():
    args = [a for a in sys.argv[1:] if a != "--init"]
    os.chdir(args[0] if args else ".")
    files = subprocess.run(["git", "ls-files"], capture_output=True, text=True, check=True).stdout.split("\n")
    files = sorted(f for f in files if f.endswith(EXTS) and not SKIP.search(f) and os.path.isfile(f))
    old = open("CODEMAP.md").read() if os.path.exists("CODEMAP.md") else ""
    if old and MARK not in old and "--init" not in sys.argv:
        print("codemap-gen: CODEMAP.md has no generated-section marker (hand-maintained): left alone; "
              "convert it once with --init", file=sys.stderr)
        return 0
    top = old.split(MARK)[0].rstrip("\n") if MARK in old else DEFAULT_TOP.rstrip("\n")
    out, lastdir = [top, "", MARK, "",
                    f"Line ranges (L...) are as of the start of this session, for files of {RANGE_MIN_LINES}+ lines: "
                    "read just that range (the read tool takes an offset and a limit); after edits they shift."], None
    for f in files:
        d = os.path.dirname(f) or "."
        if d != lastdir:
            out += ["", f"## {d}/" if d != "." else "## (project root)"]
            lastdir = d
        ln = line_for(f)
        if ln:
            out.append(ln)
    new = "\n".join(out).rstrip("\n") + "\n"
    if new == old:
        return 0
    open("CODEMAP.md.tmp", "w").write(new)
    os.replace("CODEMAP.md.tmp", "CODEMAP.md")
    return 3


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"codemap-gen: {exc}", file=sys.stderr)
        sys.exit(1)
