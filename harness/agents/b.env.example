# agent b: RTX 5060 Ti, llama.cpp, Qwen3.8-27B IQ4_XS, 114k window (production chat template, same effort levels).
# Copy to ~/.agent-kit/agents/b.env; `agent-team init` copies it into each team project's worktree (.agent/team.env).
LLM_URL=http://127.0.0.1:8082
# its own Pi config directory (models.json pointing at port 8082); extensions can be a symlink to the shared ones
PI_CODING_AGENT_DIR=/home/<agent-user>/.agent-kit/pi-b
# hand-over limits scaled to the 114k window the way production relates them (hard = window - Pi's 8k reserve)
WRAPUP_SOFT_TOKENS=75000
WRAPUP_HARD_TOKENS=100000
WRAPUP_WINDOW_TOKENS=114688
WRAPUP_CLAMP_FROM=65000
# build size limit: tasks touching more files than this go to agents with bigger windows
TEAM_MAX_TOUCHES=8
# relative speed (about a quarter of the 3090 Ti)
TEAM_SPEED=1
