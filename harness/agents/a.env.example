# agent a: RTX 3090 Ti, vLLM (production): default Pi config, 150k window, default hand-over limits.
# Copy to ~/.agent-kit/agents/a.env; `agent-team init` copies it into each team project's worktree (.agent/team.env).
LLM_URL=http://127.0.0.1:8080
# relative speed for critical-path picking: the slowest running agent takes tasks nothing waits on
TEAM_SPEED=4
