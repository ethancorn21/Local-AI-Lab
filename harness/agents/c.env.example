# agent c: RTX 3090, vLLM (a second copy of the production model): 150k window, default hand-over limits.
# Copy to ~/.agent-kit/agents/c.env; `agent-team add <name> c` copies it into the team project's new worktree.
LLM_URL=http://127.0.0.1:8081
# its own Pi config directory (models.json provider pointing at port 8081); extensions can be a symlink to the shared ones
PI_CODING_AGENT_DIR=/home/<agent-user>/.agent-kit/pi-c
# relative speed for critical-path picking: the same class as agent a
TEAM_SPEED=4
