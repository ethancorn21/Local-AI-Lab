#!/usr/bin/env python3
"""lab-archive-ingest: the forced command of the AI box's archive account (authorized_keys command=..., from the VM
only, no shell, no forwarding). Stores what lab-archive-send pipes in as a new, read-only file
<root>/vm/YYYY-MM/<UTC time>-<random>.tar.zst and answers "stored <name> <bytes>". It can only add: it never opens an
existing file, so the VM (where agents run as root) cannot delete or rewrite anything already archived.
The client's command line (SSH_ORIGINAL_COMMAND, or argv in tests) must be "<bytes> <sha256>" of the stream: a
connection that drops mid-upload looks like a clean end of input, and is refused instead of stored truncated.
Refused too: a stream that is not zstd, one over the size cap, or any upload while the disk is short of space."""
import hashlib
import os
import re
import secrets
import shutil
import sys
import time

ROOT = os.environ.get("LAB_ARCHIVE_ROOT", "/opt/lab-archive")
CAP = int(os.environ.get("LAB_ARCHIVE_CAP", 8 << 30))            # one upload, compressed
MIN_FREE = int(os.environ.get("LAB_ARCHIVE_MIN_FREE", 100 << 30))  # left on the disk after it
ZSTD_MAGIC = b"\x28\xb5\x2f\xfd"


def refuse(why):
    print(f"refused {why}", flush=True)
    sys.exit(1)


def main():
    want = (" ".join(sys.argv[1:]) or os.environ.get("SSH_ORIGINAL_COMMAND", "")).strip()
    m = re.fullmatch(r"(\d{1,15}) ([0-9a-f]{64})", want)
    if not m:
        refuse("usage")
    want_n, want_sha = int(m.group(1)), m.group(2)
    if want_n > CAP:
        refuse("too-big")
    now = time.gmtime()
    d = os.path.join(ROOT, "vm", time.strftime("%Y-%m", now))
    os.makedirs(d, mode=0o755, exist_ok=True)
    if shutil.disk_usage(d).free < MIN_FREE + CAP:
        refuse("disk-full")
    # microseconds in the name: uploads sort by arrival even within one second (export: the newest copy of a file wins)
    name = time.strftime("%Y%m%dT%H%M%S", now) + f".{time.time_ns() // 1000 % 1000000:06d}Z-" + secrets.token_hex(4) + ".tar.zst"
    part = os.path.join(d, "." + name + ".part")
    fd = os.open(part, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    n, head, h = 0, b"", hashlib.sha256()
    try:
        with os.fdopen(fd, "wb") as out:
            inp = sys.stdin.buffer
            while True:
                chunk = inp.read(1 << 20)
                if not chunk:
                    break
                if len(head) < 4:
                    head += chunk[:4 - len(head)]
                n += len(chunk)
                if n > CAP:
                    raise ValueError("too-big")
                h.update(chunk)
                out.write(chunk)
            out.flush()
            os.fsync(out.fileno())
        if n != want_n or h.hexdigest() != want_sha:
            raise ValueError("incomplete")
        if head != ZSTD_MAGIC:
            raise ValueError("not-zstd")
        os.chmod(part, 0o444)
        os.link(part, os.path.join(d, name))   # fails if the name exists: never replaces a file
        os.unlink(part)
    except BaseException as e:
        try:
            os.unlink(part)
        except OSError:
            pass
        refuse(e.args[0] if isinstance(e, ValueError) else type(e).__name__)
    print(f"stored {name} {n}", flush=True)


if __name__ == "__main__":
    main()
