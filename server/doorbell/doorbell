#!/usr/bin/python3 -I
"""doorbell: the lab's Telegram relay (telecloak). The forced command of the doorbell account's only SSH key, which the
agents' VM uses; SSH_ORIGINAL_COMMAND picks the action:
  send        stdin: one JSON message {"kind": ask|ring|reply|info, "project", "ask", "asks", "answered", "text",
              "plain"}. Encrypted here and sent to the human; with "plain": true (a project not marked confidential,
              2026-10-06) sent as readable text instead, and a plain reply to it is accepted (below).
  fetch       the human's messages to the bot (sent with the telecloak app), checked and decrypted here, printed as
              JSON lines. Each stays queued until acked, so nothing is lost if the VM drops the connection.
  ack <id>... drop fetched messages the VM has handled
  anything else, or nothing: ring - the fixed ping ("help i need your attention"), as before telecloak.

Why here: the bot token and the telecloak key stay on the AI box, out of the agents' reach (they are root-equivalent on
their VM). The VM chooses what the human is told, never how it is encrypted, and only ever sees what the human sent.
Telegram sees only ciphertext ("tc1....", see telecloak_core.py).
- Without a key (/etc/doorbell/telecloak.key, from telecloak-setup) only the fixed ping leaves, never message text.
- Inbound is accepted only from the human's own account (CHAT_ID) in the private chat, only if it decrypts with the
  human-to-bot key (so the key alone is not enough, and neither is the Telegram account alone), is at most a day old,
  was not seen before (replays), and is a well-formed answer, message or command.
- Plain projects (the human's choice, 2026-10-06: encryption only for projects marked confidential): their messages
  leave as readable text, and the human may answer one by replying to it in Telegram, without the app. Such a reply is
  accepted only from the human's account, only as a reply to a plain message this relay sent (plain-sent.json: message
  id -> project and request), and only as an answer to that request or a message to that project, never a command.
  So a hijacked Telegram account can reach plain projects' agents, but cannot start or stop loops or reach a
  confidential project.
- Anything rejected is logged (syslog, tag doorbell) without its content; the human is told once per fetch.
- Rate limits on everything sent: PER_HOUR and PER_DAY; a ring within RING_GAP of the last is not re-sent.
Credentials: /etc/doorbell/telegram.env (BOT_TOKEN, CHAT_ID), written by doorbell-setup. State: /var/lib/doorbell.
"""
import fcntl
import hashlib
import json
import os
import re
import sys
import syslog
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, "/usr/local/lib/telecloak")
from telecloak_core import Channel, Reassembler, Seen, TelecloakError, is_wire, load_psk  # noqa: E402

CONF = "/etc/doorbell/telegram.env"
KEY = "/etc/doorbell/telecloak.key"
STATE = "/var/lib/doorbell"
FIXED = "help i need your attention"
RING_GAP = 600
PER_HOUR, PER_DAY = 20, 100
MAX_TEXT = 8000
MAX_AGE, MAX_AHEAD = 86400, 300       # inbound: refuse older than a day or more than 5 min in the future
POLL = 20                             # seconds a fetch waits for new messages (Telegram long polling)
PROJECT = re.compile(r"[A-Za-z0-9._-]{1,64}")
ASK = re.compile(r"\d{1,4}")
MSG_ID = re.compile(r"[0-9a-f]{16}")
PLAIN_KEEP = 7 * 86400                # how long a plain message can still be answered by replying to it
TG_LIMIT = 4000                       # characters per plain Telegram message (Telegram's limit is 4096)
COMMANDS = {"start", "stop", "stop-now", "status"}
UNSAFE = re.compile("[\u0000-\u0008\u000b-\u001f\u007f-\u009f‪-‮⁦-⁩]")


class Refused(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


def log(msg):
    syslog.openlog("doorbell")
    syslog.syslog(msg)


def clean(s, limit=MAX_TEXT):
    s = UNSAFE.sub("", str(s)).strip()
    return s if len(s) <= limit else s[:limit] + f"\n[cut at {limit} characters]"


def conf():
    vals = {}
    try:
        with open(CONF) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                vals[k] = v
    except OSError:
        pass
    if not vals.get("BOT_TOKEN") or not vals.get("CHAT_ID"):
        log("refused: not configured")
        raise Refused("not configured (run doorbell-setup on the AI box)", 2)
    return vals["BOT_TOKEN"], int(vals["CHAT_ID"])


def channel(token, chat):
    """The bot's side of the telecloak conversation with the human, or None without a key."""
    try:
        with open(KEY) as f:
            psk = load_psk(f.read())
    except FileNotFoundError:
        return None
    except (OSError, TelecloakError) as e:
        log(f"telecloak key unusable: {e}")
        return None
    return Channel(psk, int(token.split(":")[0]), chat)   # a bot's user id is the number before the ':'


def telegram(token, method, params, timeout=30):
    # The token is in the URL: never let the URL reach an error message or a log.
    req = urllib.request.Request(f"https://api.telegram.org/bot{token}/{method}",
                                 data=urllib.parse.urlencode(params).encode())
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            res = json.load(r)
    except urllib.error.HTTPError as e:
        try:
            res = json.load(e)
        except Exception:  # noqa: BLE001
            res = {"ok": False, "description": f"HTTP {e.code}"}
    except (urllib.error.URLError, OSError) as e:
        raise Refused(f"Telegram unreachable ({type(e).__name__})") from None
    if not res.get("ok"):
        raise Refused(f"Telegram error: {str(res.get('description', '?'))[:200]}")
    return res["result"]


class Lock:
    def __init__(self, name, wait=60):
        self.path, self.wait = f"{STATE}/{name}.lock", wait

    def __enter__(self):
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
        t0 = time.time()
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.time() - t0 > self.wait:
                    raise Refused("busy") from None
                time.sleep(0.5)

    def __exit__(self, *_):
        os.close(self.fd)


def load(name, default):
    try:
        with open(f"{STATE}/{name}") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(name, obj):
    tmp = f"{STATE}/{name}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, f"{STATE}/{name}")


# ---- outbound ---------------------------------------------------------------------------------------------------------

def outbound(msg):
    """Keep only well-formed fields of a message from the VM."""
    if not isinstance(msg, dict) or msg.get("kind") not in {"ask", "ring", "reply", "info"}:
        raise Refused("send: need a JSON object with kind ask, ring, reply or info")
    body = {"kind": msg["kind"]}
    if isinstance(msg.get("project"), str) and PROJECT.fullmatch(msg["project"]):
        body["project"] = msg["project"]
    if isinstance(msg.get("ask"), str) and ASK.fullmatch(msg["ask"]):
        body["ask"] = msg["ask"]
    for k in ("asks", "answered"):
        if isinstance(msg.get(k), list):
            body[k] = [a for a in msg[k] if isinstance(a, str) and ASK.fullmatch(a)][:50]
    body["text"] = clean(msg.get("text", "")) or (FIXED if body["kind"] == "ring" else "")
    if msg.get("plain") is True and "project" in body:
        body["plain"] = True
    return body


def plain_text(body):
    """A plain message as the human reads it in Telegram."""
    p, text = body.get("project", ""), body["text"]
    if body["kind"] == "ask":
        return f"{p}, request {body.get('ask', '?')}:\n{text}\n\n(Reply to this message to answer it.)"
    if body["kind"] == "ring" and body.get("asks"):
        return f"{p}: waiting for your answer to request {', '.join(body['asks'])}. Reply to this message to tell it something."
    return f"{p}: {text}"


def deliver(token, chat, body):
    """Encrypt and send one message to the human, within the rate limits. Returns a one-line result."""
    plain = body.get("plain") is True
    ch = None if plain else channel(token, chat)
    if ch is None and not plain:
        body = {"kind": "ring"}           # no key: only the fixed ping may leave, never message text
    now = time.time()
    with Lock("send"):
        rings = load("rings.json", [])
        if body["kind"] == "ring" and rings and now - rings[-1] < RING_GAP:
            return f"rang {int((now - rings[-1]) // 60)} min ago, not again yet"
        sent = [t for t in load("sent.json", []) if now - t < 86400]
        if sum(now - t < 3600 for t in sent) >= PER_HOUR or len(sent) >= PER_DAY:
            log("refused: rate limit")
            raise Refused(f"rate limit reached ({PER_HOUR} an hour, {PER_DAY} a day)", 3)
        if plain:
            t = plain_text(body)
            parts = [t[i:i + TG_LIMIT] for i in range(0, len(t), TG_LIMIT)]
        else:
            parts = [FIXED] if ch is None else ch.seal(body).parts
        ids = []
        for p in parts:
            r = telegram(token, "sendMessage", {"chat_id": chat, "text": p})
            if isinstance(r, dict) and isinstance(r.get("message_id"), int):
                ids.append(r["message_id"])
        save("sent.json", sent + [now])
        if body["kind"] == "ring":
            save("rings.json", (rings + [now])[-200:])
        if plain:                         # what a reply to each part answers
            known = {k: v for k, v in load("plain-sent.json", {}).items() if now - v.get("t", 0) < PLAIN_KEEP}
            for i in ids:
                known[str(i)] = {"project": body["project"], "ask": body.get("ask") if body["kind"] == "ask" else None,
                                 "t": now}
            save("plain-sent.json", known)
    log(f"sent kind={body['kind']} parts={len(parts)}"
        f"{' (plain)' if plain else '' if ch else ' (no key: fixed ping, unencrypted)'}")
    return "rang" if body["kind"] == "ring" else f"sent ({len(parts)} part{'s' if len(parts) > 1 else ''})"


def cmd_send(token, chat):
    raw = sys.stdin.buffer.read(64 * 1024)
    try:
        msg = json.loads(raw)
    except ValueError:
        raise Refused("send: stdin must be one JSON object") from None
    return deliver(token, chat, outbound(msg))


# ---- inbound ----------------------------------------------------------------------------------------------------------

def inbound(body):
    """Check a decrypted message from the human; returns the fields the VM gets, or raises Refused."""
    kind = body.get("kind")
    project = body.get("project")
    out = {"kind": kind}
    if project is not None:
        if not isinstance(project, str) or not PROJECT.fullmatch(project):
            raise Refused("bad project name")
        out["project"] = project
    if kind in ("answer", "message"):
        if "project" not in out:
            raise Refused("no project")
        text = clean(body.get("text", ""))
        if not text:
            raise Refused("empty text")
        out["text"] = text
        if kind == "answer":
            if not isinstance(body.get("ask"), str) or not ASK.fullmatch(body["ask"]):
                raise Refused("bad request number")
            out["ask"] = body["ask"]
    elif kind == "command":
        if body.get("command") not in COMMANDS:
            raise Refused("unknown command")
        out["command"] = body["command"]
        if out["command"] != "status" and "project" not in out:
            raise Refused("no project")
    else:
        raise Refused("unknown kind")
    return out


def plain_inbound(m, known):
    """A plain reply from the human to one of this relay's plain messages: the answer to its request, or a message to its
    project. Returns (body, msg_id, ts), or raises Refused."""
    to = (m.get("reply_to_message") or {}).get("message_id")
    entry = known.get(str(to)) if isinstance(to, int) else None
    if entry is None:
        raise Refused("not encrypted, and not a reply to a plain message from a project")
    body = {"kind": "answer" if entry.get("ask") else "message", "project": entry["project"], "text": m.get("text", "")}
    if entry.get("ask"):
        body["ask"] = entry["ask"]
    msg_id = hashlib.sha256(f"tg:{m.get('chat', {}).get('id')}:{m.get('message_id')}:{m.get('date')}".encode()).hexdigest()[:16]
    return inbound(body), msg_id, m.get("date", 0)


def cmd_fetch(token, chat):
    ch = channel(token, chat)
    inbox = f"{STATE}/inbound"
    os.makedirs(inbox, mode=0o700, exist_ok=True)
    notice, error = None, None
    with Lock("fetch"):
        st = load("fetch.json", {"offset": 0, "seen": {}, "parts": {}})
        try:
            updates = telegram(token, "getUpdates", {"offset": st["offset"], "timeout": POLL,
                                                     "allowed_updates": json.dumps(["message"])}, timeout=POLL + 15)
        except Refused as e:
            updates, error = [], str(e)
        seen = Seen(st["seen"], keep=2 * MAX_AGE)
        parts = Reassembler(st["parts"])
        known = load("plain-sent.json", {})
        for u in updates:
            st["offset"] = max(st["offset"], u["update_id"] + 1)
            m = u.get("message") or {}
            if not (m.get("chat", {}).get("type") == "private" and m["chat"].get("id") == chat
                    and m.get("from", {}).get("id") == chat):
                log(f"ignored update {u['update_id']}: not from the lab's human")
                continue
            try:
                text = m.get("text", "")
                if is_wire(text):
                    if ch is None:
                        raise Refused("encrypted, but there is no telecloak key here (run telecloak-setup)")
                    msg = parts.add(ch.open(text))
                    if msg is None:
                        continue          # more parts to come
                    body, msg_id, ts = inbound(msg.body), msg.msg_id, msg.ts
                else:
                    body, msg_id, ts = plain_inbound(m, known)
                now = time.time()
                if not now - MAX_AGE <= ts <= now + MAX_AHEAD:
                    raise Refused("too old, or dated in the future")
                if not seen.add(msg_id):
                    raise Refused("already received (replay)")
            except (Refused, TelecloakError) as e:
                log(f"rejected update {u['update_id']}: {e}")
                notice = notice or str(e)
                continue
            body.update(id=msg_id, ts=ts)
            save(f"inbound/{msg_id}", body)
            log(f"accepted {msg_id} kind={body['kind']}{' (plain)' if not is_wire(text) else ''}")
        save("fetch.json", st)
        pending = sorted(os.listdir(inbox), key=lambda f: os.stat(f"{inbox}/{f}").st_mtime)
        for f in pending:
            if MSG_ID.fullmatch(f):
                print(json.dumps(load(f"inbound/{f}", {})))
    if notice:
        try:
            deliver(token, chat, {"kind": "info", "text": f"The lab ignored a message from you: {notice}. It acts "
                                                          "only on messages sent with telecloak, or on replies to a "
                                                          "plain message from a project."})
        except Refused:
            pass
    if error:
        raise Refused(error)
    return None


def cmd_ack(ids):
    n = 0
    with Lock("fetch"):
        for i in ids:
            if MSG_ID.fullmatch(i):
                try:
                    os.remove(f"{STATE}/inbound/{i}")
                    n += 1
                except FileNotFoundError:
                    pass
    return f"acked {n}"


def main():
    cmd = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
    try:
        token, chat = conf()
        if cmd[:1] == ["send"]:
            result = cmd_send(token, chat)
        elif cmd[:1] == ["fetch"]:
            result = cmd_fetch(token, chat)
        elif cmd[:1] == ["ack"]:
            result = cmd_ack(cmd[1:200])
        else:
            result = deliver(token, chat, {"kind": "ring", "text": FIXED})
    except Refused as e:
        print(f"doorbell: {e}")
        return e.code
    if result:
        print(f"doorbell: {result}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
