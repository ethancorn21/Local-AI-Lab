MODELS_DIR=/opt/llm/engines/models/hyperqwen
PORT=8080
SPEC=mtp
CTX=long
PREFIX_CACHE=1
VISION=1
# --reasoning-config: what vLLM forces when thinking_token_budget runs out. Default: a bare </think>, after which the
# 27B kept reasoning in its answer (docs/model-choice.md). The wrap-up sentence is Strata's. EXTRA_ARGS is word-split
# unquoted by start_qwen.sh, so the JSON spells its spaces as \u0020.
EXTRA_ARGS=--limit-mm-per-prompt {"image":{"count":8}} --reasoning-config {"reasoning_end_str":"\n\nI\u0020have\u0020thought\u0020about\u0020this\u0020long\u0020enough;\u0020time\u0020to\u0020give\u0020my\u0020answer.\n</think>\n\n"}
