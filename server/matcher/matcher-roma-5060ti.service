[Unit]
Description=Image matcher, RoMa edition, on the RTX 5060 Ti (127.0.0.1:8092) - MatchAnything-RoMa via vismatch (Apache-2.0), drawing/map/aerial matching for ancient-works
# Second matcher next to matcher-5060ti (ELoFTR, :8091). Why (ancient-works 2026-10-11): on the 21 hand fits RoMa
# placed 11 of 21 with none wrong where ELoFTR placed 7; the line runs ELoFTR first (fast) and RoMa on what it
# leaves unsure. Both fit on the 16 GB card together (ELoFTR ~3.4 GB, RoMa ~4 GB); neither runs beside
# llama-5060ti (frontpage agent b's model), which takes the whole card.
# Port plan: 8080 3090 Ti vLLM, 8081 3090, 8082 5060 Ti llama-server, 8090 reserved (type-1 scorer), 8091 ELoFTR, 8092 this.
# Venv: /opt/llm/matcher-roma (python3 -m venv; pip install vismatch), weights cached under HF_HOME on first start.
After=network-online.target power-limits.service
Wants=network-online.target
Conflicts=llama-5060ti.service

[Service]
User=llm
Group=llm
WorkingDirectory=/opt/llm/matcher
Environment=CUDA_VISIBLE_DEVICES=GPU-ccdfa1bc-3062-ad1c-36ad-77e6bcdb7f3a
Environment=HF_HOME=/opt/llm/matcher/hf
Environment=MATCHER_NAME=matchanything-roma
Environment=MATCHER_PORT=8092
ExecStart=/opt/llm/matcher-roma/bin/python server_vismatch.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
