[Unit]
Description=llama.cpp server - Qwen3.8-27B UD-IQ4_XS, 114k ctx on RTX 4080 SUPER, vision projector on CPU
After=network-online.target
Wants=network-online.target

[Service]
User=llm
Group=llm
WorkingDirectory=/opt/llm/openjev-lab
# 114k: largest context that fits fully on 16 GB (2026-09-25 Linux sweep): 42 t/s fresh, 32 t/s at 69k.
# 131k needs 1 FFN layer in RAM and drops to 37/28 t/s. Revisit when the RTX 5060 Ti arrives.
ExecStart=/opt/llm/llama.cpp/build/bin/llama-server \
  -m models/qwen27b/unsloth/Qwen3.8-27B-UD-IQ4_XS.gguf --alias qwen3.8-27b \
  --host 127.0.0.1 --port 8080 \
  -c 114688 -ctk q4_0 -ctv q4_0 -ub 512 \
  -ngl 99 --fit off -fa on -t 8 -Cr 0-15 \
  -np 1 --cache-ram 2048 --ctx-checkpoints 32 \
  --mmproj models/qwen27b/unsloth/mmproj-F16.gguf --no-mmproj-offload \
  --load-mode none --jinja --reasoning-budget 16384 \
  --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/llm

[Install]
WantedBy=multi-user.target
