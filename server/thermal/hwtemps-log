#!/usr/bin/python3 -I
"""hwtemps-log: CPU and every GPU sampled every 15 s into /var/log/hwtemps.csv (one row per GPU per sample), with phone
alerts and per-card safety stops. Runs as root (hwtemps.service).

Phone alerts go through the doorbell relay (a telecloak "info" message: the phone buzzes, the text is read in the
telecloak app), at most one per card and condition every 30 min:
  - a card at WARN_C (83, the 3090 Ti's target) or more for 2 min
  - a card's thermal slowdown flag (hardware or software) on for 1 min
  - a card's fan at FAN_PCT (95) or more for 5 min (no cooling headroom left)
Safety stops (also alerted):
  - a card at STOP_C (88) or more for 1 min: that card's model server is stopped (STOPS below, by GPU UUID). A card
    without an entry (a new one, until it is set up) only alerts.
  - the hottest CPU core at CPU_LIMIT (95) or more for 1 min: every model server is stopped (drops the load at once).
The agents' driver waits for a stopped model server and resumes when it is back; restarting it is a human decision.
Hardware limits for reference: the i9-14900KF throttles at 100 C; the 3090 Ti targets 83 C and slows down at 94 C.
The 2026-09-27..10-02 log (3090 Ti only, one row per sample) is /var/log/hwtemps-v1-gpu0.csv.

  hwtemps-log              run (the service)
  hwtemps-log --test-ping  send one test alert with the current readings, then exit
  hwtemps-log --selftest   check the alert and stop decisions on synthetic readings (sends and stops nothing)
"""
import glob
import json
import os
import subprocess
import sys
import syslog
import time

LOG = "/var/log/hwtemps.csv"
HEADER = "time,cpu_pkg_c,cpu_max_core_c,gpu,name,gpu_c,gpu_w,gpu_fan_pct,gpu_util_pct,thermal_slowdown\n"
INTERVAL = 15
WARN_C, STOP_C, FAN_PCT, CPU_LIMIT = 83, 88, 95, 95
WARN_N, STOP_N, THROTTLE_N, FAN_N, CPU_N = 8, 4, 4, 20, 4      # samples: 2 min, 1 min, 1 min, 5 min, 1 min
COOLDOWN = 1800
STOPS = {   # GPU UUID -> (what runs on it, command that stops it, command that starts it again)
    "GPU-56122485-2e24-e358-a731-574234bbc100": ("the vLLM container (agent a)", ["docker", "stop", "hyperqwen-single-1"],
                                                 "sudo docker start hyperqwen-single-1"),
    "GPU-ccdfa1bc-3062-ad1c-36ad-77e6bcdb7f3a": ("llama-5060ti (agent b)", ["systemctl", "stop", "llama-5060ti"],
                                                 "sudo systemctl start llama-5060ti"),
}
QUERY = ("index,uuid,name,temperature.gpu,power.draw,fan.speed,utilization.gpu,"
         "clocks_event_reasons.hw_thermal_slowdown,clocks_event_reasons.sw_thermal_slowdown")


def num(s):
    try:
        return float(s)
    except ValueError:
        return None   # "[N/A]", "[Not Supported]"


def read_gpus():
    out = subprocess.run(["nvidia-smi", f"--query-gpu={QUERY}", "--format=csv,noheader,nounits"],
                         capture_output=True, text=True, timeout=30).stdout
    gpus = []
    for line in out.strip().splitlines():
        f = [x.strip() for x in line.split(",")]
        if len(f) < 9:
            continue
        gpus.append({"index": f[0], "uuid": f[1], "name": f[2].replace("NVIDIA GeForce ", ""), "c": num(f[3]),
                     "w": num(f[4]), "fan": num(f[5]), "util": num(f[6]),
                     "throttle": "Active" in (f[7], f[8])})
    return gpus


def read_cpu():
    hw = next((h for h in glob.glob("/sys/class/hwmon/hwmon*") if open(f"{h}/name").read().strip() == "coretemp"), None)
    if not hw:
        return None, None
    temps = [int(open(t).read()) // 1000 for t in glob.glob(f"{hw}/temp*_input")]
    return int(open(f"{hw}/temp1_input").read()) // 1000, max(temps)


class Guard:
    """Counts consecutive bad samples per card and decides what to say and what to stop. Pure: no I/O."""

    def __init__(self):
        self.n = {}          # (uuid, condition) -> consecutive samples
        self.last = {}       # (uuid, condition) -> time of the last alert
        self.stopped = set()

    def step(self, now, cpu_max, gpus):
        """-> (alerts: list of text, stops: list of uuid)"""
        alerts, stops = [], []

        def count(key, bad):
            self.n[key] = self.n.get(key, 0) + 1 if bad else 0
            return self.n[key]

        def alert(key, text):
            if now - self.last.get(key, -1e9) >= COOLDOWN:
                self.last[key] = now
                alerts.append(text)

        for g in gpus:
            u, c, desc = g["uuid"], g["c"] or 0, f"{g['name']} (GPU {g['index']})"
            if c < WARN_C - 10:
                self.stopped.discard(u)   # cooled down: armed again (the human may have restarted its server)
            info = f"{c:.0f} C, fan {g['fan'] if g['fan'] is not None else '?'}%, {g['w'] or 0:.0f} W"
            if count((u, "stop"), c >= STOP_C) >= STOP_N and u not in self.stopped:
                if u in STOPS:
                    self.stopped.add(u)
                    stops.append(u)
                    what, _, restart = STOPS[u]
                    alert((u, "stop"), f"AI box: {desc} at {info} for 1 min - stopped {what}. Restart once it has cooled: {restart}")
                else:
                    alert((u, "stop"), f"AI box: {desc} at {info} for 1 min - no safety stop is set up for this card: check it now")
            elif count((u, "warn"), c >= WARN_C) >= WARN_N:
                alert((u, "warn"), f"AI box: {desc} hot: {info} for 2+ min (safety stop at {STOP_C} C)")
            if count((u, "throttle"), g["throttle"]) >= THROTTLE_N:
                alert((u, "throttle"), f"AI box: {desc} is thermally throttling: {info}")
            if count((u, "fan"), (g["fan"] or 0) >= FAN_PCT) >= FAN_N:
                alert((u, "fan"), f"AI box: {desc} fan at {g['fan']:.0f}% for 5+ min, no cooling headroom left: {info}")
        if (cpu_max or 0) < CPU_LIMIT - 15:
            self.stopped.discard("cpu")
        if count(("cpu", "stop"), (cpu_max or 0) >= CPU_LIMIT) >= CPU_N and "cpu" not in self.stopped:
            self.stopped.add("cpu")
            running = [u for u in STOPS if u not in self.stopped]
            self.stopped.update(running)
            stops.extend(running)
            alert(("cpu", "stop"), f"AI box: CPU at {cpu_max} C for 1 min - stopped every model server. Restart them once it has cooled.")
        return alerts, stops


def ping(text):
    msg = json.dumps({"kind": "info", "text": text})
    try:
        r = subprocess.run(["/usr/sbin/runuser", "-u", "doorbell", "--", "/usr/local/bin/doorbell"], input=msg, text=True,
                           capture_output=True, timeout=60,
                           env={"SSH_ORIGINAL_COMMAND": "send", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"})
        ok = r.returncode == 0
    except Exception:
        ok = False
    syslog.syslog(syslog.LOG_WARNING, f"hwtemps alert{'' if ok else ' (doorbell send failed)'}: {text}")
    return ok


def selftest():
    g = lambda c, fan=60, thr=False, u="GPU-56122485-2e24-e358-a731-574234bbc100": [
        {"index": "0", "uuid": u, "name": "RTX 3090 Ti", "c": c, "w": 340, "fan": fan, "util": 95, "throttle": thr}]
    fails = 0

    def check(cond, what):
        nonlocal fails
        print(("ok   " if cond else "FAIL ") + what)
        fails += not cond

    t = Guard()
    out = [t.step(i * 15, 60, g(84)) for i in range(8)]
    check(not any(a for a, _ in out[:7]) and out[7][0] and not out[7][1], "84 C: warning after 2 min, nothing stopped")
    check(not any(t.step(200 + i * 15, 60, g(84))[0] for i in range(10)), "no repeat warning within 30 min")
    t = Guard()
    out = [t.step(i * 15, 60, g(89)) for i in range(4)]
    check(out[3][1] == ["GPU-56122485-2e24-e358-a731-574234bbc100"] and "stopped the vLLM" in out[3][0][0], "89 C: stop after 1 min, alert names what was stopped")
    check(not t.step(75, 60, g(89))[1], "a stopped card is not stopped again while hot")
    t.step(90, 60, g(65))
    out = [t.step(2000 + i * 15, 60, g(89)) for i in range(4)]
    check(out[3][1] == ["GPU-56122485-2e24-e358-a731-574234bbc100"], "after cooling below 73 C it is armed again")
    t = Guard()
    out = [t.step(i * 15, 60, g(89, u="GPU-unknown")) for i in range(4)]
    check(not out[3][1] and "no safety stop" in out[3][0][0], "unknown card: alert only")
    t = Guard()
    check([t.step(i * 15, 60, g(70, thr=True)) for i in range(4)][3][0][0].find("throttling") > 0, "throttle flag: alert after 1 min")
    t = Guard()
    out = [t.step(i * 15, 60, g(70, fan=97)) for i in range(20)]
    check(not any(a for a, _ in out[:19]) and "fan at 97%" in out[19][0][0], "fan 97%: alert after 5 min")
    t = Guard()
    out = [t.step(i * 15, 96, g(60)) for i in range(4)]
    check(set(out[3][1]) == set(STOPS) and "CPU" in out[3][0][0], "CPU 96 C: every model server stopped")
    t = Guard()
    check(not any(a or s for a, s in (t.step(i * 15, 70, g(82, fan=94)) for i in range(40))), "82 C, fan 94%: quiet")
    return fails


def main():
    if "--selftest" in sys.argv:
        sys.exit(1 if selftest() else 0)
    if "--test-ping" in sys.argv:
        gpus = read_gpus()
        ok = ping("AI box: test - GPU temperature alerts are on for " +
                  "; ".join(f"{g['name']} {g['c']:.0f} C fan {g['fan']}%" for g in gpus))
        sys.exit(0 if ok else 1)
    if not os.path.exists(LOG):
        open(LOG, "w").write(HEADER)
    guard = Guard()
    while True:
        now = time.time()
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
        try:
            pkg, cpu_max = read_cpu()
            gpus = read_gpus()
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"hwtemps: reading sensors failed: {e!r}")
            time.sleep(INTERVAL)
            continue
        with open(LOG, "a") as f:
            for g in gpus:
                f.write(f"{stamp},{pkg},{cpu_max},{g['index']},{g['name']},{g['c']},{g['w']},{g['fan']},{g['util']},"
                        f"{int(g['throttle'])}\n")
        alerts, stops = guard.step(now, cpu_max, gpus)
        for u in stops:
            what, cmd, _ = STOPS[u]
            syslog.syslog(syslog.LOG_CRIT, f"hwtemps OVERHEAT: stopping {what}")
            subprocess.run(cmd, capture_output=True, timeout=120)
        for a in alerts:
            ping(a)
        time.sleep(max(1, INTERVAL - (time.time() - now)))


if __name__ == "__main__":
    main()
